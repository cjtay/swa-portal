{
  "name": "swa-portal",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "copy:qrcode": "cp node_modules/qrcode/build/qrcode.min.js public/js/qrcode.min.js",
    "gen:swalogo": "node scripts/generate-swalogo-ts.mjs",
    "predev": "npm run copy:qrcode && npm run gen:swalogo",
    "prebuild": "npm run copy:qrcode && npm run gen:swalogo",
    "pretest": "npm run copy:qrcode",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "dev:worker": "astro build && wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "deploy:staging": "astro build && wrangler deploy --env staging",
    "astro": "astro",
    "typecheck": "astro check",
    "typecheck:worker": "tsc -p src/worker/tsconfig.json",
    "cf-typegen": "wrangler types src/worker/worker-configuration.d.ts",
    "db:setup": "node scripts/db-setup.mjs",
    "db:seed": "node scripts/db-setup.mjs --seed-only",
    "db:clear:membership": "node scripts/db-clear-membership.mjs",
    "test": "vitest",
    "test:run": "node scripts/test-run.mjs"
  },
  "dependencies": {
    "astro": "^7",
    "hono": "^4.12.27"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260821.1",
    "qrcode": "^1.4.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.107.0"
  }
}
