---
import AdminLayout from '../layouts/AdminLayout.astro';
import { APPROVAL_CATEGORIES } from '../constants/portal';
---

<AdminLayout title="Approvals | SWA Admin Portal" currentPath="/approvals">
  <h1>Approvals</h1>
  <p style="color:var(--text-muted);margin-bottom:1.25rem;">
    Purchase and payment approvals. The office admin raises a request with its documents;
    purchase approvers decide first, then the finance pair checks the payment voucher.
  </p>

  <!-- Status tabs with counts (plan §11) -->
  <div class="ap-tabs" id="ap-tabs" role="tablist" aria-label="Approval status">
    <button type="button" class="ap-tab" data-status="pending" role="tab" aria-selected="false">For approval <span class="ap-tab-count" data-count="pending">0</span></button>
    <button type="button" class="ap-tab" data-status="purchase_approved" role="tab" aria-selected="false">Approved <span class="ap-tab-count" data-count="purchase_approved">0</span></button>
    <button type="button" class="ap-tab" data-status="finance_check" role="tab" aria-selected="false">In finance check <span class="ap-tab-count" data-count="finance_check">0</span></button>
    <button type="button" class="ap-tab" data-status="finance_approved" role="tab" aria-selected="false">Finance approved <span class="ap-tab-count" data-count="finance_approved">0</span></button>
    <button type="button" class="ap-tab" data-status="rejected" role="tab" aria-selected="false">Rejected <span class="ap-tab-count" data-count="rejected">0</span></button>
    <button type="button" class="ap-tab" data-status="paid" role="tab" aria-selected="false">Paid <span class="ap-tab-count" data-count="paid">0</span></button>
    <button type="button" class="ap-tab active" data-status="all" role="tab" aria-selected="true">All <span class="ap-tab-count" data-count="all">0</span></button>
  </div>

  <!-- New request toggle (office admin only; hidden until the session confirms).
       The table leads the page; the form opens on demand. -->
  <div id="ap-create-bar" style="margin-bottom:1.5rem;display:none;align-items:center;gap:0.75rem;flex-wrap:wrap;">
    <button type="button" class="btn btn-primary" id="ap-create-open">New request</button>
    <span id="ap-create-bar-msg" style="font-size:0.85rem;color:#1b7f3b;"></span>
  </div>

  <!-- New request form (office admin only; opens via the button above) -->
  <div class="card" id="ap-create-card" style="margin-bottom:1.5rem;display:none;">
    <h2 style="font-size:1.1rem;margin-top:0;">New request</h2>
    <form id="ap-create-form" enctype="multipart/form-data">
      <div class="ap-form-grid">
        <label class="ap-field">
          <span>Category</span>
          <select id="ap-category" class="form-input" required>
            {APPROVAL_CATEGORIES.map((cat) => (
              <option value={cat.key} data-requires-approval={cat.requiresApproval ? 'true' : 'false'}>{cat.label}</option>
            ))}
          </select>
        </label>
        <label class="ap-field">
          <span>Title</span>
          <input type="text" id="ap-title" class="form-input" maxlength="300" placeholder="e.g. 49th SWA Charity Gala Dinner 2026" required />
        </label>
        <label class="ap-field">
          <span>Payable to</span>
          <input type="text" id="ap-payee" class="form-input" maxlength="300" placeholder="Vendor or payee name" />
        </label>
        <label class="ap-field">
          <span>Requested amount (S$, optional)</span>
          <input type="number" id="ap-amount" class="form-input" min="0" max="10000000" step="0.01" inputmode="decimal" placeholder="0.00" />
        </label>
      </div>

      <label class="ap-field" style="display:block;margin-top:0.75rem;">
        <span>Description / justification (optional, shown to approvers)</span>
        <textarea id="ap-description" class="form-input" rows="4" maxlength="4000" placeholder="Why this purchase is needed, context for approvers, breakdown of the amount…"></textarea>
      </label>

      <label class="ap-check">
        <input type="checkbox" id="ap-approval-required" checked />
        <span>Approval required (purchase approvers decide before the voucher)</span>
      </label>

      <label class="ap-field" style="display:block;margin-top:0.75rem;">
        <span>Documents — add one at a time or several at once (PDF or photos, up to 10 files, 10 MB each)</span>
        <input type="file" id="ap-files" class="form-input" multiple accept="application/pdf,image/jpeg,image/png,image/webp,image/heic,image/heif" />
      </label>
      <div id="ap-files-list" aria-live="polite"></div>
      <p id="ap-files-msg" role="status" aria-live="polite" style="margin:0.25rem 0 0;font-size:0.8rem;color:#b3261e;" hidden></p>

      <!-- Comparison opt-in: appears only when files are chosen. A single
           quotation may span several uploads (PDF + photos of the same
           quote), so the comparison rows require an explicit tick. -->
      <label class="ap-check" id="ap-comparison-toggle-wrap" hidden>
        <input type="checkbox" id="ap-comparison-toggle" />
        <span>I have multiple quotations to compare</span>
      </label>

      <!-- Comparison builder: one row per chosen file (plan §6) -->
      <div id="ap-comparison-builder" hidden>
        <p style="margin:0.75rem 0 0.25rem;font-weight:600;">Comparison table</p>
        <p style="margin:0 0 0.5rem;color:var(--text-muted);font-size:0.85rem;">
          Tick the quotations you want in the comparison and describe each one.
          Each row links to that document for the finance check.
        </p>
        <div id="ap-comparison-rows"></div>
      </div>

      <!-- AI analysis (docs/plans/AI-Quotation-Comparison-Plan.md §4.6): the
           button only spends AI quota on an explicit click; the stored
           analysis is replayed with the form on submit. -->
      <div id="ap-ai-box" hidden style="margin-top:1rem;">
        <div style="display:flex;align-items:center;gap:0.75rem;flex-wrap:wrap;">
          <button type="button" class="btn btn-secondary" id="ap-ai-run">Analyse with AI</button>
          <span id="ap-ai-msg" role="status" aria-live="polite" style="font-size:0.85rem;color:var(--text-muted);"></span>
        </div>
        <div id="ap-ai-preview" class="ap-ai-preview" hidden></div>
      </div>

      <div style="display:flex;align-items:center;gap:0.75rem;margin-top:1rem;flex-wrap:wrap;">
        <button type="submit" class="btn btn-primary" id="ap-create-submit">Raise request</button>
        <button type="button" class="btn btn-secondary" id="ap-create-cancel">Cancel</button>
        <span id="ap-create-msg" role="status" aria-live="polite" style="font-size:0.85rem;color:var(--text-muted);"></span>
      </div>
    </form>
  </div>

  <!-- Board table. Headers sort in the browser (owner decision 25-08-2026):
       click once to sort, again to reverse. Empty values always sink to the
       bottom regardless of direction. -->
  <div class="card">
    <div class="table-scroll">
      <table class="data-table" id="ap-board-table">
        <thead>
          <tr>
            <th scope="col" class="ap-sortable" data-sort="voucher_no">Voucher No</th>
            <th scope="col" class="ap-sortable" data-sort="voucher_date">Date</th>
            <th scope="col" class="ap-sortable" data-sort="title">Title</th>
            <th scope="col" class="ap-sortable" data-sort="payee">Payee</th>
            <th scope="col" class="ap-sortable" data-sort="category">Category</th>
            <th scope="col" class="ap-sortable" data-sort="requested_amount">Amount</th>
            <th scope="col" class="ap-sortable" data-sort="status">Status</th>
            <th scope="col" class="ap-sortable" data-sort="created_at">Created (SG)</th>
            <th scope="col"><span style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);">Actions</span></th>
          </tr>
        </thead>
        <tbody id="ap-list"></tbody>
      </table>
    </div>
    <div id="ap-pagination"></div>
  </div>

  <!-- Detail drawer -->
  <div class="drawer-overlay" id="ap-drawer-overlay" hidden>
    <aside class="drawer" id="ap-drawer" role="dialog" aria-modal="true" aria-labelledby="ap-drawer-title">
      <header class="drawer-header">
        <h2 id="ap-drawer-title">Approval item</h2>
        <button type="button" class="drawer-close" id="ap-drawer-close" aria-label="Close">&times;</button>
      </header>
      <div class="drawer-body" id="ap-drawer-body"></div>
    </aside>
  </div>
</AdminLayout>

<style is:global>
  .admin-main { max-width: 1600px; }

  .ap-tabs { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 1rem; }
  .ap-tab {
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--text-muted);
    border-radius: 9999px;
    cursor: pointer;
    font-size: 0.85rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .ap-tab:hover { border-color: var(--swa-3); color: var(--swa-2); }
  .ap-tab.active { background: var(--swa-1); border-color: var(--swa-1); color: #fff; }
  .ap-tab:focus-visible,
  .ap-page-btn:focus-visible,
  .row-view-btn:focus-visible,
  .drawer-close:focus-visible {
    outline: 2px solid var(--swa-3);
    outline-offset: 2px;
  }
  .ap-tab-count {
    background: var(--swa-4);
    color: var(--swa-2);
    border-radius: 9999px;
    padding: 0 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    min-width: 1.3rem;
    text-align: center;
  }
  .ap-tab.active .ap-tab-count { background: rgba(255, 255, 255, 0.25); color: #fff; }

  .table-scroll { overflow-x: auto; border: 1px solid var(--border); border-radius: 0.4rem; }

  .ap-form-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }
  .ap-field { display: flex; flex-direction: column; gap: 0.25rem; font-size: 0.85rem; }
  .ap-field > span { font-weight: 500; color: var(--text); }
  .ap-check { display: flex; align-items: center; gap: 0.5rem; font-size: 0.85rem; }
  /* display:flex would override the hidden attribute (same class of bug as
     the 2026-07-05 drawer fix) — restore it explicitly. */
  .ap-check[hidden] { display: none; }

  /* Brand-coloured checkboxes and file pickers (approvals page only). */
  #ap-create-card input[type="checkbox"],
  #ap-drawer input[type="checkbox"] {
    accent-color: var(--swa-1);
    width: 1rem;
    height: 1rem;
  }
  #ap-create-card input[type="file"].form-input,
  #ap-drawer input[type="file"].form-input {
    padding: 0.45rem 0.6rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  #ap-create-card input[type="file"]::file-selector-button,
  #ap-drawer input[type="file"]::file-selector-button {
    margin-right: 0.75rem;
    padding: 0.35rem 0.85rem;
    border: 1px solid var(--swa-3);
    border-radius: 0.375rem;
    background: var(--bg);
    color: var(--swa-2);
    font-family: inherit;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
  }
  #ap-create-card input[type="file"]::file-selector-button:hover,
  #ap-drawer input[type="file"]::file-selector-button:hover {
    background: var(--swa-4);
  }

  /* Action and form messages become visible banners once they have text.
     The script sets the text colour inline (red for errors, green for
     success); the tint below follows that colour automatically. */
  #ap-act-msg:not(:empty),
  #ap-create-msg:not(:empty) {
    flex-basis: 100%;
    padding: 0.5rem 0.75rem;
    border-left: 3px solid currentColor;
    border-radius: 0 0.3rem 0.3rem 0;
    background: color-mix(in srgb, currentColor 8%, transparent);
    font-weight: 500;
  }
  #ap-files-msg:not([hidden]) {
    padding: 0.45rem 0.75rem;
    border-left: 3px solid currentColor;
    border-radius: 0 0.3rem 0.3rem 0;
    background: color-mix(in srgb, currentColor 8%, transparent);
    font-weight: 500;
  }

  .ap-actions { display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; }
  .ap-actions a.btn { text-decoration: none; display: inline-flex; align-items: center; }
  #ap-reject-box, #ap-finance-reject-box, #ap-edit-form, #ap-voucher-form, #ap-paid-form {
    border: 1px solid var(--border);
    border-radius: 0.4rem;
    padding: 0.75rem;
    background: #fafafa;
    margin-top: 0.75rem;
  }

  .ap-vline-row {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0;
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
  }
  .ap-vline-row:last-child { border-bottom: none; }

  .ap-comp-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0;
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
  }
  .ap-comp-row:last-child { border-bottom: none; }
  .ap-comp-name { font-size: 0.85rem; min-width: 180px; word-break: break-all; }

  .ap-file-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.35rem 0;
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
  }
  .ap-file-row:last-of-type { border-bottom: none; }
  .ap-file-row .ap-comp-name { min-width: 0; flex: 1; }
  .ap-file-remove {
    padding: 0.15rem 0.55rem;
    font-size: 0.75rem;
    border: 1px solid var(--border);
    background: var(--bg);
    color: #b3261e;
    border-radius: 0.3rem;
    cursor: pointer;
  }
  .ap-file-remove:hover { border-color: #b3261e; }

  .ap-chip {
    display: inline-block;
    padding: 0.15rem 0.6rem;
    border-radius: 9999px;
    font-size: 0.78rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .ap-chip-pending { background: #fff3d6; color: #7a5c00; }
  .ap-chip-purchase_approved { background: #e8f5e9; color: #1b7f3b; }
  .ap-chip-finance_check { background: #e8f0fe; color: #1a4fa0; }
  .ap-chip-finance_approved { background: #dff2e6; color: #0d6b3f; }
  .ap-chip-rejected { background: #fdecea; color: #b3261e; }
  .ap-chip-paid { background: #eceff1; color: #37474f; }

  .row-view-btn {
    padding: 0.3rem 0.7rem;
    font-size: 0.78rem;
    border: 1px solid var(--swa-3);
    background: var(--bg);
    color: var(--swa-2);
    border-radius: 0.3rem;
    cursor: pointer;
  }
  .row-view-btn:hover { background: #f5f0f8; }

  /* Sortable headers (board table). The arrow is CSS content so the thead
     never needs re-rendering; the active class is swapped by renderSortHeads. */
  #ap-board-table th.ap-sortable {
    cursor: pointer;
    user-select: none;
    white-space: nowrap;
  }
  #ap-board-table th.ap-sortable:hover { color: var(--swa-2); }
  #ap-board-table th.ap-sort-asc::after { content: ' \2191'; }
  #ap-board-table th.ap-sort-desc::after { content: ' \2193'; }
  #ap-board-table th.ap-sort-asc,
  #ap-board-table th.ap-sort-desc { color: var(--swa-2); }

  /* Column polish: amounts right-aligned with tabular figures so digits
     line up; identifiers and dates stay on one line instead of wrapping. */
  #ap-board-table th:nth-child(6),
  #ap-board-table td:nth-child(6) {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  #ap-board-table td:nth-child(1),
  #ap-board-table td:nth-child(2),
  #ap-board-table td:nth-child(7),
  #ap-board-table td:nth-child(8) {
    white-space: nowrap;
  }

  /* Pagination bar under the board table (browser-side, 20 rows per page). */
  .ap-pagination {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 0.75rem;
  }
  .ap-pagination:empty { display: none; }
  .ap-page-info { font-size: 0.8rem; color: var(--text-muted); }
  .ap-page-btns { display: flex; gap: 0.3rem; align-items: center; flex-wrap: wrap; }
  .ap-page-btn {
    padding: 0.2rem 0.6rem;
    font-size: 0.78rem;
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--text-muted);
    border-radius: 0.3rem;
    cursor: pointer;
  }
  .ap-page-btn:hover:not(:disabled) { border-color: var(--swa-3); color: var(--swa-2); }
  .ap-page-btn.active { background: var(--swa-1); border-color: var(--swa-1); color: #fff; }
  .ap-page-btn:disabled { opacity: 0.5; cursor: default; }
  .ap-page-ellipsis { padding: 0 0.15rem; color: var(--text-muted); font-size: 0.78rem; }

  .drawer-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    z-index: 50;
    display: flex;
    justify-content: flex-end;
  }
  .drawer-overlay[hidden] { display: none; }
  .drawer {
    width: min(760px, 100%);
    background: var(--bg);
    height: 100%;
    overflow-y: auto;
    box-shadow: -10px 0 30px -10px rgba(0, 0, 0, 0.3);
    display: flex;
    flex-direction: column;
  }
  .drawer-header {
    position: sticky;
    top: 0;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    padding: 1rem 1.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 2;
  }
  .drawer-header h2 { margin: 0; font-size: 1.15rem; color: var(--swa-2); }
  .drawer-close {
    background: none;
    border: none;
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
    color: var(--text-muted);
  }
  .drawer-body { padding: 1.25rem; display: flex; flex-direction: column; gap: 1.25rem; }

  .ap-detail-grid {
    display: grid;
    /* Two columns at the 760px drawer width, so long values such as email
       addresses fit on one line instead of wrapping mid-word. */
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 0.6rem 1.25rem;
  }
  .ap-detail-item { font-size: 0.85rem; }
  .ap-detail-item dt {
    color: var(--text-muted);
    margin: 0 0 0.15rem;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  /* overflow-wrap (not word-break) only splits a word when it truly cannot
     fit; long rows marked wide span both columns and never wrap. */
  .ap-detail-item dd { margin: 0; font-weight: 500; font-size: 0.9rem; overflow-wrap: break-word; }
  .ap-detail-item--wide { grid-column: 1 / -1; }

  .ap-note {
    border-left: 3px solid #b3261e;
    background: #fdecea;
    padding: 0.6rem 0.8rem;
    border-radius: 0 0.3rem 0.3rem 0;
    font-size: 0.9rem;
  }

  .ap-attachment {
    border: 1px solid var(--border);
    border-radius: 0.4rem;
    padding: 0.75rem;
    margin-bottom: 0.75rem;
  }
  .ap-attachment-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }
  .ap-attachment-name { font-size: 0.85rem; font-weight: 600; word-break: break-all; }
  .ap-attachment-actions { display: flex; gap: 0.5rem; align-items: center; }
  .ap-attachment-actions a {
    font-size: 0.78rem;
    color: var(--swa-2);
  }
  .ap-attachment-preview img { max-width: 100%; height: auto; border-radius: 0.3rem; }
  .ap-attachment-preview iframe { width: 100%; height: 560px; border: 1px solid var(--border); border-radius: 0.3rem; }

  .ap-comparison-table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
  .ap-comparison-table th, .ap-comparison-table td {
    border: 1px solid var(--border);
    padding: 0.4rem 0.6rem;
    text-align: left;
    vertical-align: top;
  }
  .ap-comparison-table th { background: #f5f0f8; color: var(--swa-2); }

  /* AI analysis preview + drawer block. The tinted border separates the
     AI-generated content from the human-typed comparison table above it. */
  .ap-ai-preview {
    margin-top: 0.75rem;
    border: 1px solid var(--swa-3);
    border-radius: 0.4rem;
    padding: 0.75rem;
    background: #faf7fc;
    font-size: 0.85rem;
  }
  .ap-ai-preview h4, .ap-ai-block h4 { margin: 0 0 0.4rem; font-size: 0.9rem; color: var(--swa-2); }
  .ap-ai-disclaimer {
    display: block;
    margin: 0.5rem 0 0;
    font-size: 0.75rem;
    color: var(--text-muted);
  }
  .ap-ai-reco {
    margin: 0.6rem 0 0;
    padding: 0.45rem 0.6rem;
    background: var(--swa-4);
    border-radius: 0.3rem;
    font-weight: 600;
    color: var(--swa-2);
  }
  .ap-ai-meta { margin: 0.5rem 0 0; font-size: 0.75rem; color: var(--text-muted); }

  /* Rotating ring shown beside the working message while an AI analysis runs.
     Pure CSS — no image, no emoji, respects prefers-reduced-motion. */
  .ap-spinner {
    display: inline-block;
    width: 1.15em;
    height: 1.15em;
    vertical-align: -0.15em;
    margin-right: 0.45rem;
    border: 3px solid rgba(112, 48, 140, 0.25);
    border-top-color: var(--swa-1);
    border-radius: 50%;
    animation: ap-spin 0.7s linear infinite;
  }
  @keyframes ap-spin {
    to { transform: rotate(360deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .ap-spinner {
      animation: ap-pulse 1.2s ease-in-out infinite;
      border-color: var(--swa-1);
    }
    @keyframes ap-pulse {
      50% { opacity: 0.25; }
    }
  }
  .ap-ai-preview .ap-comparison-table td:nth-child(4),
  .ap-ai-preview .ap-comparison-table td:nth-child(5),
  .ap-ai-preview .ap-comparison-table th:nth-child(4),
  .ap-ai-preview .ap-comparison-table th:nth-child(5) {
    text-align: right;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  /* Voucher table in the drawer: keep No/Date/Amount on one line and line
     up the amount digits. */
  .ap-voucher .ap-comparison-table td { font-variant-numeric: tabular-nums; }
  .ap-voucher .ap-comparison-table th:nth-child(1),
  .ap-voucher .ap-comparison-table td:nth-child(1),
  .ap-voucher .ap-comparison-table th:nth-child(2),
  .ap-voucher .ap-comparison-table td:nth-child(2),
  .ap-voucher .ap-comparison-table th:nth-child(4),
  .ap-voucher .ap-comparison-table td:nth-child(4) {
    white-space: nowrap;
  }
</style>

<script>
  import { requireAuth, type SessionResponse } from '../scripts/auth-gate';

  interface ApprovalItem {
    id: number;
    category: string;
    title: string;
    payee: string | null;
    description: string | null;
    requested_amount: number | null;
    approval_required: number;
    status: string;
    rejected_stage: string | null;
    rejection_reason: string | null;
    finance_rejection_reason: string | null;
    voucher_no: string | null;
    voucher_date: string | null;
    voucher_lines: string | null;
    voucher_submitted_by: string | null;
    voucher_submitted_at: string | null;
    finance_decision_by: string | null;
    finance_decision_at: string | null;
    paid_by: string | null;
    paid_at: string | null;
    payment_method: string | null;
    payment_reference: string | null;
    created_by: string;
    created_at: string;
    updated_at: string;
    comparison?: Array<{ attachmentId: number; description: string }> | null;
    ai_comparison?: AiAnalysis | null;
  }

  interface VoucherLine {
    no: number | null;
    date: string | null;
    description: string;
    amount: number | null;
  }

  interface ApprovalAttachment {
    id: number;
    filename: string;
    mime_type: string;
    size: number;
    created_at: string;
  }

  // AI quotation comparison (docs/plans/AI-Quotation-Comparison-Plan.md).
  // Shape mirrors AiComparison in src/worker/lib/ai-comparison.ts.
  interface AiQuote {
    filename: string;
    vendor: string | null;
    itemName: string | null;
    description: string | null;
    unitPrice: number | null;
    totalPrice: number | null;
    currency: string | null;
    gst: string | null;
    validity: string | null;
    leadTime: string | null;
    unitPriceSgd: number | null;
    totalPriceSgd: number | null;
  }

  interface AiAnalysis {
    version: 1;
    generatedAt: string;
    generatedBy: string;
    models: { extract: string; compare: string };
    fx: { date: string; source: string } | null;
    files: Array<{ filename: string; status: 'ok' | 'skipped' | 'error'; note: string | null }>;
    quotes: AiQuote[];
    summary: string | null;
    recommendation: string | null;
  }

  const STATUS_LABELS: Record<string, string> = {
    pending: 'For approval',
    purchase_approved: 'Approved',
    finance_check: 'In finance check',
    finance_approved: 'Finance approved',
    rejected: 'Rejected',
    paid: 'Paid',
  };

  const PAYMENT_METHOD_LABELS: Record<string, string> = {
    paynow: 'PayNow',
    bank_transfer: 'Bank transfer',
    cheque: 'Cheque',
    cash: 'Cash',
    other: 'Other',
  };

  // Category labels are read from the <select> options rather than an inline
  // JSON tag: Astro treats content inside <script> tags as raw text, so an
  // {expression} there ships unevaluated and breaks JSON.parse.
  const CATEGORY_LABELS: Record<string, string> = (() => {
    const out: Record<string, string> = {};
    document.querySelectorAll<HTMLSelectElement>('#ap-category option').forEach((opt) => {
      out[opt.value] = opt.textContent?.trim() || opt.value;
    });
    return out;
  })();

  let allItems: ApprovalItem[] = [];
  let counts: Record<string, number> = {};
  let currentTab = 'all';
  let sessionData: SessionResponse | null = null;

  // Board view state: column sorting + browser-side pagination (owner
  // decision 25-08-2026). The default sort matches the API order exactly
  // (created_at DESC, id DESC) so rows never jump on first render.
  type SortKey = 'voucher_no' | 'voucher_date' | 'title' | 'payee' | 'category' | 'requested_amount' | 'status' | 'created_at';
  let sortKey: SortKey = 'created_at';
  let sortDir: 'asc' | 'desc' = 'desc';
  let currentPage = 1;
  const PAGE_SIZE = 20;

  function esc(value: unknown): string {
    return String(value ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function fmtMoney(value: number | null): string {
    if (value === null || value === undefined) return '';
    // Sign before the currency, matching the emails: -S$400.00.
    const sign = value < 0 ? '-' : '';
    return sign + 'S$' + Math.abs(value).toLocaleString('en-SG', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  function fmtDateSg(sqlite: string | null): string {
    if (!sqlite) return '';
    const date = new Date(sqlite.replace(' ', 'T') + 'Z');
    if (Number.isNaN(date.getTime())) return sqlite;
    return date.toLocaleString('en-GB', {
      timeZone: 'Asia/Singapore',
      day: '2-digit',
      month: 'short',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
    });
  }

  // Date-only fields (voucher_date is stored as YYYY-MM-DD) render like the
  // other dates on the page: 24 Aug 2026.
  function fmtDateOnly(iso: string | null): string {
    if (!iso) return '';
    const m = iso.match(/^(\d{4})-(\d{2})-(\d{2})$/);
    if (!m) return iso;
    const date = new Date(Date.UTC(Number(m[1]), Number(m[2]) - 1, Number(m[3])));
    return date.toLocaleDateString('en-GB', { timeZone: 'UTC', day: '2-digit', month: 'short', year: 'numeric' });
  }

  function fmtSize(bytes: number): string {
    if (bytes >= 1024 * 1024) return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
    return Math.max(1, Math.round(bytes / 1024)) + ' KB';
  }

  function todayIso(): string {
    return new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Singapore' });
  }

  function parseVoucherLines(raw: string | null): VoucherLine[] {
    if (!raw) return [];
    try {
      const parsed = JSON.parse(raw);
      return Array.isArray(parsed) ? (parsed as VoucherLine[]) : [];
    } catch {
      return [];
    }
  }

  function voucherTotal(lines: VoucherLine[]): number {
    return Math.round(lines.reduce((sum, line) => sum + (typeof line.amount === 'number' ? line.amount : 0), 0) * 100) / 100;
  }

  function chip(status: string): string {
    const label = STATUS_LABELS[status] || status;
    return `<span class="ap-chip ap-chip-${esc(status)}">${esc(label)}</span>`;
  }

  // ---- Board ----------------------------------------------------------

  async function loadList(): Promise<void> {
    const res = await fetch('/api/approvals');
    if (!res.ok) return;
    const body = (await res.json()) as { items: ApprovalItem[]; counts: Record<string, number> };
    allItems = body.items || [];
    counts = body.counts || {};
    renderCounts();
    renderTable();
  }

  function renderCounts(): void {
    document.querySelectorAll<HTMLSpanElement>('.ap-tab-count').forEach((el) => {
      const key = el.dataset.count || '';
      el.textContent = String(counts[key] ?? 0);
    });
  }

  // ---- Sorting + pagination -------------------------------------------

  function sortValue(item: ApprovalItem, key: SortKey): string | number | null {
    switch (key) {
      case 'requested_amount':
        return item.requested_amount === null || item.requested_amount === undefined ? null : Number(item.requested_amount);
      case 'category':
        return CATEGORY_LABELS[item.category] || item.category;
      case 'status':
        return STATUS_LABELS[item.status] || item.status;
      default:
        return (item[key] as string | null) || null;
    }
  }

  // Empty values always sink to the bottom regardless of direction.
  function compareItems(a: ApprovalItem, b: ApprovalItem): number {
    const va = sortValue(a, sortKey);
    const vb = sortValue(b, sortKey);
    if (va === null && vb === null) return 0;
    if (va === null) return 1;
    if (vb === null) return -1;
    let cmp: number;
    if (typeof va === 'number' && typeof vb === 'number') {
      cmp = va - vb;
    } else {
      // numeric: true keeps voucher numbers like PV26-0802 < PV26-0811 in order.
      cmp = String(va).localeCompare(String(vb), 'en', { sensitivity: 'base', numeric: true });
    }
    return sortDir === 'asc' ? cmp : -cmp;
  }

  function filteredItems(): ApprovalItem[] {
    const items = currentTab === 'all' ? [...allItems] : allItems.filter((i) => i.status === currentTab);
    // Array.prototype.sort is stable, so ties keep the API's newest-first order.
    items.sort(compareItems);
    return items;
  }

  function renderSortHeads(): void {
    document.querySelectorAll<HTMLTableCellElement>('#ap-board-table th.ap-sortable').forEach((th) => {
      const key = (th.dataset.sort || '') as SortKey;
      const active = key === sortKey;
      th.classList.toggle('ap-sort-asc', active && sortDir === 'asc');
      th.classList.toggle('ap-sort-desc', active && sortDir === 'desc');
      th.setAttribute('aria-sort', active ? (sortDir === 'asc' ? 'ascending' : 'descending') : 'none');
    });
  }

  document.querySelectorAll<HTMLTableCellElement>('#ap-board-table th.ap-sortable').forEach((th) => {
    th.addEventListener('click', () => {
      const key = (th.dataset.sort || '') as SortKey;
      if (key === sortKey) {
        sortDir = sortDir === 'asc' ? 'desc' : 'asc';
      } else {
        sortKey = key;
        // Dates read naturally newest-first; text reads A to Z.
        sortDir = key === 'created_at' || key === 'voucher_date' ? 'desc' : 'asc';
      }
      currentPage = 1;
      renderTable();
    });
  });

  // Page numbers with ellipsis: 1 … n-1 n n+1 … last (plain run when few).
  function pageList(current: number, total: number): Array<number | 'ellipsis'> {
    if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
    const wanted = [1, total, current - 1, current, current + 1].filter((p) => p >= 1 && p <= total) as number[];
    const unique = [...new Set(wanted)].sort((a, b) => a - b);
    const out: Array<number | 'ellipsis'> = [];
    let prev = 0;
    for (const p of unique) {
      if (p - prev > 1) out.push('ellipsis');
      out.push(p);
      prev = p;
    }
    return out;
  }

  function renderPagination(totalItems: number, start: number, shown: number, totalPages: number): void {
    const box = document.getElementById('ap-pagination');
    if (!box) return;
    if (totalItems === 0) {
      box.innerHTML = '';
      return;
    }
    const parts: string[] = [
      `<button type="button" class="ap-page-btn" data-page="${currentPage - 1}"${currentPage === 1 ? ' disabled' : ''}>Prev</button>`,
    ];
    for (const p of pageList(currentPage, totalPages)) {
      if (p === 'ellipsis') parts.push('<span class="ap-page-ellipsis">&hellip;</span>');
      else parts.push(`<button type="button" class="ap-page-btn${p === currentPage ? ' active' : ''}" data-page="${p}">${p}</button>`);
    }
    parts.push(`<button type="button" class="ap-page-btn" data-page="${currentPage + 1}"${currentPage === totalPages ? ' disabled' : ''}>Next</button>`);
    box.innerHTML =
      `<span class="ap-page-info">Showing ${start + 1}\u2013${start + shown} of ${totalItems}</span>` +
      `<div class="ap-page-btns">${parts.join('')}</div>`;
    box.querySelectorAll<HTMLButtonElement>('.ap-page-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const p = Number(btn.dataset.page);
        if (p >= 1 && p <= totalPages && p !== currentPage) {
          currentPage = p;
          renderTable();
        }
      });
    });
  }

  function renderTable(): void {
    const tbody = document.getElementById('ap-list');
    if (!tbody) return;
    renderSortHeads();
    const items = filteredItems();
    if (items.length === 0) {
      renderPagination(0, 0, 0, 1);
      tbody.innerHTML = `<tr><td colspan="9" style="text-align:center;color:var(--text-muted);padding:1.5rem;">No items in this view.</td></tr>`;
      return;
    }
    const totalPages = Math.max(1, Math.ceil(items.length / PAGE_SIZE));
    if (currentPage > totalPages) currentPage = totalPages;
    const start = (currentPage - 1) * PAGE_SIZE;
    const pageItems = items.slice(start, start + PAGE_SIZE);
    tbody.innerHTML = pageItems
      .map(
        (item) => `<tr>
          <td>${esc(item.voucher_no || '—')}</td>
          <td>${esc(fmtDateOnly(item.voucher_date) || '—')}</td>
          <td>${esc(item.title)}</td>
          <td>${esc(item.payee || '—')}</td>
          <td>${esc(CATEGORY_LABELS[item.category] || item.category)}</td>
          <td>${esc(fmtMoney(item.requested_amount) || '—')}</td>
          <td>${chip(item.status)}</td>
          <td>${esc(fmtDateSg(item.created_at))}</td>
          <td><button type="button" class="row-view-btn" data-id="${item.id}" aria-label="View ${esc(item.title)}">View</button></td>
        </tr>`,
      )
      .join('');

    tbody.querySelectorAll<HTMLButtonElement>('.row-view-btn').forEach((btn) => {
      btn.addEventListener('click', () => openDrawer(Number(btn.dataset.id)));
    });
    renderPagination(items.length, start, pageItems.length, totalPages);
  }

  document.querySelectorAll<HTMLButtonElement>('.ap-tab').forEach((btn) => {
    btn.addEventListener('click', () => {
      currentTab = btn.dataset.status || 'all';
      document.querySelectorAll('.ap-tab').forEach((el) => {
        el.classList.toggle('active', el === btn);
        el.setAttribute('aria-selected', el === btn ? 'true' : 'false');
      });
      currentPage = 1;
      renderTable();
    });
  });

  // ---- Drawer ---------------------------------------------------------

  async function openDrawer(id: number): Promise<void> {
    const overlay = document.getElementById('ap-drawer-overlay');
    const body = document.getElementById('ap-drawer-body');
    const title = document.getElementById('ap-drawer-title');
    if (!overlay || !body || !title) return;
    body.innerHTML = '<p style="color:var(--text-muted);">Loading…</p>';
    overlay.removeAttribute('hidden');
    document.body.style.overflow = 'hidden';

    const res = await fetch(`/api/approvals/${id}`);
    if (!res.ok) {
      body.innerHTML = '<p>Could not load this item.</p>';
      return;
    }
    const data = (await res.json()) as { item: ApprovalItem; attachments: ApprovalAttachment[] };
    const item = data.item;
    const attachments = data.attachments || [];
    title.textContent = item.title;

    // Third tuple element marks rows whose values can be long (emails,
    // payment references) — they span both grid columns and never wrap.
    const detailRows: Array<[string, string, boolean?]> = [
      ['Status', chip(item.status)],
      ['Category', esc(CATEGORY_LABELS[item.category] || item.category)],
      ['Approval required', item.approval_required === 1 ? 'Yes' : 'No'],
      ['Payable to', esc(item.payee || '')],
      ['Requested amount', esc(fmtMoney(item.requested_amount))],
      ['Voucher No', esc(item.voucher_no || '')],
      ['Voucher date', esc(fmtDateOnly(item.voucher_date))],
      ['Raised by', esc(item.created_by), true],
      ['Raised at (SG)', esc(fmtDateSg(item.created_at))],
      ...(item.paid_by
        ? ([
            ['Paid by', esc(item.paid_by), true],
            ['Paid on', esc(fmtDateSg(item.paid_at))],
            ['Payment method', esc(PAYMENT_METHOD_LABELS[item.payment_method || ''] || item.payment_method || '')],
            ['Payment reference', esc(item.payment_reference || ''), true],
          ] as Array<[string, string, boolean?]>)
        : []),
    ];

    let notesHtml = '';
    if (item.status === 'rejected' && item.rejected_stage === 'purchase' && item.rejection_reason) {
      notesHtml += `<div class="ap-note"><strong>Rejected at purchase stage:</strong> ${esc(item.rejection_reason)}</div>`;
    }
    if (item.rejected_stage === 'finance' && item.finance_rejection_reason) {
      notesHtml += `<div class="ap-note"><strong>Rejected at finance stage:</strong> ${esc(item.finance_rejection_reason)}</div>`;
    }

    const attachmentsHtml =
      attachments.length === 0
        ? '<p style="color:var(--text-muted);font-size:0.85rem;">No documents attached.</p>'
        : attachments
            .map((att) => {
              const url = `/api/approvals/${item.id}/attachment/${att.id}`;
              const isImage = att.mime_type.startsWith('image/');
              const preview = isImage
                ? `<img src="${url}" alt="${esc(att.filename)}" loading="lazy" />`
                : `<iframe src="${url}" title="${esc(att.filename)}" loading="lazy"></iframe>`;
              return `<div class="ap-attachment">
                <div class="ap-attachment-head">
                  <span class="ap-attachment-name">${esc(att.filename)}</span>
                  <span class="ap-attachment-actions">
                    <span style="color:var(--text-muted);font-size:0.78rem;">${esc(fmtSize(att.size))}</span>
                    <a href="${url}" target="_blank" rel="noopener noreferrer">Open</a>
                    <a href="${url}?download=1">Download</a>
                  </span>
                </div>
                <div class="ap-attachment-preview">${preview}</div>
              </div>`;
            })
            .join('');

    const comparisonRows = Array.isArray(item.comparison) ? item.comparison : [];
    const comparisonHtml =
      comparisonRows.length === 0
        ? ''
        : `<div>
            <h3 style="font-size:1rem;margin:0 0 0.5rem;">Comparison table</h3>
            <table class="ap-comparison-table">
              <thead><tr><th>Quotation</th><th>Document</th></tr></thead>
              <tbody>
                ${comparisonRows
                  .map((row) => {
                    const att = attachments.find((a) => a.id === row.attachmentId);
                    const link = att
                      ? `<a href="/api/approvals/${item.id}/attachment/${att.id}" target="_blank" rel="noopener noreferrer">${esc(att.filename)}</a>`
                      : '<span style="color:var(--text-muted);">Document unavailable</span>';
                    return `<tr><td>${esc(row.description)}</td><td>${link}</td></tr>`;
                  })
                  .join('')}
              </tbody>
            </table>
          </div>`;

    // ---- Stored AI analysis (read-only for everyone; regeneration happens
    //      through the edit form's Analyse button — owner decision 26-08-2026) ----
    const aiAnalysis = item.ai_comparison && typeof item.ai_comparison === 'object' ? (item.ai_comparison as AiAnalysis) : null;
    const aiEditAvailable =
      !!sessionData?.is_admin && sessionData?.ai_comparison_enabled !== false && comparisonRows.length >= 2;
    let aiHtml = '';
    if (aiAnalysis) {
      aiHtml = `<div class="ap-ai-block">
        ${renderAiAnalysisBlock(aiAnalysis)}
      </div>`;
    }

    // ---- Stage-appropriate actions (plan §11) ----
    const voucherLines = parseVoucherLines(item.voucher_lines);
    const hasVoucher = !!item.voucher_no;
    const canApprove = item.status === 'pending' && !!sessionData?.is_purchase_approver;
    const canFinanceDecide = item.status === 'finance_check' && !!sessionData?.is_finance_approver;
    const canRemind = (item.status === 'pending' || item.status === 'finance_check') && !!sessionData?.is_admin;
    const canEdit = (item.status === 'pending' || (item.status === 'rejected' && item.rejected_stage === 'purchase')) && !!sessionData?.is_admin;
    const canVoucher =
      (item.status === 'purchase_approved' || (item.status === 'rejected' && item.rejected_stage === 'finance')) && !!sessionData?.is_admin;
    const canRecordPaid = item.status === 'finance_approved' && !!sessionData?.is_admin;
    const showVoucherLink = (item.status === 'finance_approved' || item.status === 'paid') && !!item.voucher_no;
    const actionsHtml =
      canApprove || canFinanceDecide || canRemind || canEdit || canVoucher || canRecordPaid || showVoucherLink
        ? `<div class="ap-actions">
            ${canFinanceDecide ? '<button type="button" class="btn btn-primary" id="ap-act-finance-approve">Approve voucher</button>' : ''}
            ${canFinanceDecide ? '<button type="button" class="btn btn-danger" id="ap-act-finance-reject">Reject voucher\u2026</button>' : ''}
            ${canApprove ? '<button type="button" class="btn btn-primary" id="ap-act-approve">Approve</button>' : ''}
            ${canApprove ? '<button type="button" class="btn btn-danger" id="ap-act-reject">Reject\u2026</button>' : ''}
            ${canVoucher ? `<button type="button" class="btn btn-primary" id="ap-act-voucher">${hasVoucher ? 'Edit voucher & resubmit' : 'Prepare voucher'}</button>` : ''}
            ${canRecordPaid ? '<button type="button" class="btn btn-primary" id="ap-act-paid">Record payment\u2026</button>' : ''}
            ${showVoucherLink ? `<a class="btn btn-secondary" href="/approvals/voucher?id=${item.id}" target="_blank" rel="noopener noreferrer">View voucher</a>` : ''}
            ${canRemind ? '<button type="button" class="btn btn-secondary" id="ap-act-remind">Send reminder</button>' : ''}
            ${canEdit ? '<button type="button" class="btn btn-secondary" id="ap-act-edit">Edit</button>' : ''}
            <span id="ap-act-msg" role="status" aria-live="polite" style="font-size:0.85rem;"></span>
          </div>
          <div id="ap-reject-box" hidden>
            <label class="ap-field" style="display:block;">
              <span>Reason for rejection (sent to the requester)</span>
              <textarea id="ap-reject-reason" class="form-input" rows="3" maxlength="1000" placeholder="e.g. Please get a second quotation above S$5,000."></textarea>
            </label>
            <button type="button" class="btn btn-danger" id="ap-act-reject-confirm" style="margin-top:0.5rem;">Confirm rejection</button>
          </div>
          <div id="ap-finance-reject-box" hidden>
            <label class="ap-field" style="display:block;">
              <span>Reason for rejection (sent to the requester)</span>
              <textarea id="ap-finance-reject-reason" class="form-input" rows="3" maxlength="1000" placeholder="e.g. The total does not match the invoice; please correct line 2."></textarea>
            </label>
            <button type="button" class="btn btn-danger" id="ap-act-finance-reject-confirm" style="margin-top:0.5rem;">Confirm rejection</button>
          </div>
          <form id="ap-paid-form" hidden>
            <div class="ap-form-grid">
              <label class="ap-field"><span>Who made the payment</span>
                <input type="text" id="ap-paid-by" class="form-input" maxlength="200" placeholder="e.g. Jolene Lim (SWA DBS app)" required /></label>
              <label class="ap-field"><span>Payment date</span>
                <input type="date" id="ap-paid-date" class="form-input" value="${todayIso()}" required /></label>
              <label class="ap-field"><span>Method</span>
                <select id="ap-paid-method" class="form-input" required>
                  <option value="paynow">PayNow</option>
                  <option value="bank_transfer">Bank transfer</option>
                  <option value="cheque">Cheque</option>
                  <option value="cash">Cash</option>
                  <option value="other">Other</option>
                </select></label>
              <label class="ap-field"><span>Reference (optional)</span>
                <input type="text" id="ap-paid-reference" class="form-input" maxlength="200" placeholder="e.g. PayNow ref 20260824001" /></label>
            </div>
            <div style="display:flex;gap:0.5rem;align-items:center;margin-top:0.75rem;">
              <button type="submit" class="btn btn-primary">Record payment</button>
              <button type="button" class="btn btn-secondary" id="ap-paid-cancel">Cancel</button>
            </div>
          </form>
          <form id="ap-voucher-form" hidden>
            <div class="ap-form-grid">
              <label class="ap-field"><span>Voucher date</span>
                <input type="date" id="ap-voucher-date" class="form-input" value="${esc(item.voucher_date || todayIso())}" required /></label>
              <label class="ap-field"><span>Payable to (carried from the item)</span>
                <input type="text" class="form-input" value="${esc(item.payee || '')}" disabled /></label>
            </div>
            <p style="margin:0.75rem 0 0.25rem;font-weight:600;font-size:0.85rem;">Voucher lines</p>
