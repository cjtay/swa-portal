---
import AdminLayout from '../layouts/AdminLayout.astro';
import { APPROVAL_CATEGORIES } from '../constants/portal';
---

<AdminLayout title="Approvals | SWA Admin Portal" currentPath="/approvals">
  <h1>Approvals</h1>
  <p style="color:var(--text-muted);margin-bottom:1.25rem;">
    Purchase and payment approvals. The office admin raises a request with its documents;
    purchase approvers decide first, then the finance pair checks the payment voucher.
  </p>

  <!-- Status tabs with counts (plan §11) -->
  <div class="ap-tabs" id="ap-tabs" role="tablist" aria-label="Approval status">
    <button type="button" class="ap-tab active" data-status="pending" role="tab" aria-selected="true">For approval <span class="ap-tab-count" data-count="pending">0</span></button>
    <button type="button" class="ap-tab" data-status="purchase_approved" role="tab" aria-selected="false">Approved <span class="ap-tab-count" data-count="purchase_approved">0</span></button>
    <button type="button" class="ap-tab" data-status="finance_check" role="tab" aria-selected="false">In finance check <span class="ap-tab-count" data-count="finance_check">0</span></button>
    <button type="button" class="ap-tab" data-status="finance_approved" role="tab" aria-selected="false">Finance approved <span class="ap-tab-count" data-count="finance_approved">0</span></button>
    <button type="button" class="ap-tab" data-status="rejected" role="tab" aria-selected="false">Rejected <span class="ap-tab-count" data-count="rejected">0</span></button>
    <button type="button" class="ap-tab" data-status="paid" role="tab" aria-selected="false">Paid <span class="ap-tab-count" data-count="paid">0</span></button>
    <button type="button" class="ap-tab" data-status="all" role="tab" aria-selected="false">All <span class="ap-tab-count" data-count="all">0</span></button>
  </div>

  <!-- New request (office admin only; hidden until the session confirms) -->
  <div class="card" id="ap-create-card" style="margin-bottom:1.5rem;display:none;">
    <h2 style="font-size:1.1rem;margin-top:0;">New request</h2>
    <form id="ap-create-form" enctype="multipart/form-data">
      <div class="ap-form-grid">
        <label class="ap-field">
          <span>Category</span>
          <select id="ap-category" class="form-input" required>
            {APPROVAL_CATEGORIES.map((cat) => (
              <option value={cat.key} data-requires-approval={cat.requiresApproval ? 'true' : 'false'}>{cat.label}</option>
            ))}
          </select>
        </label>
        <label class="ap-field">
          <span>Title</span>
          <input type="text" id="ap-title" class="form-input" maxlength="300" placeholder="e.g. 49th SWA Charity Gala Dinner 2026" required />
        </label>
        <label class="ap-field">
          <span>Payable to</span>
          <input type="text" id="ap-payee" class="form-input" maxlength="300" placeholder="Vendor or payee name" />
        </label>
        <label class="ap-field">
          <span>Requested amount (S$, optional)</span>
          <input type="number" id="ap-amount" class="form-input" min="0" max="10000000" step="0.01" placeholder="0.00" />
        </label>
      </div>

      <label class="ap-field" style="display:block;margin-top:0.75rem;">
        <span>Description / justification (optional, shown to approvers)</span>
        <textarea id="ap-description" class="form-input" rows="4" maxlength="4000" placeholder="Why this purchase is needed, context for approvers, breakdown of the amount…"></textarea>
      </label>

      <label class="ap-check">
        <input type="checkbox" id="ap-approval-required" checked />
        <span>Approval required (purchase approvers decide before the voucher)</span>
      </label>

      <label class="ap-field" style="display:block;margin-top:0.75rem;">
        <span>Documents — add one at a time or several at once (PDF or photos, up to 10 files, 10 MB each)</span>
        <input type="file" id="ap-files" class="form-input" multiple accept="application/pdf,image/jpeg,image/png,image/webp,image/heic,image/heif" />
      </label>
      <div id="ap-files-list" aria-live="polite"></div>
      <p id="ap-files-msg" style="margin:0.25rem 0 0;font-size:0.8rem;color:#b3261e;" hidden></p>

      <!-- Comparison opt-in: appears only when files are chosen. A single
           quotation may span several uploads (PDF + photos of the same
           quote), so the comparison rows require an explicit tick. -->
      <label class="ap-check" id="ap-comparison-toggle-wrap" hidden>
        <input type="checkbox" id="ap-comparison-toggle" />
        <span>I have multiple quotations to compare</span>
      </label>

      <!-- Comparison builder: one row per chosen file (plan §6) -->
      <div id="ap-comparison-builder" hidden>
        <p style="margin:0.75rem 0 0.25rem;font-weight:600;">Comparison table</p>
        <p style="margin:0 0 0.5rem;color:var(--text-muted);font-size:0.85rem;">
          Tick the quotations you want in the comparison and describe each one.
          Each row links to that document for the finance check.
        </p>
        <div id="ap-comparison-rows"></div>
      </div>

      <div style="display:flex;align-items:center;gap:0.75rem;margin-top:1rem;flex-wrap:wrap;">
        <button type="submit" class="btn btn-primary" id="ap-create-submit">Raise request</button>
        <span id="ap-create-msg" style="font-size:0.85rem;color:var(--text-muted);"></span>
      </div>
    </form>
  </div>

  <!-- Board table -->
  <div class="card">
    <div class="table-scroll">
      <table class="data-table">
        <thead>
          <tr>
            <th>Voucher No</th>
            <th>Date</th>
            <th>Title</th>
            <th>Payee</th>
            <th>Category</th>
            <th>Amount</th>
            <th>Status</th>
            <th>Created (SG)</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="ap-list"></tbody>
      </table>
    </div>
  </div>

  <!-- Detail drawer -->
  <div class="drawer-overlay" id="ap-drawer-overlay" hidden>
    <aside class="drawer" id="ap-drawer" role="dialog" aria-modal="true" aria-labelledby="ap-drawer-title">
      <header class="drawer-header">
        <h2 id="ap-drawer-title">Approval item</h2>
        <button type="button" class="drawer-close" id="ap-drawer-close" aria-label="Close">&times;</button>
      </header>
      <div class="drawer-body" id="ap-drawer-body"></div>
    </aside>
  </div>
</AdminLayout>

<style is:global>
  .admin-main { max-width: 1600px; }

  .ap-tabs { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 1rem; }
  .ap-tab {
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--text-muted);
    border-radius: 9999px;
    cursor: pointer;
    font-size: 0.85rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .ap-tab:hover { border-color: var(--swa-3); color: var(--swa-2); }
  .ap-tab.active { background: var(--swa-1); border-color: var(--swa-1); color: #fff; }
  .ap-tab-count {
    background: var(--swa-4);
    color: var(--swa-2);
    border-radius: 9999px;
    padding: 0 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    min-width: 1.3rem;
    text-align: center;
  }
  .ap-tab.active .ap-tab-count { background: rgba(255, 255, 255, 0.25); color: #fff; }

  .table-scroll { overflow-x: auto; border: 1px solid var(--border); border-radius: 0.4rem; }

  .ap-form-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }
  .ap-field { display: flex; flex-direction: column; gap: 0.25rem; font-size: 0.85rem; }
  .ap-check { display: flex; align-items: center; gap: 0.5rem; font-size: 0.85rem; }
  /* display:flex would override the hidden attribute (same class of bug as
     the 2026-07-05 drawer fix) — restore it explicitly. */
  .ap-check[hidden] { display: none; }

  .ap-actions { display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; }
  .ap-actions a.btn { text-decoration: none; display: inline-flex; align-items: center; }
  #ap-reject-box, #ap-edit-form, #ap-voucher-form, #ap-paid-form {
    border: 1px solid var(--border);
    border-radius: 0.4rem;
    padding: 0.75rem;
    background: #fafafa;
  }

  .ap-vline-row {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0;
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
  }
  .ap-vline-row:last-child { border-bottom: none; }

  .ap-comp-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0;
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
  }
  .ap-comp-row:last-child { border-bottom: none; }
  .ap-comp-name { font-size: 0.85rem; min-width: 180px; word-break: break-all; }

  .ap-file-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.35rem 0;
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
  }
  .ap-file-row:last-of-type { border-bottom: none; }
  .ap-file-row .ap-comp-name { min-width: 0; flex: 1; }
  .ap-file-remove {
    padding: 0.15rem 0.55rem;
    font-size: 0.75rem;
    border: 1px solid var(--border);
    background: var(--bg);
    color: #b3261e;
    border-radius: 0.3rem;
    cursor: pointer;
  }
  .ap-file-remove:hover { border-color: #b3261e; }

  .ap-chip {
    display: inline-block;
    padding: 0.15rem 0.6rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .ap-chip-pending { background: #fff3d6; color: #7a5c00; }
  .ap-chip-purchase_approved { background: #e8f5e9; color: #1b7f3b; }
  .ap-chip-finance_check { background: #e8f0fe; color: #1a4fa0; }
  .ap-chip-finance_approved { background: #dff2e6; color: #0d6b3f; }
  .ap-chip-rejected { background: #fdecea; color: #b3261e; }
  .ap-chip-paid { background: #eceff1; color: #37474f; }

  .row-view-btn {
    padding: 0.3rem 0.7rem;
    font-size: 0.78rem;
    border: 1px solid var(--swa-3);
    background: var(--bg);
    color: var(--swa-2);
    border-radius: 0.3rem;
    cursor: pointer;
  }
  .row-view-btn:hover { background: #f5f0f8; }

  .drawer-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    z-index: 50;
    display: flex;
    justify-content: flex-end;
  }
  .drawer-overlay[hidden] { display: none; }
  .drawer {
    width: min(760px, 100%);
    background: var(--bg);
    height: 100%;
    overflow-y: auto;
    box-shadow: -10px 0 30px -10px rgba(0, 0, 0, 0.3);
    display: flex;
    flex-direction: column;
  }
  .drawer-header {
    position: sticky;
    top: 0;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    padding: 1rem 1.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 2;
  }
  .drawer-header h2 { margin: 0; font-size: 1.15rem; color: var(--swa-2); }
  .drawer-close {
    background: none;
    border: none;
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
    color: var(--text-muted);
  }
  .drawer-body { padding: 1.25rem; display: flex; flex-direction: column; gap: 1.25rem; }

  .ap-detail-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 0.6rem 1.25rem;
  }
  .ap-detail-item { font-size: 0.85rem; }
  .ap-detail-item dt { color: var(--text-muted); margin: 0 0 0.15rem; }
  .ap-detail-item dd { margin: 0; font-weight: 500; word-break: break-word; }

  .ap-note {
    border-left: 3px solid #b3261e;
    background: #fdecea;
    padding: 0.6rem 0.8rem;
    border-radius: 0 0.3rem 0.3rem 0;
    font-size: 0.85rem;
  }

  .ap-attachment {
    border: 1px solid var(--border);
    border-radius: 0.4rem;
    padding: 0.75rem;
    margin-bottom: 0.75rem;
  }
  .ap-attachment-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }
  .ap-attachment-name { font-size: 0.85rem; font-weight: 600; word-break: break-all; }
  .ap-attachment-actions { display: flex; gap: 0.5rem; align-items: center; }
  .ap-attachment-actions a {
    font-size: 0.78rem;
    color: var(--swa-2);
  }
  .ap-attachment-preview img { max-width: 100%; height: auto; border-radius: 0.3rem; }
  .ap-attachment-preview iframe { width: 100%; height: 560px; border: 1px solid var(--border); border-radius: 0.3rem; }

  .ap-comparison-table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
  .ap-comparison-table th, .ap-comparison-table td {
    border: 1px solid var(--border);
    padding: 0.4rem 0.6rem;
    text-align: left;
    vertical-align: top;
  }
  .ap-comparison-table th { background: #f5f0f8; color: var(--swa-2); }
</style>

<script>
  import { requireAuth, type SessionResponse } from '../scripts/auth-gate';

  interface ApprovalItem {
    id: number;
    category: string;
    title: string;
    payee: string | null;
    description: string | null;
    requested_amount: number | null;
    approval_required: number;
    status: string;
    rejected_stage: string | null;
    rejection_reason: string | null;
    finance_rejection_reason: string | null;
    voucher_no: string | null;
    voucher_date: string | null;
    voucher_lines: string | null;
    voucher_submitted_by: string | null;
    voucher_submitted_at: string | null;
    finance_decision_by: string | null;
    finance_decision_at: string | null;
    paid_by: string | null;
    paid_at: string | null;
    payment_method: string | null;
    payment_reference: string | null;
    created_by: string;
    created_at: string;
    updated_at: string;
    comparison?: Array<{ attachmentId: number; description: string }> | null;
  }

  interface VoucherLine {
    no: number | null;
    date: string | null;
    description: string;
    amount: number | null;
  }

  interface ApprovalAttachment {
    id: number;
    filename: string;
    mime_type: string;
    size: number;
    created_at: string;
  }

  const STATUS_LABELS: Record<string, string> = {
    pending: 'For approval',
    purchase_approved: 'Approved',
    finance_check: 'In finance check',
    finance_approved: 'Finance approved',
    rejected: 'Rejected',
    paid: 'Paid',
  };

  const PAYMENT_METHOD_LABELS: Record<string, string> = {
    paynow: 'PayNow',
    bank_transfer: 'Bank transfer',
    cheque: 'Cheque',
    cash: 'Cash',
    other: 'Other',
  };

  // Category labels are read from the <select> options rather than an inline
  // JSON tag: Astro treats content inside <script> tags as raw text, so an
  // {expression} there ships unevaluated and breaks JSON.parse.
  const CATEGORY_LABELS: Record<string, string> = (() => {
    const out: Record<string, string> = {};
    document.querySelectorAll<HTMLSelectElement>('#ap-category option').forEach((opt) => {
      out[opt.value] = opt.textContent?.trim() || opt.value;
    });
    return out;
  })();

  let allItems: ApprovalItem[] = [];
  let counts: Record<string, number> = {};
  let currentTab = 'pending';
  let sessionData: SessionResponse | null = null;

  function esc(value: unknown): string {
    return String(value ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function fmtMoney(value: number | null): string {
    if (value === null || value === undefined) return '';
    // Sign before the currency, matching the emails: -S$400.00.
    const sign = value < 0 ? '-' : '';
    return sign + 'S$' + Math.abs(value).toLocaleString('en-SG', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  function fmtDateSg(sqlite: string | null): string {
    if (!sqlite) return '';
    const date = new Date(sqlite.replace(' ', 'T') + 'Z');
    if (Number.isNaN(date.getTime())) return sqlite;
    return date.toLocaleString('en-GB', {
      timeZone: 'Asia/Singapore',
      day: '2-digit',
      month: 'short',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
    });
  }

  function fmtSize(bytes: number): string {
    if (bytes >= 1024 * 1024) return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
    return Math.max(1, Math.round(bytes / 1024)) + ' KB';
  }

  function todayIso(): string {
    return new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Singapore' });
  }

  function parseVoucherLines(raw: string | null): VoucherLine[] {
    if (!raw) return [];
    try {
      const parsed = JSON.parse(raw);
      return Array.isArray(parsed) ? (parsed as VoucherLine[]) : [];
    } catch {
      return [];
    }
  }

  function voucherTotal(lines: VoucherLine[]): number {
    return Math.round(lines.reduce((sum, line) => sum + (typeof line.amount === 'number' ? line.amount : 0), 0) * 100) / 100;
  }

  function chip(status: string): string {
    const label = STATUS_LABELS[status] || status;
    return `<span class="ap-chip ap-chip-${esc(status)}">${esc(label)}</span>`;
  }

  // ---- Board ----------------------------------------------------------

  async function loadList(): Promise<void> {
    const res = await fetch('/api/approvals');
    if (!res.ok) return;
    const body = (await res.json()) as { items: ApprovalItem[]; counts: Record<string, number> };
    allItems = body.items || [];
    counts = body.counts || {};
    renderCounts();
    renderTable();
  }

  function renderCounts(): void {
    document.querySelectorAll<HTMLSpanElement>('.ap-tab-count').forEach((el) => {
      const key = el.dataset.count || '';
      el.textContent = String(counts[key] ?? 0);
    });
  }

  function renderTable(): void {
    const tbody = document.getElementById('ap-list');
    if (!tbody) return;
    const items = currentTab === 'all' ? allItems : allItems.filter((i) => i.status === currentTab);
    if (items.length === 0) {
      tbody.innerHTML = `<tr><td colspan="9" style="text-align:center;color:var(--text-muted);padding:1.5rem;">No items in this view.</td></tr>`;
      return;
    }
    tbody.innerHTML = items
      .map(
        (item) => `<tr>
          <td>${esc(item.voucher_no || '')}</td>
          <td>${esc(item.voucher_date || '')}</td>
          <td>${esc(item.title)}</td>
          <td>${esc(item.payee || '')}</td>
          <td>${esc(CATEGORY_LABELS[item.category] || item.category)}</td>
          <td>${esc(fmtMoney(item.requested_amount))}</td>
          <td>${chip(item.status)}</td>
          <td>${esc(fmtDateSg(item.created_at))}</td>
          <td><button type="button" class="row-view-btn" data-id="${item.id}">View</button></td>
        </tr>`,
      )
      .join('');

    tbody.querySelectorAll<HTMLButtonElement>('.row-view-btn').forEach((btn) => {
      btn.addEventListener('click', () => openDrawer(Number(btn.dataset.id)));
    });
  }

  document.querySelectorAll<HTMLButtonElement>('.ap-tab').forEach((btn) => {
    btn.addEventListener('click', () => {
      currentTab = btn.dataset.status || 'all';
      document.querySelectorAll('.ap-tab').forEach((el) => {
        el.classList.toggle('active', el === btn);
        el.setAttribute('aria-selected', el === btn ? 'true' : 'false');
      });
      renderTable();
    });
  });

  // ---- Drawer ---------------------------------------------------------

  async function openDrawer(id: number): Promise<void> {
    const overlay = document.getElementById('ap-drawer-overlay');
    const body = document.getElementById('ap-drawer-body');
    const title = document.getElementById('ap-drawer-title');
    if (!overlay || !body || !title) return;
    body.innerHTML = '<p style="color:var(--text-muted);">Loading…</p>';
    overlay.removeAttribute('hidden');
    document.body.style.overflow = 'hidden';

    const res = await fetch(`/api/approvals/${id}`);
    if (!res.ok) {
      body.innerHTML = '<p>Could not load this item.</p>';
      return;
    }
    const data = (await res.json()) as { item: ApprovalItem; attachments: ApprovalAttachment[] };
    const item = data.item;
    const attachments = data.attachments || [];
    title.textContent = item.title;

    const detailRows: Array<[string, string]> = [
      ['Status', chip(item.status)],
      ['Category', esc(CATEGORY_LABELS[item.category] || item.category)],
      ['Approval required', item.approval_required === 1 ? 'Yes' : 'No'],
      ['Payable to', esc(item.payee || '')],
      ['Requested amount', esc(fmtMoney(item.requested_amount))],
      ['Voucher No', esc(item.voucher_no || '')],
      ['Voucher date', esc(item.voucher_date || '')],
      ['Raised by', esc(item.created_by)],
      ['Raised at (SG)', esc(fmtDateSg(item.created_at))],
      ...(item.paid_by
        ? ([
            ['Paid by', esc(item.paid_by)],
            ['Paid on', esc(item.paid_at || '')],
            ['Payment method', esc(PAYMENT_METHOD_LABELS[item.payment_method || ''] || item.payment_method || '')],
            ['Payment reference', esc(item.payment_reference || '')],
          ] as Array<[string, string]>)
        : []),
    ];

    let notesHtml = '';
    if (item.status === 'rejected' && item.rejected_stage === 'purchase' && item.rejection_reason) {
      notesHtml += `<div class="ap-note"><strong>Rejected at purchase stage:</strong> ${esc(item.rejection_reason)}</div>`;
    }
    if (item.rejected_stage === 'finance' && item.finance_rejection_reason) {
      notesHtml += `<div class="ap-note"><strong>Rejected at finance stage:</strong> ${esc(item.finance_rejection_reason)}</div>`;
    }

    const attachmentsHtml =
      attachments.length === 0
        ? '<p style="color:var(--text-muted);font-size:0.85rem;">No documents attached.</p>'
        : attachments
            .map((att) => {
              const url = `/api/approvals/${item.id}/attachment/${att.id}`;
              const isImage = att.mime_type.startsWith('image/');
              const preview = isImage
                ? `<img src="${url}" alt="${esc(att.filename)}" loading="lazy" />`
                : `<iframe src="${url}" title="${esc(att.filename)}" loading="lazy"></iframe>`;
              return `<div class="ap-attachment">
                <div class="ap-attachment-head">
                  <span class="ap-attachment-name">${esc(att.filename)}</span>
                  <span class="ap-attachment-actions">
                    <span style="color:var(--text-muted);font-size:0.78rem;">${esc(fmtSize(att.size))}</span>
                    <a href="${url}" target="_blank" rel="noopener noreferrer">Open</a>
                    <a href="${url}?download=1">Download</a>
                  </span>
                </div>
                <div class="ap-attachment-preview">${preview}</div>
              </div>`;
            })
            .join('');

    const comparisonRows = Array.isArray(item.comparison) ? item.comparison : [];
    const comparisonHtml =
      comparisonRows.length === 0
        ? ''
        : `<div>
            <h3 style="font-size:1rem;margin:0 0 0.5rem;">Comparison table</h3>
            <table class="ap-comparison-table">
              <thead><tr><th>Quotation</th><th>Document</th></tr></thead>
              <tbody>
                ${comparisonRows
                  .map((row) => {
                    const att = attachments.find((a) => a.id === row.attachmentId);
                    const link = att
                      ? `<a href="/api/approvals/${item.id}/attachment/${att.id}" target="_blank" rel="noopener noreferrer">${esc(att.filename)}</a>`
                      : '<span style="color:var(--text-muted);">Document unavailable</span>';
                    return `<tr><td>${esc(row.description)}</td><td>${link}</td></tr>`;
                  })
                  .join('')}
              </tbody>
            </table>
          </div>`;

    // ---- Stage-appropriate actions (plan §11) ----
    const voucherLines = parseVoucherLines(item.voucher_lines);
    const hasVoucher = !!item.voucher_no;
    const canApprove = item.status === 'pending' && !!sessionData?.is_purchase_approver;
    const canFinanceDecide = item.status === 'finance_check' && !!sessionData?.is_finance_approver;
    const canRemind = (item.status === 'pending' || item.status === 'finance_check') && !!sessionData?.is_admin;
    const canEdit = (item.status === 'pending' || item.status === 'rejected') && !!sessionData?.is_admin;
    const canVoucher =
      (item.status === 'purchase_approved' || (item.status === 'rejected' && item.rejected_stage === 'finance')) && !!sessionData?.is_admin;
    const canRecordPaid = item.status === 'finance_approved' && !!sessionData?.is_admin;
    const showVoucherLink = (item.status === 'finance_approved' || item.status === 'paid') && !!item.voucher_no;
    const actionsHtml =
      canApprove || canFinanceDecide || canRemind || canEdit || canVoucher || canRecordPaid || showVoucherLink
        ? `<div class="ap-actions">
            ${canFinanceDecide ? '<button type="button" class="btn btn-primary" id="ap-act-finance-approve">Approve voucher</button>' : ''}
            ${canFinanceDecide ? '<button type="button" class="btn btn-danger" id="ap-act-finance-reject">Reject voucher\u2026</button>' : ''}
            ${canApprove ? '<button type="button" class="btn btn-primary" id="ap-act-approve">Approve</button>' : ''}
            ${canApprove ? '<button type="button" class="btn btn-danger" id="ap-act-reject">Reject\u2026</button>' : ''}
            ${canVoucher ? `<button type="button" class="btn btn-primary" id="ap-act-voucher">${hasVoucher ? 'Edit voucher & resubmit' : 'Prepare voucher'}</button>` : ''}
            ${canRecordPaid ? '<button type="button" class="btn btn-primary" id="ap-act-paid">Record payment\u2026</button>' : ''}
            ${showVoucherLink ? `<a class="btn btn-secondary" href="/approvals/voucher?id=${item.id}" target="_blank" rel="noopener noreferrer">View voucher</a>` : ''}
            ${canRemind ? '<button type="button" class="btn btn-secondary" id="ap-act-remind">Send reminder</button>' : ''}
            ${canEdit ? '<button type="button" class="btn btn-secondary" id="ap-act-edit">Edit</button>' : ''}
            <span id="ap-act-msg" style="font-size:0.85rem;"></span>
          </div>
          <div id="ap-reject-box" hidden>
            <label class="ap-field" style="display:block;">
              <span>Reason for rejection (sent to the requester)</span>
              <textarea id="ap-reject-reason" class="form-input" rows="3" maxlength="1000" placeholder="e.g. Please get a second quotation above S$5,000."></textarea>
            </label>
            <button type="button" class="btn btn-danger" id="ap-act-reject-confirm" style="margin-top:0.5rem;">Confirm rejection</button>
          </div>
          <div id="ap-finance-reject-box" hidden>
            <label class="ap-field" style="display:block;">
              <span>Reason for rejection (sent to the requester)</span>
              <textarea id="ap-finance-reject-reason" class="form-input" rows="3" maxlength="1000" placeholder="e.g. The total does not match the invoice; please correct line 2."></textarea>
            </label>
            <button type="button" class="btn btn-danger" id="ap-act-finance-reject-confirm" style="margin-top:0.5rem;">Confirm rejection</button>
          </div>
          <form id="ap-paid-form" hidden>
            <div class="ap-form-grid">
              <label class="ap-field"><span>Who made the payment</span>
                <input type="text" id="ap-paid-by" class="form-input" maxlength="200" placeholder="e.g. Jolene Lim (SWA DBS app)" required /></label>
              <label class="ap-field"><span>Payment date</span>
                <input type="date" id="ap-paid-date" class="form-input" value="${todayIso()}" required /></label>
              <label class="ap-field"><span>Method</span>
                <select id="ap-paid-method" class="form-input" required>
                  <option value="paynow">PayNow</option>
                  <option value="bank_transfer">Bank transfer</option>
                  <option value="cheque">Cheque</option>
                  <option value="cash">Cash</option>
                  <option value="other">Other</option>
                </select></label>
              <label class="ap-field"><span>Reference (optional)</span>
                <input type="text" id="ap-paid-reference" class="form-input" maxlength="200" placeholder="e.g. PayNow ref 20260824001" /></label>
            </div>
            <div style="display:flex;gap:0.5rem;align-items:center;margin-top:0.75rem;">
              <button type="submit" class="btn btn-primary">Record payment</button>
              <button type="button" class="btn btn-secondary" id="ap-paid-cancel">Cancel</button>
            </div>
          </form>
          <form id="ap-voucher-form" hidden>
            <div class="ap-form-grid">
              <label class="ap-field"><span>Voucher date</span>
                <input type="date" id="ap-voucher-date" class="form-input" value="${esc(item.voucher_date || todayIso())}" required /></label>
              <label class="ap-field"><span>Payable to (carried from the item)</span>
                <input type="text" class="form-input" value="${esc(item.payee || '')}" disabled /></label>
            </div>
            <p style="margin:0.75rem 0 0.25rem;font-weight:600;font-size:0.85rem;">Voucher lines</p>
            <p style="margin:0 0 0.5rem;color:var(--text-muted);font-size:0.78rem;">
              Amounts may be negative (a deposit already paid). Leave the amount empty for note-only lines such as bank details.
              The voucher number is assigned when you submit.
            </p>
            <div id="ap-voucher-lines"></div>
            <button type="button" class="btn btn-secondary" id="ap-voucher-add-line" style="margin-top:0.5rem;">Add line</button>
            <p style="margin:0.75rem 0 0;font-weight:600;">Total: <span id="ap-voucher-total">S$0.00</span></p>
            <div style="display:flex;gap:0.5rem;align-items:center;margin-top:0.75rem;">
              <button type="submit" class="btn btn-primary">Submit voucher to finance</button>
              <button type="button" class="btn btn-secondary" id="ap-voucher-cancel">Cancel</button>
            </div>
          </form>
          <form id="ap-edit-form" hidden>
            <div class="ap-form-grid">
              <label class="ap-field"><span>Title</span>
                <input type="text" id="ap-edit-title" class="form-input" maxlength="300" value="${esc(item.title)}" /></label>
              <label class="ap-field"><span>Payable to</span>
                <input type="text" id="ap-edit-payee" class="form-input" maxlength="300" value="${esc(item.payee || '')}" /></label>
              <label class="ap-field"><span>Requested amount (S$)</span>
                <input type="number" id="ap-edit-amount" class="form-input" min="0" max="10000000" step="0.01" value="${item.requested_amount ?? ''}" /></label>
            </div>
            <label class="ap-field" style="display:block;margin-top:0.75rem;"><span>Description</span>
              <textarea id="ap-edit-description" class="form-input" rows="4" maxlength="4000">${esc(item.description || '')}</textarea></label>
            <label class="ap-field" style="display:block;margin-top:0.75rem;"><span>Add documents (optional)</span>
              <input type="file" id="ap-edit-files" class="form-input" multiple accept="application/pdf,image/jpeg,image/png,image/webp,image/heic,image/heif" /></label>
            ${item.status === 'rejected'
              ? `<label class="ap-check" style="margin-top:0.75rem;"><input type="checkbox" id="ap-edit-resubmit" checked /><span>Resubmit for approval (returns to the stage that rejected it)</span></label>`
              : ''}
            <div style="display:flex;gap:0.5rem;align-items:center;margin-top:0.75rem;">
              <button type="submit" class="btn btn-primary">Save changes</button>
              <button type="button" class="btn btn-secondary" id="ap-edit-cancel">Cancel</button>
            </div>
          </form>`
        : '';

    const voucherHtml =
      !hasVoucher
        ? ''
        : `<div class="ap-voucher">
            <h3 style="font-size:1rem;margin:0 0 0.5rem;">Payment voucher</h3>
            <p style="margin:0 0 0.5rem;font-size:0.85rem;">
              <strong>${esc(item.voucher_no || '')}</strong> — ${esc(item.voucher_date || '')} — payable to ${esc(item.payee || '—')}
            </p>
            <table class="ap-comparison-table">
              <thead><tr><th style="width:2.5rem;">No</th><th style="width:6rem;">Date</th><th>Description</th><th style="width:8rem; text-align:right;">Amount (S$)</th></tr></thead>
              <tbody>
                ${voucherLines
                  .map(
                    (line) =>
                      `<tr><td>${line.no ?? ''}</td><td>${esc(line.date || '')}</td><td>${esc(line.description)}</td><td style="text-align:right;">${
                        line.amount === null ? '' : fmtMoney(line.amount)
                      }</td></tr>`,
                  )
                  .join('')}
                <tr><td colspan="3" style="text-align:right;font-weight:600;">TOTAL PAYABLE</td><td style="text-align:right;font-weight:600;">${fmtMoney(
                  voucherTotal(voucherLines),
                )}</td></tr>
              </tbody>
            </table>
            <p style="margin:0.5rem 0 0;font-size:0.8rem;color:var(--text-muted);">
              Prepared by ${esc(item.voucher_submitted_by || '')}${item.voucher_submitted_at ? ` (${fmtDateSg(item.voucher_submitted_at)})` : ''}.
              ${item.finance_decision_by
                ? `Payment approved by ${esc(item.finance_decision_by)}${item.finance_decision_at ? ` (${fmtDateSg(item.finance_decision_at)})` : ''}.`
                : item.status === 'finance_check'
                  ? 'Awaiting finance approval.'
                  : ''}
            </p>
          </div>`;

    body.innerHTML = `
      ${notesHtml}
      ${actionsHtml}
      <dl class="ap-detail-grid">
        ${detailRows.map(([label, value]) => `<div class="ap-detail-item"><dt>${label}</dt><dd>${value || '—'}</dd></div>`).join('')}
      </dl>
      ${item.description ? `<div><h3 style="font-size:1rem;margin:0 0 0.5rem;">Description</h3><p style="margin:0;font-size:0.9rem;white-space:pre-wrap;word-break:break-word;">${esc(item.description)}</p></div>` : ''}
      ${voucherHtml}
      <div>
        <h3 style="font-size:1rem;margin:0 0 0.5rem;">Documents</h3>
        ${attachmentsHtml}
      </div>
      ${comparisonHtml}
    `;

    wireDrawerActions(item);
  }

  function setActMsg(text: string, ok: boolean): void {
    const el = document.getElementById('ap-act-msg');
    if (!el) return;
    el.textContent = text;
    el.style.color = ok ? '#1b7f3b' : '#b3261e';
  }

  async function refreshAfterAction(id: number): Promise<void> {
    await loadList();
    await openDrawer(id);
  }

  function wireDrawerActions(item: ApprovalItem): void {
    const msg = (text: string, ok = false) => setActMsg(text, ok);

    document.getElementById('ap-act-finance-approve')?.addEventListener('click', async () => {
      const btn = document.getElementById('ap-act-finance-approve') as HTMLButtonElement | null;
      if (!btn) return;
      btn.disabled = true;
      try {
        const res = await fetch(`/api/approvals/${item.id}/finance-approve`, { method: 'POST' });
        const body = (await res.json()) as { success: boolean; message?: string };
        if (body.success) {
          await refreshAfterAction(item.id);
        } else {
          msg(body.message || 'Could not approve the voucher.');
          btn.disabled = false;
        }
      } catch {
        msg('Network error.');
        btn.disabled = false;
      }
    });

    const financeRejectBox = document.getElementById('ap-finance-reject-box');
    document.getElementById('ap-act-finance-reject')?.addEventListener('click', () => {
      if (financeRejectBox) financeRejectBox.hidden = !financeRejectBox.hidden;
    });
    document.getElementById('ap-act-finance-reject-confirm')?.addEventListener('click', async () => {
      const reasonEl = document.getElementById('ap-finance-reject-reason') as HTMLTextAreaElement | null;
      const reason = reasonEl?.value.trim() || '';
      if (!reason) {
        msg('A reason is required to reject.');
        return;
      }
      try {
        const res = await fetch(`/api/approvals/${item.id}/finance-reject`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ reason }),
        });
        const body = (await res.json()) as { success: boolean; message?: string };
        if (body.success) {
          await refreshAfterAction(item.id);
        } else {
          msg(body.message || 'Could not reject the voucher.');
        }
      } catch {
        msg('Network error.');
      }
    });

    // ---- Paid form (admin, Phase 5) ----
    const paidForm = document.getElementById('ap-paid-form') as HTMLFormElement | null;
    document.getElementById('ap-act-paid')?.addEventListener('click', () => {
      if (paidForm) paidForm.hidden = !paidForm.hidden;
    });
    document.getElementById('ap-paid-cancel')?.addEventListener('click', () => {
      if (paidForm) paidForm.hidden = true;
    });
    paidForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const paidBy = (document.getElementById('ap-paid-by') as HTMLInputElement).value.trim();
      const paidDate = (document.getElementById('ap-paid-date') as HTMLInputElement).value;
      const paymentMethod = (document.getElementById('ap-paid-method') as HTMLSelectElement).value;
      const paymentReference = (document.getElementById('ap-paid-reference') as HTMLInputElement).value.trim();
      if (!paidBy || !paidDate) {
        msg('Record who made the payment and the date.');
        return;
      }
      try {
        const res = await fetch(`/api/approvals/${item.id}/paid`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ paidBy, paidDate, paymentMethod, paymentReference }),
        });
        const body = (await res.json()) as { success: boolean; message?: string };
        if (body.success) {
          await refreshAfterAction(item.id);
        } else {
          msg(body.message || 'Could not record the payment.');
        }
      } catch {
        msg('Network error.');
      }
    });

    // ---- Voucher form (admin, Phase 4) ----
    const voucherForm = document.getElementById('ap-voucher-form') as HTMLFormElement | null;
    const voucherLinesBox = document.getElementById('ap-voucher-lines');

    function addVoucherLine(line?: VoucherLine): void {
      if (!voucherLinesBox) return;
      const row = document.createElement('div');
      row.className = 'ap-vline-row';
      row.innerHTML = `
        <input type="text" class="form-input ap-vline-no" placeholder="No" value="${line?.no ?? ''}" maxlength="2" style="width:3rem;" />
        <input type="date" class="form-input ap-vline-date" value="${esc(line?.date || '')}" style="width:9rem;" />
        <input type="text" class="form-input ap-vline-desc" placeholder="Description" maxlength="500" style="flex:1;min-width:180px;" value="${esc(line?.description || '')}" />
        <input type="number" class="form-input ap-vline-amount" placeholder="Amount" step="0.01" style="width:9rem;" value="${line?.amount ?? ''}" />
        <button type="button" class="ap-file-remove ap-vline-remove" aria-label="Remove line">Remove</button>`;
      row.querySelector('.ap-vline-remove')?.addEventListener('click', () => {
        row.remove();
        updateVoucherTotal();
      });
      voucherLinesBox.appendChild(row);
    }

    function updateVoucherTotal(): void {
      const totalEl = document.getElementById('ap-voucher-total');
      if (!totalEl || !voucherLinesBox) return;
      let total = 0;
      voucherLinesBox.querySelectorAll<HTMLInputElement>('.ap-vline-amount').forEach((inp) => {
        const v = inp.value.trim();
        if (v.length > 0 && Number.isFinite(Number(v))) total += Number(v);
      });
      total = Math.round(total * 100) / 100;
      totalEl.textContent = fmtMoney(total);
    }

    function initVoucherForm(): void {
      if (!voucherLinesBox) return;
      voucherLinesBox.innerHTML = '';
      const existing = parseVoucherLines(item.voucher_lines);
      if (existing.length > 0) {
        existing.forEach((line) => addVoucherLine(line));
      } else {
        // Pre-fill from the item: one line for the title/amount (plan §7).
        addVoucherLine({ no: 1, date: todayIso(), description: item.title, amount: item.requested_amount });
      }
      updateVoucherTotal();
    }

    document.getElementById('ap-act-voucher')?.addEventListener('click', () => {
      if (!voucherForm) return;
      if (voucherForm.hidden) initVoucherForm();
      voucherForm.hidden = !voucherForm.hidden;
    });
    document.getElementById('ap-voucher-cancel')?.addEventListener('click', () => {
      if (voucherForm) voucherForm.hidden = true;
    });
    document.getElementById('ap-voucher-add-line')?.addEventListener('click', () => addVoucherLine());
    voucherLinesBox?.addEventListener('input', updateVoucherTotal);

    voucherForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!voucherLinesBox) return;
      const dateEl = document.getElementById('ap-voucher-date') as HTMLInputElement | null;
      const voucherDate = dateEl?.value || '';
      if (!/^\d{4}-\d{2}-\d{2}$/.test(voucherDate)) {
        msg('Pick a voucher date.');
        return;
      }
      const lines: VoucherLine[] = [];
      for (const row of Array.from(voucherLinesBox.querySelectorAll('.ap-vline-row'))) {
        const desc = (row.querySelector('.ap-vline-desc') as HTMLInputElement).value.trim();
        const amountRaw = (row.querySelector('.ap-vline-amount') as HTMLInputElement).value.trim();
        if (!desc && !amountRaw) continue; // skip fully-empty rows
        if (!desc) {
          msg('Every voucher line needs a description.');
          return;
        }
        const noRaw = (row.querySelector('.ap-vline-no') as HTMLInputElement).value.trim();
        lines.push({
          no: noRaw === '' ? null : Number(noRaw),
          date: (row.querySelector('.ap-vline-date') as HTMLInputElement).value || null,
          description: desc,
          amount: amountRaw === '' ? null : Number(amountRaw),
        });
      }
      if (lines.length === 0) {
        msg('The voucher needs at least one line.');
        return;
      }
      try {
        const res = await fetch(`/api/approvals/${item.id}/voucher`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ voucherDate, lines }),
        });
        const body = (await res.json()) as { success: boolean; message?: string };
        if (body.success) {
          await refreshAfterAction(item.id);
        } else {
          msg(body.message || 'Could not submit the voucher.');
        }
      } catch {
        msg('Network error.');
      }
    });

    document.getElementById('ap-act-approve')?.addEventListener('click', async () => {
      const btn = document.getElementById('ap-act-approve') as HTMLButtonElement | null;
      if (!btn) return;
      btn.disabled = true;
      try {
        const res = await fetch(`/api/approvals/${item.id}/approve`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' });
        const body = (await res.json()) as { success: boolean; message?: string };
        if (body.success) {
          await refreshAfterAction(item.id);
        } else {
          msg(body.message || 'Could not approve.');
          btn.disabled = false;
        }
      } catch {
        msg('Network error.');
        btn.disabled = false;
      }
    });

    const rejectBox = document.getElementById('ap-reject-box');
    document.getElementById('ap-act-reject')?.addEventListener('click', () => {
      if (rejectBox) rejectBox.hidden = !rejectBox.hidden;
    });
    document.getElementById('ap-act-reject-confirm')?.addEventListener('click', async () => {
      const reasonEl = document.getElementById('ap-reject-reason') as HTMLTextAreaElement | null;
      const reason = reasonEl?.value.trim() || '';
      if (!reason) {
        msg('A reason is required to reject.');
        return;
      }
      try {
        const res = await fetch(`/api/approvals/${item.id}/reject`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ reason }),
        });
        const body = (await res.json()) as { success: boolean; message?: string };
        if (body.success) {
          await refreshAfterAction(item.id);
        } else {
          msg(body.message || 'Could not reject.');
        }
      } catch {
        msg('Network error.');
      }
    });

    document.getElementById('ap-act-remind')?.addEventListener('click', async () => {
      const btn = document.getElementById('ap-act-remind') as HTMLButtonElement | null;
      if (!btn) return;
      btn.disabled = true;
      try {
        const res = await fetch(`/api/approvals/${item.id}/remind`, { method: 'POST' });
        const body = (await res.json()) as { success: boolean; message?: string };
        if (body.success) {
          msg('Reminder sent.', true);
        } else {
          msg(body.message || 'Could not send the reminder.');
          btn.disabled = false;
        }
      } catch {
        msg('Network error.');
        btn.disabled = false;
      }
    });

    const editForm = document.getElementById('ap-edit-form') as HTMLFormElement | null;
    document.getElementById('ap-act-edit')?.addEventListener('click', () => {
      if (editForm) editForm.hidden = !editForm.hidden;
    });
    document.getElementById('ap-edit-cancel')?.addEventListener('click', () => {
      if (editForm) editForm.hidden = true;
    });
    editForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const form = new FormData();
      form.append('title', (document.getElementById('ap-edit-title') as HTMLInputElement).value.trim());
      form.append('payee', (document.getElementById('ap-edit-payee') as HTMLInputElement).value.trim());
      form.append('requestedAmount', (document.getElementById('ap-edit-amount') as HTMLInputElement).value.trim());
      form.append('description', (document.getElementById('ap-edit-description') as HTMLTextAreaElement).value.trim());
      const filesInput = document.getElementById('ap-edit-files') as HTMLInputElement | null;
      for (const file of Array.from(filesInput?.files || [])) form.append('files', file);
      const resubmit = document.getElementById('ap-edit-resubmit') as HTMLInputElement | null;
      if (resubmit?.checked) form.append('resubmit', 'true');
      try {
        const res = await fetch(`/api/approvals/${item.id}/edit`, { method: 'POST', body: form });
        const body = (await res.json()) as { success: boolean; message?: string };
        if (body.success) {
          await refreshAfterAction(item.id);
        } else {
          msg(body.message || 'Could not save the edit.');
        }
      } catch {
        msg('Network error.');
      }
    });
  }

  function closeDrawer(): void {
    const overlay = document.getElementById('ap-drawer-overlay');
    if (overlay) overlay.setAttribute('hidden', '');
    document.body.style.overflow = '';
  }

  document.getElementById('ap-drawer-close')?.addEventListener('click', closeDrawer);
  document.getElementById('ap-drawer-overlay')?.addEventListener('click', (event) => {
    if (event.target === document.getElementById('ap-drawer-overlay')) closeDrawer();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeDrawer();
  });

  // ---- Create form ------------------------------------------------------

  const categorySelect = document.getElementById('ap-category') as HTMLSelectElement | null;
  const approvalCheck = document.getElementById('ap-approval-required') as HTMLInputElement | null;
  const fileInput = document.getElementById('ap-files') as HTMLInputElement | null;
  const comparisonToggleWrap = document.getElementById('ap-comparison-toggle-wrap');
  const comparisonToggle = document.getElementById('ap-comparison-toggle') as HTMLInputElement | null;
  const comparisonRows = document.getElementById('ap-comparison-rows');
  const comparisonBuilder = document.getElementById('ap-comparison-builder');

  // ---- Chosen-files list ------------------------------------------------
  // The native file picker replaces its selection on every visit, which
  // forces users to grab everything in one go. Instead, every pick is
  // APPENDED to this list (dupes and cap breaches rejected inline) and the
  // input is cleared so the same file can be re-picked deliberately.
  const MAX_FILES = 10; // must match APPROVAL_MAX_FILES_PER_ITEM (portal.ts)
  const MAX_FILE_BYTES = 10 * 1024 * 1024; // must match APPROVAL_MAX_FILE_BYTES
  let chosenFiles: File[] = [];
  // Typed comparison text and tick states survive file list changes,
  // keyed by name|size so adding or removing a file keeps the others' text.
  const comparisonDraft = new Map<string, { include: boolean; desc: string }>();

  function keyOf(file: File): string {
    return `${file.name}|${file.size}`;
  }

  function showFilesMsg(text: string): void {
    const el = document.getElementById('ap-files-msg');
    if (!el) return;
    el.textContent = text;
    el.hidden = !text;
  }

  function renderFilesList(): void {
    const list = document.getElementById('ap-files-list');
    if (!list) return;
    if (chosenFiles.length === 0) {
      list.innerHTML = '';
      return;
    }
    list.innerHTML =
      chosenFiles
        .map(
          (file, index) => `<div class="ap-file-row">
            <span class="ap-comp-name">${esc(file.name)} (${esc(fmtSize(file.size))})</span>
            <button type="button" class="ap-file-remove" data-index="${index}" aria-label="Remove ${esc(file.name)}">Remove</button>
          </div>`,
        )
        .join('') +
      `<p style="margin:0.25rem 0 0;color:var(--text-muted);font-size:0.78rem;">${chosenFiles.length} of ${MAX_FILES} files</p>`;
    list.querySelectorAll<HTMLButtonElement>('.ap-file-remove').forEach((btn) => {
      btn.addEventListener('click', () => {
        const index = Number(btn.dataset.index);
        const [removed] = chosenFiles.splice(index, 1);
        if (removed) comparisonDraft.delete(keyOf(removed));
        showFilesMsg('');
        renderFilesList();
        renderComparisonBuilder();
      });
    });
  }

  fileInput?.addEventListener('change', () => {
    if (!fileInput) return;
    const picked = Array.from(fileInput.files || []);
    fileInput.value = '';
    for (const file of picked) {
      if (chosenFiles.some((f) => keyOf(f) === keyOf(file))) {
        showFilesMsg(`"${file.name}" is already in the list.`);
        continue;
      }
      if (file.size > MAX_FILE_BYTES) {
        showFilesMsg(`"${file.name}" is larger than 10 MB and was not added.`);
        continue;
      }
      if (chosenFiles.length >= MAX_FILES) {
        showFilesMsg(`At most ${MAX_FILES} files per item.`);
        break;
      }
      chosenFiles.push(file);
    }
    renderFilesList();
    renderComparisonBuilder();
  });

  function syncApprovalDefault(): void {
    if (!categorySelect || !approvalCheck) return;
    const option = categorySelect.selectedOptions[0];
    approvalCheck.checked = option?.dataset.requiresApproval !== 'false';
  }

  categorySelect?.addEventListener('change', syncApprovalDefault);

  function renderComparisonBuilder(): void {
    if (!comparisonRows || !comparisonBuilder || !comparisonToggleWrap || !comparisonToggle) return;
    if (chosenFiles.length === 0) {
      // No files: hide everything comparison-related and clear the toggle.
      comparisonToggleWrap.hidden = true;
      comparisonToggle.checked = false;
      comparisonBuilder.hidden = true;
      comparisonRows.innerHTML = '';
      return;
    }
    comparisonToggleWrap.hidden = false;
    if (!comparisonToggle.checked) {
      comparisonBuilder.hidden = true;
      comparisonRows.innerHTML = '';
      return;
    }
    comparisonBuilder.hidden = false;
    comparisonRows.innerHTML = chosenFiles
      .map((file, index) => {
        const draft = comparisonDraft.get(keyOf(file));
        const include = draft ? draft.include : true;
        const desc = draft ? draft.desc : '';
        return `<div class="ap-comp-row">
          <input type="checkbox" id="ap-comp-include-${index}" data-key="${esc(keyOf(file))}" ${include ? 'checked' : ''} />
          <label for="ap-comp-include-${index}" class="ap-comp-name">${esc(file.name)} (${esc(fmtSize(file.size))})</label>
          <input type="text" class="form-input" data-desc="${index}" data-key="${esc(keyOf(file))}" style="flex:1;min-width:200px;" maxlength="500" value="${esc(desc)}" placeholder="e.g. Grand Copthorne — S$1,350/table, 25 tables" />
        </div>`;
      })
      .join('');

    // Persist edits into the drafts so the next re-render (a file added or
    // removed) restores what was typed.
    comparisonRows.querySelectorAll<HTMLInputElement>('input[type="checkbox"]').forEach((box) => {
      box.addEventListener('change', () => {
        const key = box.dataset.key || '';
        const draft = comparisonDraft.get(key) || { include: true, desc: '' };
        draft.include = box.checked;
        comparisonDraft.set(key, draft);
      });
    });
    comparisonRows.querySelectorAll<HTMLInputElement>('input[data-desc]').forEach((inp) => {
      inp.addEventListener('input', () => {
        const key = inp.dataset.key || '';
        const draft = comparisonDraft.get(key) || { include: true, desc: '' };
        draft.desc = inp.value;
        comparisonDraft.set(key, draft);
      });
    });
  }

  comparisonToggle?.addEventListener('change', renderComparisonBuilder);

  document.getElementById('ap-create-form')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const msg = document.getElementById('ap-create-msg');
    const submit = document.getElementById('ap-create-submit') as HTMLButtonElement | null;
    if (!msg || !submit) return;
    msg.textContent = '';
    msg.style.color = 'var(--text-muted)';

    const form = new FormData();
    if (categorySelect) form.append('category', categorySelect.value);
    form.append('title', (document.getElementById('ap-title') as HTMLInputElement).value.trim());
    form.append('payee', (document.getElementById('ap-payee') as HTMLInputElement).value.trim());
    form.append('requestedAmount', (document.getElementById('ap-amount') as HTMLInputElement).value.trim());
    const descriptionEl = document.getElementById('ap-description') as HTMLTextAreaElement | null;
    if (descriptionEl) form.append('description', descriptionEl.value.trim());
    if (approvalCheck) form.append('approvalRequired', approvalCheck.checked ? 'true' : 'false');

    for (const file of chosenFiles) form.append('files', file);

    const comparison: Array<{ file: string; description: string }> = [];
    if (comparisonToggle?.checked) {
      comparisonRows?.querySelectorAll<HTMLInputElement>('input[type="checkbox"]').forEach((box) => {
        if (!box.checked) return;
        const key = box.dataset.key || '';
        const file = chosenFiles.find((f) => keyOf(f) === key);
        if (!file) return;
        const row = box.closest('.ap-comp-row');
        const desc = row?.querySelector<HTMLInputElement>('input[data-desc]')?.value.trim() || '';
        if (desc) comparison.push({ file: file.name, description: desc });
      });
    }
    if (comparison.length > 0) form.append('comparison', JSON.stringify(comparison));

    submit.disabled = true;
    try {
      const res = await fetch('/api/approvals', { method: 'POST', body: form });
      const body = (await res.json()) as { success: boolean; message?: string };
      if (res.ok && body.success) {
        msg.style.color = '#1b7f3b';
        msg.textContent = 'Request raised.';
        (document.getElementById('ap-create-form') as HTMLFormElement).reset();
        chosenFiles = [];
        comparisonDraft.clear();
        showFilesMsg('');
        renderFilesList();
        renderComparisonBuilder();
        syncApprovalDefault();
        await loadList();
      } else {
        msg.style.color = '#b3261e';
        msg.textContent = body.message || 'Could not raise the request.';
      }
    } catch {
      msg.style.color = '#b3261e';
      msg.textContent = 'Network error. Please try again.';
    } finally {
      submit.disabled = false;
    }
  });

  // ---- Boot -------------------------------------------------------------

  requireAuth({
    onAuthenticated(data: SessionResponse) {
      sessionData = data;
      const createCard = document.getElementById('ap-create-card');
      if (createCard) createCard.style.display = data.is_admin ? '' : 'none';
      syncApprovalDefault();
      void loadList().then(() => {
        // Deep link from approval emails: /approvals?item=<id>
        const deep = new URLSearchParams(window.location.search).get('item');
        if (deep && /^\d+$/.test(deep)) {
          const exists = allItems.some((i) => i.id === Number(deep)) || counts.all > 0;
          if (exists) void openDrawer(Number(deep));
        }
      });
    },
  });
</script>
