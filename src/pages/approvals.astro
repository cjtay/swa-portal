---
import AdminLayout from '../layouts/AdminLayout.astro';
import { APPROVAL_CATEGORIES } from '../constants/portal';
---

<AdminLayout title="Approvals | SWA Admin Portal" currentPath="/approvals">
  <h1>Approvals</h1>
  <p style="color:var(--text-muted);margin-bottom:1rem;">
    Purchase and payment approvals. The office admin raises a request with its documents;
    purchase approvers decide first, then the finance pair checks the payment voucher.
  </p>

  <div class="ap-guide-banner">
    <div class="ap-guide-banner-text">
      <strong>New to approvals?</strong>
      <span>The user guide walks through every step with screenshots, one topic at a time.</span>
    </div>
    <a class="btn btn-secondary" href="/approvals/guide">Open the user guide</a>
  </div>

  <!-- Status tabs with counts (plan §11) -->
  <div class="ap-tabs" id="ap-tabs" role="tablist" aria-label="Approval status">
    <button type="button" class="ap-tab" data-status="pending" role="tab" aria-selected="false">For approval <span class="ap-tab-count" data-count="pending">0</span></button>
    <button type="button" class="ap-tab" data-status="purchase_approved" role="tab" aria-selected="false">Approved <span class="ap-tab-count" data-count="purchase_approved">0</span></button>
    <button type="button" class="ap-tab" data-status="finance_check" role="tab" aria-selected="false">In finance check <span class="ap-tab-count" data-count="finance_check">0</span></button>
    <button type="button" class="ap-tab" data-status="finance_approved" role="tab" aria-selected="false">Finance approved <span class="ap-tab-count" data-count="finance_approved">0</span></button>
    <button type="button" class="ap-tab" data-status="rejected" role="tab" aria-selected="false">Rejected <span class="ap-tab-count" data-count="rejected">0</span></button>
    <button type="button" class="ap-tab" data-status="paid" role="tab" aria-selected="false">Paid <span class="ap-tab-count" data-count="paid">0</span></button>
    <button type="button" class="ap-tab active" data-status="all" role="tab" aria-selected="true">All <span class="ap-tab-count" data-count="all">0</span></button>
  </div>

  <!-- New request toggle (office admin only; hidden until the session confirms).
       The table leads the page; the form opens on demand. -->
  <div id="ap-create-bar" style="margin-bottom:1.5rem;display:none;align-items:center;gap:0.75rem;flex-wrap:wrap;">
    <button type="button" class="btn btn-primary" id="ap-create-open">New request</button>
    <span id="ap-create-bar-msg" style="font-size:0.85rem;color:#1b7f3b;"></span>
  </div>

  <!-- New request form (office admin only; opens via the button above) -->
  <div class="card" id="ap-create-card" style="margin-bottom:1.5rem;display:none;">
    <h2 style="font-size:1.1rem;margin-top:0;">New request</h2>
    <form id="ap-create-form" enctype="multipart/form-data">
      <div class="ap-form-grid">
        <label class="ap-field">
          <span>Category</span>
          <select id="ap-category" class="form-input" required>
            {APPROVAL_CATEGORIES.map((cat) => (
              <option value={cat.key} data-requires-approval={cat.requiresApproval ? 'true' : 'false'}>{cat.label}</option>
            ))}
          </select>
        </label>
        <label class="ap-field">
          <span>Title</span>
          <input type="text" id="ap-title" class="form-input" maxlength="300" placeholder="e.g. 49th SWA Charity Gala Dinner 2026" required />
        </label>
        <label class="ap-field">
          <span>Payable to</span>
          <input type="text" id="ap-payee" class="form-input" maxlength="300" placeholder="Vendor or payee name" />
        </label>
        <label class="ap-field">
          <span>Requested amount (S$, before GST, optional)</span>
          <input type="number" id="ap-amount" class="form-input" min="0.01" max="10000000" step="0.01" inputmode="decimal" placeholder="e.g. 1250.00" />
        </label>
      </div>

      <label class="ap-field" style="display:block;margin-top:0.75rem;">
        <span>Description / justification (optional, shown to approvers)</span>
        <textarea id="ap-description" class="form-input" rows="4" maxlength="4000" placeholder="Why this purchase is needed, context for approvers, breakdown of the amount…"></textarea>
      </label>

      <label class="ap-check">
        <input type="checkbox" id="ap-approval-required" checked />
        <span>Approval required (purchase approvers decide before the voucher)</span>
      </label>

      <label class="ap-field" style="display:block;margin-top:0.75rem;">
        <span>Documents: add one at a time or several at once (PDF or photos, up to 10 files, 10 MB each). At least one document is required when approval is required.</span>
        <input type="file" id="ap-files" class="form-input" multiple accept="application/pdf,image/jpeg,image/png,image/webp,image/heic,image/heif" />
      </label>
      <div id="ap-files-list" aria-live="polite"></div>
      <p id="ap-files-msg" role="status" aria-live="polite" style="margin:0.25rem 0 0;font-size:0.8rem;color:#b3261e;" hidden></p>

      <!-- Comparison opt-in: appears only when files are chosen. A single
           quotation may span several uploads (PDF + photos of the same
           quote), so the comparison rows require an explicit tick. -->
      <label class="ap-check" id="ap-comparison-toggle-wrap" hidden>
        <input type="checkbox" id="ap-comparison-toggle" />
        <span>I have multiple quotations to compare</span>
      </label>

      <!-- Comparison builder: one row per chosen file (plan §6) -->
      <div id="ap-comparison-builder" hidden>
        <p style="margin:0.75rem 0 0.25rem;font-weight:600;">Comparison table</p>
        <p style="margin:0 0 0.5rem;color:var(--text-muted);font-size:0.85rem;">
          Tick the quotations you want in the comparison and describe each one.
          Each row links to that document for the finance check.
        </p>
        <div id="ap-comparison-rows"></div>
      </div>

      <!-- AI analysis (docs/plans/AI-Quotation-Comparison-Plan.md §4.6): the
           button only spends AI quota on an explicit click; the stored
           analysis is replayed with the form on submit. -->
      <div id="ap-ai-box" hidden style="margin-top:1rem;">
        <div style="display:flex;align-items:center;gap:0.75rem;flex-wrap:wrap;">
          <button type="button" class="btn btn-secondary" id="ap-ai-run">Analyse with AI</button>
          <span id="ap-ai-msg" role="status" aria-live="polite" style="font-size:0.85rem;color:var(--text-muted);"></span>
        </div>
        <div id="ap-ai-preview" class="ap-ai-preview" hidden></div>
      </div>

      <!-- Compliance declarations (plan §7.4): shown live by the typed
           amount — S$1,000 and above. The server re-validates everything;
           this conditional UI is help, not the enforcement. -->
      <div id="ap-compliance-box" style="margin-top:1rem;display:none;border:1px solid var(--swa-3);background:#faf7fc;padding:0.9rem 1rem;border-radius:0.5rem;">
        <p style="margin:0 0 0.6rem;font-weight:600;color:var(--swa-2);">Declarations (S$1,000 and above)</p>
        <label class="ap-check"><input type="checkbox" id="ap-budget-approved" /><span>Payment is within the approved budget</span></label>
        <div class="ap-form-grid" style="margin-top:0.6rem;">
          <label class="ap-field"><span>Budget amount</span>
            <input type="text" id="ap-budget-amount" class="form-input" maxlength="50" placeholder="e.g. S$12,000" /></label>
          <label class="ap-field"><span>Budget approving officer</span>
            <input type="text" id="ap-budget-officer" class="form-input" maxlength="200" placeholder="Officer who approved the budget" /></label>
          <label class="ap-field"><span>Budget approval date</span>
            <input type="date" id="ap-budget-date" class="form-input" /></label>
          <label class="ap-field"><span>Is the chosen supplier the cheapest of the quotations?</span>
            <select id="ap-supplier-cheapest" class="form-input">
              <option value="">— Answer —</option>
              <option value="yes">Yes</option>
              <option value="no">No</option>
            </select></label>
        </div>
        <label class="ap-field" style="display:block;margin-top:0.6rem;" id="ap-supplier-reason-wrap" hidden>
          <span>Reason for not choosing the cheapest (required)</span>
          <textarea id="ap-supplier-reason" class="form-input" rows="2" maxlength="1000"></textarea>
        </label>
        <label class="ap-field" style="display:block;margin-top:0.6rem;" id="ap-waiver-wrap" hidden>
          <span>Why fewer than two quotations are attached (required unless two are in the comparison table)</span>
          <textarea id="ap-waiver-reason" class="form-input" rows="2" maxlength="1000"></textarea>
        </label>
        <label class="ap-check" style="margin-top:0.6rem;"><input type="checkbox" id="ap-coi-declared" /><span>No conflict of interest in this purchase</span></label>
        <label class="ap-check" style="margin-top:0.4rem;"><input type="checkbox" id="ap-no-split-declared" /><span>The purchase is not split to stay under an approval limit</span></label>
        <p id="ap-invitation-reminder" class="ap-reminder" style="display:none;">S$6,000 and above: obtain two written invitations to quote and attach them.</p>
        <p id="ap-tender-reminder" class="ap-reminder" style="display:none;">Above S$90,000: a formal tender is required. Attach the tender documents.</p>
        <div id="ap-board-box" style="display:none;margin-top:0.75rem;border-top:1px solid var(--swa-3);padding-top:0.6rem;">
          <p style="margin:0 0 0.4rem;font-weight:600;color:var(--swa-2);">Board approval (S$10,000 and above)</p>
          <label class="ap-field"><span>Board approval reference</span>
            <input type="text" id="ap-board-ref" class="form-input" maxlength="500" placeholder="e.g. Board meeting 12 Aug 2026, item 4" /></label>
          <p style="margin:0.35rem 0 0;font-size:0.8rem;color:var(--text-muted);">Attach the board minutes or the approval email PDF with the documents above.</p>
        </div>
      </div>

      <div style="display:flex;align-items:center;gap:0.75rem;margin-top:1rem;flex-wrap:wrap;">
        <button type="submit" class="btn btn-primary" id="ap-create-submit">Raise request</button>
        <button type="button" class="btn btn-secondary" id="ap-create-cancel">Cancel</button>
        <span id="ap-create-msg" role="status" aria-live="polite" style="font-size:0.85rem;color:var(--text-muted);"></span>
      </div>
    </form>
  </div>

  <!-- Board table. Headers sort in the browser (owner decision 25-08-2026):
       click once to sort, again to reverse. Empty values always sink to the
       bottom regardless of direction. -->
  <div class="card">
    <div class="table-scroll">
      <table class="data-table" id="ap-board-table">
        <thead>
          <tr>
            <th scope="col" class="ap-sortable" data-sort="voucher_no">Voucher No</th>
            <th scope="col" class="ap-sortable" data-sort="voucher_date">Date</th>
            <th scope="col" class="ap-sortable" data-sort="title">Title</th>
            <th scope="col" class="ap-sortable" data-sort="payee">Payee</th>
            <th scope="col" class="ap-sortable" data-sort="category">Category</th>
            <th scope="col" class="ap-sortable" data-sort="requested_amount">Amount</th>
            <th scope="col" class="ap-sortable" data-sort="status">Status</th>
            <th scope="col" class="ap-sortable" data-sort="created_at">Created (SG)</th>
            <th scope="col"><span style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);">Actions</span></th>
          </tr>
        </thead>
        <tbody id="ap-list"></tbody>
      </table>
    </div>
    <div id="ap-pagination"></div>
  </div>

  <!-- Detail drawer -->
  <div class="drawer-overlay" id="ap-drawer-overlay" hidden>
    <aside class="drawer" id="ap-drawer" role="dialog" aria-modal="true" aria-labelledby="ap-drawer-title">
      <header class="drawer-header">
        <h2 id="ap-drawer-title">Approval item</h2>
        <button type="button" class="drawer-close" id="ap-drawer-close" aria-label="Close">&times;</button>
      </header>
      <div class="drawer-body" id="ap-drawer-body"></div>
    </aside>
  </div>
</AdminLayout>

<style is:global>
  .admin-main { max-width: 1600px; }

  .ap-tabs { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 1rem; }
  .ap-guide-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    background: #faf5fd;
    border: 1px solid var(--swa-4, #f3d2ff);
    border-radius: 10px;
    padding: 0.9rem 1.1rem;
    margin-bottom: 1.25rem;
  }
  .ap-guide-banner-text { display: flex; flex-direction: column; gap: 0.15rem; }
  .ap-guide-banner-text strong { color: var(--swa-2, #450a5e); }
  .ap-guide-banner-text span { color: var(--text-muted); font-size: 0.9rem; }
  .ap-guide-banner .btn { white-space: nowrap; min-height: 44px; }
  .ap-tab {
    padding: 0.5rem 1rem;
    border: 1px solid var(--border);
    background: var(--bg);
    color: #4b5563;
    border-radius: 9999px;
    cursor: pointer;
    font-size: 0.9rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .ap-tab:hover { border-color: var(--swa-3); color: var(--swa-2); }
  .ap-tab.active { background: var(--swa-1); border-color: var(--swa-1); color: #fff; }
  .ap-tab:focus-visible,
  .ap-page-btn:focus-visible,
  .row-view-btn:focus-visible,
  .drawer-close:focus-visible,
  .ap-file-remove:focus-visible,
  #ap-create-card input[type="checkbox"]:focus-visible,
  #ap-drawer input[type="checkbox"]:focus-visible {
    outline: 2px solid var(--swa-3);
    outline-offset: 2px;
  }
  .ap-tab-count {
    background: var(--swa-4);
    color: var(--swa-2);
    border-radius: 9999px;
    padding: 0 0.5rem;
    font-size: 0.8rem;
    font-weight: 600;
    min-width: 1.3rem;
    text-align: center;
  }
  .ap-tab.active .ap-tab-count { background: rgba(255, 255, 255, 0.25); color: #fff; }

  /* Scrolling-shadow hint (Lea Verou technique): the two "local" white
     layers travel with the content and hide their edge shadow only once
     that side is fully scrolled, telling readers more columns exist.
     contain:paint stops the wide table's sideways overflow leaking to the
     page itself — without it the browser lets the whole page pan right,
     revealing a band of empty space beside the table (measured 633px on a
     375px phone). */
  .table-scroll {
    overflow-x: auto;
    contain: paint;
    border: 1px solid var(--border);
    border-radius: 0.4rem;
    background:
      linear-gradient(to right, var(--bg-card), rgba(255, 255, 255, 0)) left / 3rem 100% no-repeat local,
      linear-gradient(to left, var(--bg-card), rgba(255, 255, 255, 0)) right / 3rem 100% no-repeat local,
      radial-gradient(farthest-side at 0 50%, rgba(0, 0, 0, 0.22), transparent) left / 1.5rem 100% no-repeat scroll,
      radial-gradient(farthest-side at 100% 50%, rgba(0, 0, 0, 0.22), transparent) right / 1.5rem 100% no-repeat scroll;
  }

  /* Senior-friendly size floor: the board table is the main reading
     surface, so body cells and headers stay above 14px/12.5px even though
     the shared .data-table rules are smaller. Horizontal cell padding is
     trimmed to 0.75rem so the bigger text still fits without sideways
     scrolling on a 1200px desktop window. */
  #ap-board-table { font-size: 0.95rem; }
  #ap-board-table th { font-size: 0.8rem; padding: 0.75rem; }
  #ap-board-table td { padding: 0.65rem 0.75rem; }

  .ap-form-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }
  .ap-field { display: flex; flex-direction: column; gap: 0.3rem; font-size: 0.9rem; }
  /* Field labels use the same caption family as the detail list above
     (12px, grey, weight 600) so a label can never be mistaken for the
     value typed beside it. Sentence case, because several of these labels
     carry full instructions that would shout in uppercase. */
  .ap-field > span {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
    letter-spacing: 0.02em;
  }
  .ap-check { display: flex; align-items: center; gap: 0.5rem; font-size: 0.9rem; }
  /* display:flex would override the hidden attribute (same class of bug as
     the 2026-07-05 drawer fix) — restore it explicitly. */
  .ap-check[hidden] { display: none; }

  /* Compliance reminders (S$6k invitations / S$90k tender) — amber notes. */
  .ap-reminder {
    margin: 0.6rem 0 0;
    font-size: 0.85rem;
    color: #7a5c00;
    background: #fff7e6;
    border-left: 3px solid #b45309;
    padding: 0.45rem 0.6rem;
    border-radius: 0 0.3rem 0.3rem 0;
  }

  /* Tax Invoice chip on a drawer attachment (R7). */
  .ap-tax-chip {
    display: inline-block;
    background: var(--swa-4);
    color: var(--swa-2);
    border-radius: 9999px;
    padding: 0.1rem 0.55rem;
    font-size: 0.72rem;
    font-weight: 600;
    white-space: nowrap;
  }

  /* Amber staleness chip beside a quotation date older than 12 months
     (plan §7.2 — warn, never block). */
  .ap-quote-stale {
    display: inline-block;
    background: #fff7e6;
    color: #7a5c00;
    border-left: 3px solid #b45309;
    border-radius: 0 0.25rem 0.25rem 0;
    padding: 0.1rem 0.45rem;
    font-size: 0.72rem;
    font-weight: 600;
    white-space: normal;
  }

  /* Brand-coloured checkboxes and file pickers (approvals page only).
     Checkboxes are 20px: 16px is hard to tick accurately for older users.
     Inputs are 1rem because Safari on iPhone auto-zooms the page whenever
     a focusable field renders below 16px. */
  #ap-create-card input[type="checkbox"],
  #ap-drawer input[type="checkbox"] {
    accent-color: var(--swa-1);
    width: 1.25rem;
    height: 1.25rem;
    /* flex-shrink:0 — without it the long checkbox labels squeeze the box
       narrower than its set width (measured 13px against a 20px height). */
    flex-shrink: 0;
  }
  #ap-create-card .form-input,
  #ap-drawer .form-input {
    font-size: 1rem;
  }
  #ap-create-card .form-input:focus,
  #ap-drawer .form-input:focus {
    box-shadow: 0 0 0 3px rgba(135, 75, 161, 0.35);
  }
  #ap-create-card input[type="file"].form-input,
  #ap-drawer input[type="file"].form-input {
    padding: 0.45rem 0.6rem;
    font-size: 0.9rem;
    color: var(--text-muted);
  }
  #ap-create-card input[type="file"]::file-selector-button,
  #ap-drawer input[type="file"]::file-selector-button {
    margin-right: 0.75rem;
    padding: 0.55rem 1.1rem;
    border: 1px solid var(--swa-3);
    border-radius: 0.375rem;
    background: var(--bg);
    color: var(--swa-2);
    font-family: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
  }
  #ap-create-card input[type="file"]::file-selector-button:hover,
  #ap-drawer input[type="file"]::file-selector-button:hover {
    background: var(--swa-4);
  }

  /* Action and form messages become visible banners once they have text.
     The script sets the text colour inline (red for errors, green for
     success); the tint below follows that colour automatically. */
  #ap-act-msg:not(:empty),
  #ap-create-msg:not(:empty) {
    flex-basis: 100%;
    padding: 0.5rem 0.75rem;
    border-left: 3px solid currentColor;
    border-radius: 0 0.3rem 0.3rem 0;
    background: color-mix(in srgb, currentColor 8%, transparent);
    font-weight: 500;
  }
  #ap-files-msg:not([hidden]) {
    padding: 0.45rem 0.75rem;
    border-left: 3px solid currentColor;
    border-radius: 0 0.3rem 0.3rem 0;
    background: color-mix(in srgb, currentColor 8%, transparent);
    font-weight: 500;
  }

  .ap-actions { display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap; }
  /* Every button inside the two forms (New request card + drawer) matches
     the drawer action buttons: 42px tall, 14.4px text. */
  #ap-create-card .btn,
  #ap-drawer .btn {
    font-size: 0.9rem;
    min-height: 2.6rem;
  }
  .ap-actions a.btn { text-decoration: none; display: inline-flex; align-items: center; }
  #ap-reject-box, #ap-finance-reject-box, #ap-edit-form, #ap-voucher-form, #ap-paid-form {
    border: 1px solid var(--border);
    border-radius: 0.4rem;
    padding: 0.75rem;
    background: #fafafa;
    margin-top: 0.75rem;
  }

  .ap-vline-row {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0;
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
  }
  .ap-vline-row:last-child { border-bottom: none; }

  .ap-comp-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0;
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
  }
  .ap-comp-row:last-child { border-bottom: none; }
  .ap-comp-name { font-size: 0.9rem; min-width: 180px; word-break: break-all; }

  .ap-file-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.35rem 0;
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
  }
  .ap-file-row:last-of-type { border-bottom: none; }
  .ap-file-row .ap-comp-name { min-width: 0; flex: 1; }
  .ap-file-remove {
    padding: 0.45rem 0.9rem;
    min-height: 2.25rem;
    font-size: 0.85rem;
    border: 1px solid var(--border);
    background: var(--bg);
    color: #b3261e;
    border-radius: 0.3rem;
    cursor: pointer;
  }
  .ap-file-remove:hover { border-color: #b3261e; }

  .ap-chip {
    display: inline-block;
    padding: 0.2rem 0.65rem;
    border-radius: 9999px;
    font-size: 0.85rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .ap-chip-pending { background: #fff3d6; color: #7a5c00; }
  .ap-chip-purchase_approved { background: #e8f5e9; color: #1b7f3b; }
  .ap-chip-finance_check { background: #e8f0fe; color: #1a4fa0; }
  .ap-chip-finance_approved { background: #dff2e6; color: #0d6b3f; }
  .ap-chip-rejected { background: #fdecea; color: #b3261e; }
  .ap-chip-paid { background: #eceff1; color: #37474f; }

  .row-view-btn {
    padding: 0.5rem 1rem;
    min-height: 2.5rem;
    font-size: 0.9rem;
    border: 1px solid var(--swa-3);
    background: var(--bg);
    color: var(--swa-2);
    border-radius: 0.3rem;
    cursor: pointer;
  }
  .row-view-btn:hover { background: #f5f0f8; }

  /* Sortable headers (board table). The arrow is CSS content so the thead
     never needs re-rendering; the active class is swapped by renderSortHeads. */
  #ap-board-table th.ap-sortable {
    cursor: pointer;
    user-select: none;
    white-space: nowrap;
  }
  #ap-board-table th.ap-sortable:hover { color: var(--swa-2); }
  #ap-board-table th.ap-sort-asc::after { content: ' \2191'; }
  #ap-board-table th.ap-sort-desc::after { content: ' \2193'; }
  #ap-board-table th.ap-sort-asc,
  #ap-board-table th.ap-sort-desc { color: var(--swa-2); }

  /* Column polish: amounts right-aligned with tabular figures so digits
     line up; identifiers and dates stay on one line instead of wrapping. */
  #ap-board-table th:nth-child(6),
  #ap-board-table td:nth-child(6) {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  #ap-board-table td:nth-child(1),
  #ap-board-table td:nth-child(2),
  #ap-board-table td:nth-child(7),
  #ap-board-table td:nth-child(8) {
    white-space: nowrap;
  }

  /* Pagination bar under the board table (browser-side, 20 rows per page). */
  .ap-pagination {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 0.75rem;
  }
  .ap-pagination:empty { display: none; }
  .ap-page-info { font-size: 0.85rem; color: #4b5563; }
  .ap-page-btns { display: flex; gap: 0.3rem; align-items: center; flex-wrap: wrap; }
  .ap-page-btn {
    padding: 0.45rem 0.85rem;
    min-width: 2.5rem;
    min-height: 2.5rem;
    font-size: 0.9rem;
    border: 1px solid var(--border);
    background: var(--bg);
    color: #4b5563;
    border-radius: 0.3rem;
    cursor: pointer;
  }
  .ap-page-btn:hover:not(:disabled) { border-color: var(--swa-3); color: var(--swa-2); }
  .ap-page-btn.active { background: var(--swa-1); border-color: var(--swa-1); color: #fff; }
  .ap-page-btn:disabled { opacity: 0.5; cursor: default; }
  .ap-page-ellipsis { padding: 0 0.15rem; color: var(--text-muted); font-size: 0.85rem; }

  .drawer-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    z-index: 50;
    display: flex;
    justify-content: flex-end;
  }
  .drawer-overlay[hidden] { display: none; }
  .drawer {
    width: min(760px, 100%);
    background: var(--bg);
    height: 100%;
    overflow-y: auto;
    box-shadow: -10px 0 30px -10px rgba(0, 0, 0, 0.3);
    display: flex;
    flex-direction: column;
  }
  .drawer-header {
    position: sticky;
    top: 0;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    padding: 1rem 1.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 2;
  }
  .drawer-header h2 { margin: 0; font-size: 1.15rem; color: var(--swa-2); }
  .drawer-close {
    background: none;
    border: 1px solid var(--border);
    border-radius: 0.4rem;
    width: 2.5rem;
    height: 2.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
    color: #4b5563;
  }
  .drawer-close:hover { background: #f5f0f8; border-color: var(--swa-3); }
  .drawer-body { padding: 1.25rem; display: flex; flex-direction: column; gap: 1.25rem; }

  .ap-detail-grid {
    display: grid;
    /* Two columns at the 760px drawer width, so long values such as email
       addresses fit on one line instead of wrapping mid-word. */
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 0.9rem 1.25rem;
  }
  /* Label-vs-value hierarchy: the caption line is quiet small caps; the
     value is the biggest, darkest text in the pair; a hairline divider
     closes each pair so the list never reads as one wall of text. */
  .ap-detail-item {
    font-size: 0.95rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--border);
  }
  .ap-detail-item dt {
    color: var(--text-muted);
    margin: 0 0 0.2rem;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  /* overflow-wrap (not word-break) only splits a word when it truly cannot
     fit; long rows marked wide span both columns and never wrap. */
  .ap-detail-item dd { margin: 0; font-weight: 600; font-size: 1rem; overflow-wrap: break-word; }
  .ap-detail-item--wide { grid-column: 1 / -1; }

  .ap-note {
    border-left: 3px solid #b3261e;
    background: #fdecea;
    padding: 0.6rem 0.8rem;
    border-radius: 0 0.3rem 0.3rem 0;
    font-size: 0.9rem;
  }

  .ap-attachment {
    border: 1px solid var(--border);
    border-radius: 0.4rem;
    padding: 0.75rem;
    margin-bottom: 0.75rem;
  }
  .ap-attachment-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }
  .ap-attachment-name { font-size: 0.9rem; font-weight: 600; word-break: break-all; }
  .ap-attachment-actions { display: flex; gap: 0.5rem; align-items: center; }
  .ap-attachment-actions a {
    font-size: 0.9rem;
    padding: 0.3rem 0.25rem;
    color: var(--swa-2);
  }
  .ap-attachment-preview img { max-width: 100%; height: auto; border-radius: 0.3rem; }
  .ap-attachment-preview iframe { width: 100%; height: 560px; border: 1px solid var(--border); border-radius: 0.3rem; }

  /* Responsive-table pattern: display:block + overflow-x on the table lets
     a wide table (the AI comparison reaches ~560px on a 375px phone) pan
     within its own border box. Scrolling stays local to the table, so the
     summary text and nearby cards never slide away, and the drawer itself
     can no longer be dragged sideways leaving an empty band. */
  .ap-comparison-table {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 0.9rem;
  }
  .ap-comparison-table th, .ap-comparison-table td {
    border: 1px solid var(--border);
    padding: 0.4rem 0.6rem;
    text-align: left;
    vertical-align: top;
  }
  .ap-comparison-table th { background: #f5f0f8; color: var(--swa-2); }

  /* AI analysis preview + drawer block. The tinted border separates the
     AI-generated content from the human-typed comparison table above it. */
  .ap-ai-preview {
    margin-top: 0.75rem;
    border: 1px solid var(--swa-3);
    border-radius: 0.4rem;
    padding: 0.75rem;
    background: #faf7fc;
    font-size: 0.85rem;
  }
  .ap-ai-preview h4, .ap-ai-block h4 { margin: 0 0 0.4rem; font-size: 0.9rem; color: var(--swa-2); }
  .ap-ai-disclaimer {
    display: block;
    margin: 0.5rem 0 0;
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  .ap-ai-reco {
    margin: 0.6rem 0 0;
    padding: 0.45rem 0.6rem;
    background: var(--swa-4);
    border-radius: 0.3rem;
    font-weight: 600;
    color: var(--swa-2);
  }
  .ap-ai-meta { margin: 0.5rem 0 0; font-size: 0.8rem; color: var(--text-muted); }

  /* Rotating ring shown beside the working message while an AI analysis runs.
     Pure CSS — no image, no emoji, respects prefers-reduced-motion. */
  .ap-spinner {
    display: inline-block;
    width: 1.15em;
    height: 1.15em;
    vertical-align: -0.15em;
    margin-right: 0.45rem;
    border: 3px solid rgba(112, 48, 140, 0.25);
    border-top-color: var(--swa-1);
    border-radius: 50%;
    animation: ap-spin 0.7s linear infinite;
  }
  @keyframes ap-spin {
    to { transform: rotate(360deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .ap-spinner {
      animation: ap-pulse 1.2s ease-in-out infinite;
      border-color: var(--swa-1);
    }
    @keyframes ap-pulse {
      50% { opacity: 0.25; }
    }
  }
  .ap-ai-preview .ap-comparison-table td:nth-child(4),
  .ap-ai-preview .ap-comparison-table td:nth-child(5),
  .ap-ai-preview .ap-comparison-table th:nth-child(4),
  .ap-ai-preview .ap-comparison-table th:nth-child(5) {
    text-align: right;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  /* Voucher table in the drawer: keep No/Date/Amount on one line and line
     up the amount digits. */
  .ap-voucher .ap-comparison-table td { font-variant-numeric: tabular-nums; }
  .ap-voucher .ap-comparison-table th:nth-child(1),
  .ap-voucher .ap-comparison-table td:nth-child(1),
  .ap-voucher .ap-comparison-table th:nth-child(2),
  .ap-voucher .ap-comparison-table td:nth-child(2),
  .ap-voucher .ap-comparison-table th:nth-child(4),
  .ap-voucher .ap-comparison-table td:nth-child(4) {
    white-space: nowrap;
  }

  /* Phones: admin.css shrinks .data-table to 0.75rem below 768px; the ID
     selector here out-specifies it so the approvals board stays readable
     on the small screens older members actually use. */
  @media (max-width: 768px) {
    #ap-board-table { font-size: 0.9rem; }
    #ap-board-table th { font-size: 0.78rem; }
  }
</style>

<script>
  import { requireAuth, type SessionResponse } from '../scripts/auth-gate';
  import {
    APPROVAL_QUOTE_RULE_THRESHOLD,
    APPROVAL_INVITATION_REMINDER_THRESHOLD,
    APPROVAL_TENDER_REMINDER_THRESHOLD,
    APPROVAL_BOARD_APPROVAL_THRESHOLD,
  } from '../constants/portal';

  interface ApprovalItem {
    id: number;
    category: string;
    title: string;
    payee: string | null;
    description: string | null;
    requested_amount: number | null;
    approval_required: number;
    status: string;
    rejected_stage: string | null;
    purchase_decision_by: string | null;
    purchase_decision_at: string | null;
    purchase_decision_office: string | null;
    rejection_reason: string | null;
    finance_rejection_reason: string | null;
    voucher_no: string | null;
    voucher_date: string | null;
    voucher_lines: string | null;
    voucher_submitted_by: string | null;
    voucher_submitted_at: string | null;
    invoice_no: string | null;
    finance_decision_by: string | null;
    finance_decision_at: string | null;
    finance_decision_office: string | null;
    paid_by: string | null;
    paid_at: string | null;
    payment_method: string | null;
    payment_reference: string | null;
    created_by: string;
    board_approval_ref: string | null;
    quotation_waiver_reason: string | null;
    supplier_is_cheapest: number | null;
    supplier_choice_reason: string | null;
    budget_approved: number | null;
    budget_amount: string | null;
    budget_officer: string | null;
    budget_date: string | null;
    coi_declared: number | null;
    no_split_declared: number | null;
    created_at: string;
    updated_at: string;
    comparison?: Array<{ attachmentId: number; description: string; quoteDate?: string }> | null;
    ai_comparison?: AiAnalysis | null;
  }

  interface VoucherLine {
    no: number | null;
    date: string | null;
    description: string;
    amount: number | null;
  }

  interface ApprovalAttachment {
    id: number;
    filename: string;
    mime_type: string;
    size: number;
    is_tax_invoice: number;
    created_at: string;
  }

  // AI quotation comparison (docs/plans/AI-Quotation-Comparison-Plan.md).
  // Shape mirrors AiComparison in src/worker/lib/ai-comparison.ts.
  interface AiQuote {
    filename: string;
    vendor: string | null;
    itemName: string | null;
    description: string | null;
    unitPrice: number | null;
    totalPrice: number | null;
    currency: string | null;
    gst: string | null;
    validity: string | null;
    leadTime: string | null;
    unitPriceSgd: number | null;
    totalPriceSgd: number | null;
  }

  interface AiAnalysis {
    version: 1;
    generatedAt: string;
    generatedBy: string;
    models: { extract: string; compare: string };
    fx: { date: string; source: string } | null;
    files: Array<{ filename: string; status: 'ok' | 'skipped' | 'error'; note: string | null }>;
    quotes: AiQuote[];
    summary: string | null;
    recommendation: string | null;
  }

  const STATUS_LABELS: Record<string, string> = {
    pending: 'For approval',
    purchase_approved: 'Approved',
    finance_check: 'In finance check',
    finance_approved: 'Finance approved',
    rejected: 'Rejected',
    paid: 'Paid',
  };

  const PAYMENT_METHOD_LABELS: Record<string, string> = {
    paynow: 'PayNow',
    bank_transfer: 'Bank transfer',
    giro: 'GIRO',
    cash: 'Cash',
    other: 'Other',
  };

  // Category labels are read from the <select> options rather than an inline
  // JSON tag: Astro treats content inside <script> tags as raw text, so an
  // {expression} there ships unevaluated and breaks JSON.parse.
  const CATEGORY_LABELS: Record<string, string> = (() => {
    const out: Record<string, string> = {};
    document.querySelectorAll<HTMLSelectElement>('#ap-category option').forEach((opt) => {
      out[opt.value] = opt.textContent?.trim() || opt.value;
    });
    return out;
  })();

  let allItems: ApprovalItem[] = [];
  let counts: Record<string, number> = {};
  let currentTab = 'all';
  let sessionData: SessionResponse | null = null;

  // Board view state: column sorting + browser-side pagination (owner
  // decision 25-08-2026). The default sort matches the API order exactly
  // (created_at DESC, id DESC) so rows never jump on first render.
  type SortKey = 'voucher_no' | 'voucher_date' | 'title' | 'payee' | 'category' | 'requested_amount' | 'status' | 'created_at';
  let sortKey: SortKey = 'created_at';
  let sortDir: 'asc' | 'desc' = 'desc';
  let currentPage = 1;
  const PAGE_SIZE = 20;

  function esc(value: unknown): string {
    return String(value ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function fmtMoney(value: number | null): string {
    if (value === null || value === undefined) return '';
    // Sign before the currency, matching the emails: -S$400.00.
    const sign = value < 0 ? '-' : '';
    return sign + 'S$' + Math.abs(value).toLocaleString('en-SG', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  function fmtDateSg(sqlite: string | null): string {
    if (!sqlite) return '';
    const date = new Date(sqlite.replace(' ', 'T') + 'Z');
    if (Number.isNaN(date.getTime())) return sqlite;
    return date.toLocaleString('en-GB', {
      timeZone: 'Asia/Singapore',
      day: '2-digit',
      month: 'short',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
    });
  }

  // Date-only fields (voucher_date is stored as YYYY-MM-DD) render like the
  // other dates on the page: 24 Aug 2026.
  function fmtDateOnly(iso: string | null): string {
    if (!iso) return '';
    const m = iso.match(/^(\d{4})-(\d{2})-(\d{2})$/);
    if (!m) return iso;
    const date = new Date(Date.UTC(Number(m[1]), Number(m[2]) - 1, Number(m[3])));
    return date.toLocaleDateString('en-GB', { timeZone: 'UTC', day: '2-digit', month: 'short', year: 'numeric' });
  }

  function fmtSize(bytes: number): string {
    if (bytes >= 1024 * 1024) return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
    return Math.max(1, Math.round(bytes / 1024)) + ' KB';
  }

  function todayIso(): string {
    return new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Singapore' });
  }

  function parseVoucherLines(raw: string | null): VoucherLine[] {
    if (!raw) return [];
    try {
      const parsed = JSON.parse(raw);
      return Array.isArray(parsed) ? (parsed as VoucherLine[]) : [];
    } catch {
      return [];
    }
  }

  function voucherTotal(lines: VoucherLine[]): number {
    return Math.round(lines.reduce((sum, line) => sum + (typeof line.amount === 'number' ? line.amount : 0), 0) * 100) / 100;
  }

  function chip(status: string): string {
    const label = STATUS_LABELS[status] || status;
    return `<span class="ap-chip ap-chip-${esc(status)}">${esc(label)}</span>`;
  }

  // ---- Board ----------------------------------------------------------

  async function loadList(): Promise<void> {
    const res = await fetch('/api/approvals');
    if (!res.ok) return;
    const body = (await res.json()) as { items: ApprovalItem[]; counts: Record<string, number> };
    allItems = body.items || [];
    counts = body.counts || {};
    renderCounts();
    renderTable();
  }

  function renderCounts(): void {
    document.querySelectorAll<HTMLSpanElement>('.ap-tab-count').forEach((el) => {
      const key = el.dataset.count || '';
      el.textContent = String(counts[key] ?? 0);
    });
  }

  // ---- Sorting + pagination -------------------------------------------

  function sortValue(item: ApprovalItem, key: SortKey): string | number | null {
    switch (key) {
      case 'requested_amount':
        return item.requested_amount === null || item.requested_amount === undefined ? null : Number(item.requested_amount);
      case 'category':
        return CATEGORY_LABELS[item.category] || item.category;
      case 'status':
        return STATUS_LABELS[item.status] || item.status;
      default:
        return (item[key] as string | null) || null;
    }
  }

  // Empty values always sink to the bottom regardless of direction.
  function compareItems(a: ApprovalItem, b: ApprovalItem): number {
    const va = sortValue(a, sortKey);
    const vb = sortValue(b, sortKey);
    if (va === null && vb === null) return 0;
    if (va === null) return 1;
    if (vb === null) return -1;
    let cmp: number;
    if (typeof va === 'number' && typeof vb === 'number') {
      cmp = va - vb;
    } else {
      // numeric: true keeps voucher numbers like PV26-0802 < PV26-0811 in order.
      cmp = String(va).localeCompare(String(vb), 'en', { sensitivity: 'base', numeric: true });
    }
    return sortDir === 'asc' ? cmp : -cmp;
  }

  function filteredItems(): ApprovalItem[] {
    const items = currentTab === 'all' ? [...allItems] : allItems.filter((i) => i.status === currentTab);
    // Array.prototype.sort is stable, so ties keep the API's newest-first order.
    items.sort(compareItems);
    return items;
  }

  function renderSortHeads(): void {
    document.querySelectorAll<HTMLTableCellElement>('#ap-board-table th.ap-sortable').forEach((th) => {
      const key = (th.dataset.sort || '') as SortKey;
      const active = key === sortKey;
      th.classList.toggle('ap-sort-asc', active && sortDir === 'asc');
      th.classList.toggle('ap-sort-desc', active && sortDir === 'desc');
      th.setAttribute('aria-sort', active ? (sortDir === 'asc' ? 'ascending' : 'descending') : 'none');
    });
  }

  document.querySelectorAll<HTMLTableCellElement>('#ap-board-table th.ap-sortable').forEach((th) => {
    th.addEventListener('click', () => {
      const key = (th.dataset.sort || '') as SortKey;
      if (key === sortKey) {
        sortDir = sortDir === 'asc' ? 'desc' : 'asc';
      } else {
        sortKey = key;
        // Dates read naturally newest-first; text reads A to Z.
        sortDir = key === 'created_at' || key === 'voucher_date' ? 'desc' : 'asc';
      }
      currentPage = 1;
      renderTable();
    });
  });

  // Page numbers with ellipsis: 1 … n-1 n n+1 … last (plain run when few).
  function pageList(current: number, total: number): Array<number | 'ellipsis'> {
    if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
    const wanted = [1, total, current - 1, current, current + 1].filter((p) => p >= 1 && p <= total) as number[];
    const unique = [...new Set(wanted)].sort((a, b) => a - b);
    const out: Array<number | 'ellipsis'> = [];
    let prev = 0;
    for (const p of unique) {
      if (p - prev > 1) out.push('ellipsis');
      out.push(p);
      prev = p;
    }
    return out;
  }

  function renderPagination(totalItems: number, start: number, shown: number, totalPages: number): void {
    const box = document.getElementById('ap-pagination');
    if (!box) return;
    if (totalItems === 0) {
      box.innerHTML = '';
      return;
    }
    const parts: string[] = [
      `<button type="button" class="ap-page-btn" data-page="${currentPage - 1}"${currentPage === 1 ? ' disabled' : ''}>Prev</button>`,
    ];
    for (const p of pageList(currentPage, totalPages)) {
      if (p === 'ellipsis') parts.push('<span class="ap-page-ellipsis">&hellip;</span>');
      else parts.push(`<button type="button" class="ap-page-btn${p === currentPage ? ' active' : ''}" data-page="${p}">${p}</button>`);
    }
    parts.push(`<button type="button" class="ap-page-btn" data-page="${currentPage + 1}"${currentPage === totalPages ? ' disabled' : ''}>Next</button>`);
    box.innerHTML =
      `<span class="ap-page-info">Showing ${start + 1}\u2013${start + shown} of ${totalItems}</span>` +
      `<div class="ap-page-btns">${parts.join('')}</div>`;
    box.querySelectorAll<HTMLButtonElement>('.ap-page-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const p = Number(btn.dataset.page);
        if (p >= 1 && p <= totalPages && p !== currentPage) {
          currentPage = p;
          renderTable();
        }
      });
    });
  }

  function renderTable(): void {
    const tbody = document.getElementById('ap-list');
    if (!tbody) return;
    renderSortHeads();
    const items = filteredItems();
    if (items.length === 0) {
      renderPagination(0, 0, 0, 1);
      tbody.innerHTML = `<tr><td colspan="9" style="text-align:center;color:var(--text-muted);padding:1.5rem;">No items in this view.</td></tr>`;
      return;
    }
    const totalPages = Math.max(1, Math.ceil(items.length / PAGE_SIZE));
    if (currentPage > totalPages) currentPage = totalPages;
    const start = (currentPage - 1) * PAGE_SIZE;
    const pageItems = items.slice(start, start + PAGE_SIZE);
    tbody.innerHTML = pageItems
      .map(
        (item) => `<tr>
          <td>${esc(item.voucher_no || '—')}</td>
          <td>${esc(fmtDateOnly(item.voucher_date) || '—')}</td>
          <td>${esc(item.title)}</td>
          <td>${esc(item.payee || '—')}</td>
          <td>${esc(CATEGORY_LABELS[item.category] || item.category)}</td>
          <td>${esc(fmtMoney(item.requested_amount) || '—')}</td>
          <td>${chip(item.status)}</td>
          <td>${esc(fmtDateSg(item.created_at))}</td>
          <td><button type="button" class="row-view-btn" data-id="${item.id}" aria-label="View ${esc(item.title)}">View</button></td>
        </tr>`,
      )
      .join('');

    tbody.querySelectorAll<HTMLButtonElement>('.row-view-btn').forEach((btn) => {
      btn.addEventListener('click', () => openDrawer(Number(btn.dataset.id)));
    });
    renderPagination(items.length, start, pageItems.length, totalPages);
  }

  document.querySelectorAll<HTMLButtonElement>('.ap-tab').forEach((btn) => {
    btn.addEventListener('click', () => {
      currentTab = btn.dataset.status || 'all';
      document.querySelectorAll('.ap-tab').forEach((el) => {
        el.classList.toggle('active', el === btn);
        el.setAttribute('aria-selected', el === btn ? 'true' : 'false');
      });
      currentPage = 1;
      renderTable();
    });
  });

  // ---- Drawer ---------------------------------------------------------

  async function openDrawer(id: number): Promise<void> {
    const overlay = document.getElementById('ap-drawer-overlay');
    const body = document.getElementById('ap-drawer-body');
    const title = document.getElementById('ap-drawer-title');
    if (!overlay || !body || !title) return;
    body.innerHTML = '<p style="color:var(--text-muted);">Loading…</p>';
    overlay.removeAttribute('hidden');
    document.body.style.overflow = 'hidden';

    const res = await fetch(`/api/approvals/${id}`);
    if (!res.ok) {
      body.innerHTML = '<p>Could not load this item.</p>';
      return;
    }
    const data = (await res.json()) as {
      item: ApprovalItem;
      attachments: ApprovalAttachment[];
      duplicate_invoice: { id: number; voucherNo: string | null } | null;
      last_paid_method: string | null;
    };
    const item = data.item;
    const attachments = data.attachments || [];
    const duplicateInvoice = data.duplicate_invoice || null;
    const lastPaidMethod = data.last_paid_method || null;
    title.textContent = item.title;

    // The signer's office renders beside their name on every decision line
    // (plan §6.2) — "Name, Office".
    const nameWithOffice = (name: string | null, office: string | null): string =>
      office ? `${name ?? ''}, ${office}` : name || '';

    // Third tuple element marks rows whose values can be long (emails,
    // payment references) — they span both grid columns and never wrap.
    const detailRows: Array<[string, string, boolean?]> = [
      ['Status', chip(item.status)],
      ['Category', esc(CATEGORY_LABELS[item.category] || item.category)],
      ['Approval required', item.approval_required === 1 ? 'Yes' : 'No'],
      ['Payable to', esc(item.payee || '')],
      ['Requested amount', esc(fmtMoney(item.requested_amount))],
      ...(item.purchase_decision_by
        ? (item.status === 'rejected' && item.rejected_stage === 'purchase'
          ? ([
              // The purchase decision was a rejection — the "approved" label
              // would be wrong; the rejection banner above carries the reason.
              ['Purchase decision by', esc(nameWithOffice(item.purchase_decision_by, item.purchase_decision_office))],
              ['Decided at (SG)', esc(fmtDateSg(item.purchase_decision_at))],
            ] as Array<[string, string, boolean?]>)
          : ([
              ['Purchase approved by', esc(nameWithOffice(item.purchase_decision_by, item.purchase_decision_office))],
              ['Approved at (SG)', esc(fmtDateSg(item.purchase_decision_at))],
            ] as Array<[string, string, boolean?]>))
        : []),
      ...(item.finance_decision_by
        ? ([
            [item.status === 'rejected' && item.rejected_stage === 'finance' ? 'Finance decision by' : 'Payment approved by',
              esc(nameWithOffice(item.finance_decision_by, item.finance_decision_office))],
            ['Decided at (SG)', esc(fmtDateSg(item.finance_decision_at))],
          ] as Array<[string, string, boolean?]>)
        : []),
      ['Voucher No', esc(item.voucher_no || '')],
      ['Voucher date', esc(fmtDateOnly(item.voucher_date))],
      ['Invoice/Receipt No', esc(item.invoice_no || '')],
      ['Raised by', esc(item.created_by), true],
      ['Raised at (SG)', esc(fmtDateSg(item.created_at))],
      ...(item.paid_by
        ? ([
            ['Paid by', esc(item.paid_by), true],
            ['Paid on', esc(fmtDateSg(item.paid_at))],
            ['Payment method', esc(PAYMENT_METHOD_LABELS[item.payment_method || ''] || item.payment_method || '')],
            ['Payment reference', esc(item.payment_reference || ''), true],
          ] as Array<[string, string, boolean?]>)
        : []),
    ];

    let notesHtml = '';
    if (item.status === 'rejected' && item.rejected_stage === 'purchase' && item.rejection_reason) {
      notesHtml += `<div class="ap-note"><strong>Rejected at purchase stage:</strong> ${esc(item.rejection_reason)}</div>`;
    }
    if (item.rejected_stage === 'finance' && item.finance_rejection_reason) {
      notesHtml += `<div class="ap-note"><strong>Rejected at finance stage:</strong> ${esc(item.finance_rejection_reason)}</div>`;
    }
    // Duplicate invoice: warns, never blocks (settled decision 5).
    if (duplicateInvoice) {
      notesHtml += `<div class="ap-note" style="border-left-color:#b45309;background:#fff7e6;"><strong>Possible duplicate invoice:</strong> this invoice number also appears on item #${duplicateInvoice.id}${
        duplicateInvoice.voucherNo ? ` (${esc(duplicateInvoice.voucherNo)})` : ''
      }. Suppliers legitimately reuse numbers monthly — check before paying.</div>`;
    }

    const attachmentsHtml =
      attachments.length === 0
        ? '<p style="color:var(--text-muted);font-size:0.85rem;">No documents attached.</p>'
        : attachments
            .map((att) => {
              const url = `/api/approvals/${item.id}/attachment/${att.id}`;
              const isImage = att.mime_type.startsWith('image/');
              const preview = isImage
                ? `<img src="${url}" alt="${esc(att.filename)}" loading="lazy" />`
                : `<iframe src="${url}" title="${esc(att.filename)}" loading="lazy"></iframe>`;
              // R7: the ticked Tax Invoice always renders first (the API
              // orders it so) and carries a chip.
              const taxChip = att.is_tax_invoice === 1 ? '<span class="ap-tax-chip">Tax Invoice</span>' : '';
              return `<div class="ap-attachment">
                <div class="ap-attachment-head">
                  <span class="ap-attachment-name">${taxChip} ${esc(att.filename)}</span>
                  <span class="ap-attachment-actions">
                    <span style="color:var(--text-muted);font-size:0.78rem;">${esc(fmtSize(att.size))}</span>
                    <a href="${url}" target="_blank" rel="noopener noreferrer">Open</a>
                    <a href="${url}?download=1">Download</a>
                  </span>
                </div>
                <div class="ap-attachment-preview">${preview}</div>
              </div>`;
            })
            .join('');

    const comparisonRows = Array.isArray(item.comparison) ? item.comparison : [];
    // Quotation dates (plan §7.2): each row's date renders beside it; older
    // than twelve months shows an amber "fresh quotation needed" chip. The
    // warning lives in the drawer only — where decisions happen.
    const quoteDateCell = (row: { quoteDate?: string }): string => {
      if (!row.quoteDate) return '';
      const m = row.quoteDate.match(/^(\d{4})-(\d{2})-(\d{2})$/);
      if (!m) return esc(row.quoteDate);
      const ageDays = (Date.now() - Date.UTC(Number(m[1]), Number(m[2]) - 1, Number(m[3]))) / 86_400_000;
      const stale = ageDays > 365;
      const label = esc(fmtDateOnly(row.quoteDate));
      return stale ? `${label} <span class="ap-quote-stale">older than 12 months, a fresh quotation is needed</span>` : label;
    };
    const comparisonHtml =
      comparisonRows.length === 0
        ? ''
        : `<div>
            <h3 style="font-size:1rem;margin:0 0 0.5rem;">Comparison table</h3>
            <table class="ap-comparison-table">
              <thead><tr><th>Quotation</th><th>Document</th><th style="width:11rem;">Quotation date</th></tr></thead>
              <tbody>
                ${comparisonRows
                  .map((row) => {
                    const att = attachments.find((a) => a.id === row.attachmentId);
                    const link = att
                      ? `<a href="/api/approvals/${item.id}/attachment/${att.id}" target="_blank" rel="noopener noreferrer">${esc(att.filename)}</a>`
                      : '<span style="color:var(--text-muted);">Document unavailable</span>';
                    return `<tr><td>${esc(row.description)}</td><td>${link}</td><td>${quoteDateCell(row)}</td></tr>`;
                  })
                  .join('')}
              </tbody>
            </table>
          </div>`;

    // ---- Stored AI analysis (read-only for everyone; regeneration happens
    //      through the edit form's Analyse button — owner decision 26-08-2026) ----
    const aiAnalysis = item.ai_comparison && typeof item.ai_comparison === 'object' ? (item.ai_comparison as AiAnalysis) : null;
    const aiEditAvailable =
      !!sessionData?.is_admin && sessionData?.ai_comparison_enabled !== false && comparisonRows.length >= 2;
    let aiHtml = '';
    if (aiAnalysis) {
      aiHtml = `<div class="ap-ai-block">
        ${renderAiAnalysisBlock(aiAnalysis)}
      </div>`;
    }

    // ---- Stage-appropriate actions (plan §11) ----
    const voucherLines = parseVoucherLines(item.voucher_lines);
    const hasVoucher = !!item.voucher_no;
    const canApprove = item.status === 'pending' && !!sessionData?.is_purchase_approver;
    const canFinanceDecide = item.status === 'finance_check' && !!sessionData?.is_finance_approver;
    const canRemind = (item.status === 'pending' || item.status === 'finance_check') && !!sessionData?.is_admin;
    const canEdit = (item.status === 'pending' || (item.status === 'rejected' && item.rejected_stage === 'purchase')) && !!sessionData?.is_admin;
    const canVoucher =
      (item.status === 'purchase_approved' || (item.status === 'rejected' && item.rejected_stage === 'finance')) && !!sessionData?.is_admin;
    const canRecordPaid = item.status === 'finance_approved' && !!sessionData?.is_admin;
    const showVoucherLink = (item.status === 'finance_approved' || item.status === 'paid') && !!item.voucher_no;
    const actionsHtml =
      canApprove || canFinanceDecide || canRemind || canEdit || canVoucher || canRecordPaid || showVoucherLink
        ? `<div class="ap-actions">
            ${canFinanceDecide ? '<button type="button" class="btn btn-primary" id="ap-act-finance-approve">Approve voucher</button>' : ''}
            ${canFinanceDecide ? '<button type="button" class="btn btn-danger" id="ap-act-finance-reject">Reject voucher\u2026</button>' : ''}
            ${canApprove ? '<button type="button" class="btn btn-primary" id="ap-act-approve">Approve</button>' : ''}
            ${canApprove ? '<button type="button" class="btn btn-danger" id="ap-act-reject">Reject\u2026</button>' : ''}
            ${canVoucher ? `<button type="button" class="btn btn-primary" id="ap-act-voucher">${hasVoucher ? 'Edit voucher & resubmit' : 'Prepare voucher'}</button>` : ''}
            ${canRecordPaid ? '<button type="button" class="btn btn-primary" id="ap-act-paid">Record payment\u2026</button>' : ''}
            ${showVoucherLink ? `<a class="btn btn-secondary" href="/approvals/voucher?id=${item.id}" target="_blank" rel="noopener noreferrer">View voucher</a>` : ''}
            ${canRemind ? '<button type="button" class="btn btn-secondary" id="ap-act-remind">Send reminder</button>' : ''}
            ${canEdit ? '<button type="button" class="btn btn-secondary" id="ap-act-edit">Edit</button>' : ''}
            <span id="ap-act-msg" role="status" aria-live="polite" style="font-size:0.85rem;"></span>
          </div>
          <div id="ap-reject-box" hidden>
            <label class="ap-field" style="display:block;">
              <span>Reason for rejection (sent to the requester)</span>
              <textarea id="ap-reject-reason" class="form-input" rows="3" maxlength="1000" placeholder="e.g. Please get a second quotation above S$5,000."></textarea>
            </label>
            <button type="button" class="btn btn-danger" id="ap-act-reject-confirm" style="margin-top:0.5rem;">Confirm rejection</button>
          </div>
          <div id="ap-finance-reject-box" hidden>
            <label class="ap-field" style="display:block;">
              <span>Reason for rejection (sent to the requester)</span>
              <textarea id="ap-finance-reject-reason" class="form-input" rows="3" maxlength="1000" placeholder="e.g. The total does not match the invoice; please correct line 2."></textarea>
            </label>
            <button type="button" class="btn btn-danger" id="ap-act-finance-reject-confirm" style="margin-top:0.5rem;">Confirm rejection</button>
          </div>
          <form id="ap-paid-form" hidden>
            ${duplicateInvoice
              ? `<div class="ap-note" style="margin:0 0 0.75rem;border-left-color:#b45309;background:#fff7e6;"><strong>Possible duplicate invoice:</strong> this invoice number also appears on item #${duplicateInvoice.id}${
                  duplicateInvoice.voucherNo ? ` (${esc(duplicateInvoice.voucherNo)})` : ''
                }. Check before recording payment.</div>`
              : ''}
            <div class="ap-form-grid">
              <label class="ap-field"><span>Who made the payment</span>
                <input type="text" id="ap-paid-by" class="form-input" maxlength="200" placeholder="e.g. Jolene Lim (SWA DBS app)" required /></label>
              <label class="ap-field"><span>Payment date</span>
                <input type="date" id="ap-paid-date" class="form-input" value="${todayIso()}" required /></label>
              <label class="ap-field"><span>Method</span>
                <select id="ap-paid-method" class="form-input" required>
                  <option value="paynow">PayNow</option>
                  <option value="bank_transfer">Bank transfer</option>
                  <option value="giro">GIRO</option>
                  <option value="cash">Cash</option>
                  <option value="other">Other</option>
                </select></label>
              <label class="ap-field"><span>Reference (optional)</span>
                <input type="text" id="ap-paid-reference" class="form-input" maxlength="200" placeholder="e.g. PayNow ref 20260824001" /></label>
            </div>
            <div style="display:flex;gap:0.5rem;align-items:center;margin-top:0.75rem;">
              <button type="submit" class="btn btn-primary">Record payment</button>
              <button type="button" class="btn btn-secondary" id="ap-paid-cancel">Cancel</button>
            </div>
          </form>
          <form id="ap-voucher-form" hidden>
            <div class="ap-form-grid">
              <label class="ap-field"><span>Voucher date</span>
                <input type="date" id="ap-voucher-date" class="form-input" value="${esc(item.voucher_date || todayIso())}" required /></label>
              <label class="ap-field"><span>Invoice/receipt number (required)</span>
                <input type="text" id="ap-voucher-invoice" class="form-input" maxlength="100" placeholder="e.g. INV-2026-0812" value="${esc(item.invoice_no || '')}" required /></label>
              <label class="ap-field"><span>Payable to (carried from the item)</span>
                <input type="text" class="form-input" value="${esc(item.payee || '')}" disabled /></label>
            </div>
            <p style="margin:0.75rem 0 0.25rem;font-weight:600;font-size:0.85rem;">Voucher lines</p>
            <p style="margin:0 0 0.5rem;color:var(--text-muted);font-size:0.78rem;">
              Amounts may be negative (a deposit already paid). Leave the amount empty for note-only lines such as bank details.
              The voucher number is assigned when you submit.
            </p>
            <div id="ap-voucher-lines"></div>
            <button type="button" class="btn btn-secondary" id="ap-voucher-add-line" style="margin-top:0.5rem;">Add line</button>
            <p style="margin:0.75rem 0 0;font-weight:600;">Total: <span id="ap-voucher-total">S$0.00</span></p>
            <div style="display:flex;gap:0.5rem;align-items:center;margin-top:0.75rem;">
              <button type="submit" class="btn btn-primary">Submit voucher to finance</button>
              <button type="button" class="btn btn-secondary" id="ap-voucher-cancel">Cancel</button>
            </div>
          </form>
          <form id="ap-edit-form" hidden>
            <div class="ap-form-grid">
              <label class="ap-field"><span>Title</span>
                <input type="text" id="ap-edit-title" class="form-input" maxlength="300" value="${esc(item.title)}" /></label>
              <label class="ap-field"><span>Payable to</span>
                <input type="text" id="ap-edit-payee" class="form-input" maxlength="300" value="${esc(item.payee || '')}" /></label>
              <label class="ap-field"><span>Requested amount (S$)</span>
                <input type="number" id="ap-edit-amount" class="form-input" min="0.01" max="10000000" step="0.01" inputmode="decimal" value="${item.requested_amount ?? ''}" /></label>
            </div>
            <label class="ap-field" style="display:block;margin-top:0.75rem;"><span>Description</span>
              <textarea id="ap-edit-description" class="form-input" rows="4" maxlength="4000">${esc(item.description || '')}</textarea></label>
            <label class="ap-field" style="display:block;margin-top:0.75rem;"><span>Add documents (optional)</span>
              <input type="file" id="ap-edit-files" class="form-input" multiple accept="application/pdf,image/jpeg,image/png,image/webp,image/heic,image/heif" /></label>
            ${attachments.length > 0
              ? `<div style="margin-top:0.75rem;">
                  <p style="margin:0 0 0.25rem;font-weight:600;font-size:0.85rem;">Tax Invoice</p>
                  <p style="margin:0 0 0.4rem;font-size:0.75rem;color:var(--text-muted);">Tick the one document that is the tax invoice — it always shows first. Ticking one clears the other.</p>
                  ${attachments
                    .map(
                      (att) => `<label class="ap-check" style="margin-top:0.25rem;"><input type="checkbox" class="ap-edit-tax" data-att="${att.id}" ${att.is_tax_invoice === 1 ? 'checked' : ''} /><span>${esc(att.filename)}</span></label>`,
                    )
                    .join('')}
                </div>`
              : ''}
            <div id="ap-edit-compliance" style="margin-top:0.9rem;display:none;border:1px solid var(--swa-3);background:#faf7fc;padding:0.9rem 1rem;border-radius:0.5rem;">
              <p style="margin:0 0 0.6rem;font-weight:600;color:var(--swa-2);">Declarations (S$1,000 and above)</p>
              <label class="ap-check"><input type="checkbox" id="ap-edit-budget-approved" ${Number(item.budget_approved) === 1 ? 'checked' : ''} /><span>Payment is within the approved budget</span></label>
              <div class="ap-form-grid" style="margin-top:0.6rem;">
                <label class="ap-field"><span>Budget amount</span>
                  <input type="text" id="ap-edit-budget-amount" class="form-input" maxlength="50" value="${esc(item.budget_amount || '')}" /></label>
                <label class="ap-field"><span>Budget approving officer</span>
                  <input type="text" id="ap-edit-budget-officer" class="form-input" maxlength="200" value="${esc(item.budget_officer || '')}" /></label>
                <label class="ap-field"><span>Budget approval date</span>
                  <input type="date" id="ap-edit-budget-date" class="form-input" value="${esc(item.budget_date || '')}" /></label>
                <label class="ap-field"><span>Is the chosen supplier the cheapest of the quotations?</span>
                  <select id="ap-edit-supplier-cheapest" class="form-input">
                    <option value="">— Answer —</option>
                    <option value="yes" ${item.supplier_is_cheapest === 1 ? 'selected' : ''}>Yes</option>
                    <option value="no" ${item.supplier_is_cheapest === 0 ? 'selected' : ''}>No</option>
                  </select></label>
              </div>
              <label class="ap-field" style="display:block;margin-top:0.6rem;" id="ap-edit-supplier-reason-wrap" ${item.supplier_is_cheapest === 0 ? '' : 'hidden'}>
                <span>Reason for not choosing the cheapest (required)</span>
                <textarea id="ap-edit-supplier-reason" class="form-input" rows="2" maxlength="1000">${esc(item.supplier_choice_reason || '')}</textarea>
              </label>
              <label class="ap-field" style="display:block;margin-top:0.6rem;" id="ap-edit-waiver-wrap" ${comparisonRows.length >= 2 ? 'hidden' : ''}>
                <span>Why fewer than two quotations are attached (required unless two are in the comparison table)</span>
                <textarea id="ap-edit-waiver" class="form-input" rows="2" maxlength="1000">${esc(item.quotation_waiver_reason || '')}</textarea>
              </label>
              <label class="ap-check" style="margin-top:0.6rem;"><input type="checkbox" id="ap-edit-coi-declared" ${Number(item.coi_declared) === 1 ? 'checked' : ''} /><span>No conflict of interest in this purchase</span></label>
              <label class="ap-check" style="margin-top:0.4rem;"><input type="checkbox" id="ap-edit-no-split-declared" ${Number(item.no_split_declared) === 1 ? 'checked' : ''} /><span>The purchase is not split to stay under an approval limit</span></label>
              <p id="ap-edit-invitation-reminder" class="ap-reminder" style="display:none;">S$6,000 and above: obtain two written invitations to quote and attach them.</p>
              <p id="ap-edit-tender-reminder" class="ap-reminder" style="display:none;">Above S$90,000: a formal tender is required. Attach the tender documents.</p>
              <div id="ap-edit-board-box" style="display:none;margin-top:0.75rem;border-top:1px solid var(--swa-3);padding-top:0.6rem;">
                <p style="margin:0 0 0.4rem;font-weight:600;color:var(--swa-2);">Board approval (S$10,000 and above)</p>
                <label class="ap-field"><span>Board approval reference</span>
                  <input type="text" id="ap-edit-board-ref" class="form-input" maxlength="500" value="${esc(item.board_approval_ref || '')}" /></label>
                <p style="margin:0.35rem 0 0;font-size:0.8rem;color:var(--text-muted);">Attach the board minutes or the approval email PDF with the documents above.</p>
              </div>
            </div>
            ${aiEditAvailable
              ? `<div style="margin-top:0.75rem;border:1px solid var(--swa-3);border-radius:0.4rem;padding:0.6rem 0.75rem;background:#faf7fc;">
                  <div style="display:flex;align-items:center;gap:0.75rem;flex-wrap:wrap;">
                    <button type="button" class="btn btn-secondary" id="ap-edit-ai-run">Analyse with AI</button>
                    <span id="ap-edit-ai-msg" role="status" aria-live="polite" style="font-size:0.8rem;color:var(--text-muted);"></span>
                  </div>
                  <p style="margin:0.4rem 0 0;font-size:0.75rem;color:var(--text-muted);">
                    Re-reads the ticked comparison quotations and updates the AI comparison stored on this item.
                  </p>
                </div>`
              : ''}
            ${aiAnalysis
              ? `<label class="ap-field" style="display:block;margin-top:0.75rem;"><span>AI summary (editable until submitted for approval)</span>
                  <textarea id="ap-edit-ai-summary" class="form-input" rows="4" maxlength="4000">${esc(aiAnalysis.summary || '')}</textarea></label>
                <label class="ap-field" style="display:block;margin-top:0.5rem;"><span>AI recommendation</span>
                  <textarea id="ap-edit-ai-reco" class="form-input" rows="2" maxlength="1000">${esc(aiAnalysis.recommendation || '')}</textarea></label>`
              : ''}
            ${item.status === 'rejected'
              ? `<label class="ap-check" style="margin-top:0.75rem;"><input type="checkbox" id="ap-edit-resubmit" checked /><span>Resubmit for approval (returns to the stage that rejected it)</span></label>`
              : ''}
            <div style="display:flex;gap:0.5rem;align-items:center;margin-top:0.75rem;">
              <button type="submit" class="btn btn-primary">Save changes</button>
              <button type="button" class="btn btn-secondary" id="ap-edit-cancel">Cancel</button>
            </div>
          </form>`
        : '';

    // Compliance evidence card (plan §7.5): declarations, board reference,
    // waiver, supplier choice — each line only when the field exists.
    const yesNo = (v: number | null | undefined): string => (v === null || v === undefined ? '' : v === 1 ? 'Yes' : 'No');
    const evRows: Array<[string, string, boolean?]> = [];
    if (item.board_approval_ref) evRows.push(['Board approval reference', esc(item.board_approval_ref), true]);
    if (item.quotation_waiver_reason) evRows.push(['Quotation waiver reason', esc(item.quotation_waiver_reason), true]);
    if (item.supplier_is_cheapest !== null && item.supplier_is_cheapest !== undefined) {
      evRows.push(['Chosen supplier is the cheapest', esc(yesNo(item.supplier_is_cheapest))]);
      if (item.supplier_choice_reason) evRows.push(['Reason (not the cheapest)', esc(item.supplier_choice_reason), true]);
    }
    if (Number(item.budget_approved) === 1) {
      evRows.push(['Budget approved', 'Yes']);
      if (item.budget_amount) evRows.push(['Budget amount', esc(item.budget_amount)]);
      if (item.budget_officer) evRows.push(['Budget approving officer', esc(item.budget_officer), true]);
      if (item.budget_date) evRows.push(['Budget approval date', esc(fmtDateOnly(item.budget_date))]);
    }
    if (Number(item.coi_declared) === 1) evRows.push(['Conflict of interest', 'None declared']);
    if (Number(item.no_split_declared) === 1) evRows.push(['Splitting to avoid limits', 'Not split (declared)']);
    const evidenceHtml =
      evRows.length === 0
        ? ''
        : `<div>
            <h3 style="font-size:1rem;margin:0 0 0.5rem;">Declarations &amp; evidence</h3>
            <dl class="ap-detail-grid">
              ${evRows.map(([label, value, wide]) => `<div class="ap-detail-item${wide ? ' ap-detail-item--wide' : ''}"><dt>${label}</dt><dd>${value || '—'}</dd></div>`).join('')}
            </dl>
          </div>`;

    const voucherHtml =
      !hasVoucher
        ? ''
        : `<div class="ap-voucher">
            <h3 style="font-size:1rem;margin:0 0 0.5rem;">Payment voucher</h3>
            <p style="margin:0 0 0.5rem;font-size:0.85rem;">
              <strong>${esc(item.voucher_no || '')}</strong> — ${esc(fmtDateOnly(item.voucher_date))} — payable to ${esc(item.payee || '—')}
            </p>
            <table class="ap-comparison-table">
              <thead><tr><th style="width:2.5rem;">No</th><th style="width:6rem;">Date</th><th>Description</th><th style="width:8rem; text-align:right;">Amount (S$)</th></tr></thead>
              <tbody>
                ${voucherLines
                  .map(
                    (line) =>
                      `<tr><td>${line.no ?? ''}</td><td>${esc(line.date || '')}</td><td>${esc(line.description)}</td><td style="text-align:right;">${
                        line.amount === null ? '' : fmtMoney(line.amount)
                      }</td></tr>`,
                  )
                  .join('')}
                <tr><td colspan="3" style="text-align:right;font-weight:600;">TOTAL PAYABLE</td><td style="text-align:right;font-weight:600;">${fmtMoney(
                  voucherTotal(voucherLines),
                )}</td></tr>
              </tbody>
            </table>
            <p style="margin:0.5rem 0 0;font-size:0.8rem;color:var(--text-muted);">
              Prepared by ${esc(item.voucher_submitted_by || '')}${item.voucher_submitted_at ? ` (${fmtDateSg(item.voucher_submitted_at)})` : ''}.
              ${item.finance_decision_by
                ? `Payment approved by ${esc(nameWithOffice(item.finance_decision_by, item.finance_decision_office))}${item.finance_decision_at ? ` (${fmtDateSg(item.finance_decision_at)})` : ''}.`
                : item.status === 'finance_check'
                  ? 'Awaiting finance approval.'
                  : ''}
            </p>
          </div>`;

    body.innerHTML = `
      ${notesHtml}
      ${actionsHtml}
      <dl class="ap-detail-grid">
        ${detailRows.map(([label, value, wide]) => `<div class="ap-detail-item${wide ? ' ap-detail-item--wide' : ''}"><dt>${label}</dt><dd>${value || '—'}</dd></div>`).join('')}
      </dl>
      ${item.description ? `<div><h3 style="font-size:1rem;margin:0 0 0.5rem;">Description</h3><p style="margin:0;font-size:0.9rem;white-space:pre-wrap;word-break:break-word;">${esc(item.description)}</p></div>` : ''}
      ${evidenceHtml}
      ${voucherHtml}
      <div>
        <h3 style="font-size:1rem;margin:0 0 0.5rem;">Documents</h3>
        ${attachmentsHtml}
      </div>
      ${comparisonHtml}
      ${aiHtml}
    `;

    wireDrawerActions(item);

    // R6: pre-select the category's last paid method on the paid form
    // (remembered by category, not by payee — the admin can override).
    if (lastPaidMethod) {
      const methodSel = document.getElementById('ap-paid-method') as HTMLSelectElement | null;
      if (methodSel && Array.from(methodSel.options).some((o) => o.value === lastPaidMethod)) {
        methodSel.value = lastPaidMethod;
      }
    }

    // Edit-form declarations block: visibility follows the typed amount
    // (plan §7.4); the supplier reason box follows the Yes/No answer.
    const editAmountEl = document.getElementById('ap-edit-amount') as HTMLInputElement | null;
    const editTaxBoxes = Array.from(document.querySelectorAll<HTMLInputElement>('input.ap-edit-tax'));
    const syncEditCompliance = (): void => {
      const box = document.getElementById('ap-edit-compliance');
      if (!box) return;
      const raw = editAmountEl?.value.trim() || '';
      const amt = raw ? Number(raw) : null;
      const show = amt !== null && Number.isFinite(amt) && amt >= APPROVAL_QUOTE_RULE_THRESHOLD;
      box.style.display = show ? '' : 'none';
      if (!show) return;
      const a = amt as number;
      const inv = document.getElementById('ap-edit-invitation-reminder');
      if (inv) inv.style.display = a >= APPROVAL_INVITATION_REMINDER_THRESHOLD && a <= APPROVAL_TENDER_REMINDER_THRESHOLD ? '' : 'none';
      const tender = document.getElementById('ap-edit-tender-reminder');
      if (tender) tender.style.display = a > APPROVAL_TENDER_REMINDER_THRESHOLD ? '' : 'none';
      const board = document.getElementById('ap-edit-board-box');
      if (board) board.style.display = a >= APPROVAL_BOARD_APPROVAL_THRESHOLD ? '' : 'none';
      const storedCount = comparisonRows.length;
      const waiverWrap = document.getElementById('ap-edit-waiver-wrap');
      if (waiverWrap) waiverWrap.hidden = storedCount >= 2;
    };
    editAmountEl?.addEventListener('input', syncEditCompliance);
    editTaxBoxes.forEach((box) => {
      box.addEventListener('change', () => {
        if (!box.checked) return;
        editTaxBoxes.forEach((other) => {
          if (other !== box) other.checked = false;
        });
      });
    });
    document.getElementById('ap-edit-supplier-cheapest')?.addEventListener('change', () => {
      const wrap = document.getElementById('ap-edit-supplier-reason-wrap');
      if (wrap) wrap.hidden = (document.getElementById('ap-edit-supplier-cheapest') as HTMLSelectElement).value !== 'no';
    });
    syncEditCompliance();
  }

  function setActMsg(text: string, ok: boolean): void {
    const el = document.getElementById('ap-act-msg');
    if (!el) return;
    el.textContent = text;
    el.style.color = ok ? '#1b7f3b' : '#b3261e';
  }

  async function refreshAfterAction(id: number): Promise<void> {
    await loadList();
    await openDrawer(id);
  }

  function wireDrawerActions(item: ApprovalItem): void {
    const msg = (text: string, ok = false) => setActMsg(text, ok);

    document.getElementById('ap-act-finance-approve')?.addEventListener('click', async () => {
      const btn = document.getElementById('ap-act-finance-approve') as HTMLButtonElement | null;
      if (!btn) return;
      btn.disabled = true;
      try {
        const res = await fetch(`/api/approvals/${item.id}/finance-approve`, { method: 'POST' });
        const body = (await res.json()) as { success: boolean; message?: string };
        if (body.success) {
          await refreshAfterAction(item.id);
        } else {
          msg(body.message || 'Could not approve the voucher.');
          btn.disabled = false;
        }
      } catch {
        msg('Network error.');
        btn.disabled = false;
      }
    });

    const financeRejectBox = document.getElementById('ap-finance-reject-box');
    document.getElementById('ap-act-finance-reject')?.addEventListener('click', () => {
      if (financeRejectBox) financeRejectBox.hidden = !financeRejectBox.hidden;
    });
    document.getElementById('ap-act-finance-reject-confirm')?.addEventListener('click', async () => {
      const reasonEl = document.getElementById('ap-finance-reject-reason') as HTMLTextAreaElement | null;
      const reason = reasonEl?.value.trim() || '';
      if (!reason) {
        msg('A reason is required to reject.');
        return;
      }
      try {
        const res = await fetch(`/api/approvals/${item.id}/finance-reject`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ reason }),
        });
        const body = (await res.json()) as { success: boolean; message?: string };
        if (body.success) {
          await refreshAfterAction(item.id);
        } else {
          msg(body.message || 'Could not reject the voucher.');
        }
      } catch {
        msg('Network error.');
      }
    });

    // ---- Paid form (admin, Phase 5) ----
    const paidForm = document.getElementById('ap-paid-form') as HTMLFormElement | null;
    document.getElementById('ap-act-paid')?.addEventListener('click', () => {
      if (paidForm) paidForm.hidden = !paidForm.hidden;
    });
    document.getElementById('ap-paid-cancel')?.addEventListener('click', () => {
      if (paidForm) paidForm.hidden = true;
    });
    paidForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const paidBy = (document.getElementById('ap-paid-by') as HTMLInputElement).value.trim();
      const paidDate = (document.getElementById('ap-paid-date') as HTMLInputElement).value;
      const paymentMethod = (document.getElementById('ap-paid-method') as HTMLSelectElement).value;
      const paymentReference = (document.getElementById('ap-paid-reference') as HTMLInputElement).value.trim();
      if (!paidBy || !paidDate) {
        msg('Record who made the payment and the date.');
        return;
      }
      try {
        const res = await fetch(`/api/approvals/${item.id}/paid`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ paidBy, paidDate, paymentMethod, paymentReference }),
        });
        const body = (await res.json()) as { success: boolean; message?: string };
        if (body.success) {
          await refreshAfterAction(item.id);
        } else {
          msg(body.message || 'Could not record the payment.');
        }
      } catch {
        msg('Network error.');
      }
    });

    // ---- Voucher form (admin, Phase 4) ----
    const voucherForm = document.getElementById('ap-voucher-form') as HTMLFormElement | null;
    const voucherLinesBox = document.getElementById('ap-voucher-lines');

    function addVoucherLine(line?: VoucherLine): void {
      if (!voucherLinesBox) return;
      const row = document.createElement('div');
      row.className = 'ap-vline-row';
      row.innerHTML = `
        <input type="text" class="form-input ap-vline-no" placeholder="No" value="${line?.no ?? ''}" maxlength="2" style="width:3rem;" />
        <input type="date" class="form-input ap-vline-date" value="${esc(line?.date || '')}" style="width:9rem;" />
        <input type="text" class="form-input ap-vline-desc" placeholder="Description" maxlength="500" style="flex:1;min-width:180px;" value="${esc(line?.description || '')}" />
        <input type="number" class="form-input ap-vline-amount" placeholder="Amount" step="0.01" inputmode="decimal" style="width:9rem;" value="${line?.amount ?? ''}" />
        <button type="button" class="ap-file-remove ap-vline-remove" aria-label="Remove line">Remove</button>`;
      row.querySelector('.ap-vline-remove')?.addEventListener('click', () => {
        row.remove();
        updateVoucherTotal();
      });
      voucherLinesBox.appendChild(row);
    }

    function updateVoucherTotal(): void {
      const totalEl = document.getElementById('ap-voucher-total');
      if (!totalEl || !voucherLinesBox) return;
      let total = 0;
      voucherLinesBox.querySelectorAll<HTMLInputElement>('.ap-vline-amount').forEach((inp) => {
        const v = inp.value.trim();
        if (v.length > 0 && Number.isFinite(Number(v))) total += Number(v);
      });
      total = Math.round(total * 100) / 100;
      totalEl.textContent = fmtMoney(total);
    }

    function initVoucherForm(): void {
      if (!voucherLinesBox) return;
      voucherLinesBox.innerHTML = '';
      const existing = parseVoucherLines(item.voucher_lines);
      if (existing.length > 0) {
        existing.forEach((line) => addVoucherLine(line));
      } else {
        // Pre-fill from the item: one line for the title/amount (plan §7).
        addVoucherLine({ no: 1, date: todayIso(), description: item.title, amount: item.requested_amount });
      }
      updateVoucherTotal();
    }

    document.getElementById('ap-act-voucher')?.addEventListener('click', () => {
      if (!voucherForm) return;
      if (voucherForm.hidden) initVoucherForm();
      voucherForm.hidden = !voucherForm.hidden;
    });
    document.getElementById('ap-voucher-cancel')?.addEventListener('click', () => {
      if (voucherForm) voucherForm.hidden = true;
    });
    document.getElementById('ap-voucher-add-line')?.addEventListener('click', () => addVoucherLine());
    voucherLinesBox?.addEventListener('input', updateVoucherTotal);

    voucherForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!voucherLinesBox) return;
      const dateEl = document.getElementById('ap-voucher-date') as HTMLInputElement | null;
      const voucherDate = dateEl?.value || '';
      if (!/^\d{4}-\d{2}-\d{2}$/.test(voucherDate)) {
        msg('Pick a voucher date.');
        return;
      }
      // Required on first submission; the API keeps the stored number when a
      // resubmission omits it (plan §6.4) — the field is prefilled anyway.
      const invoiceNo = (document.getElementById('ap-voucher-invoice') as HTMLInputElement | null)?.value.trim() || '';
      if (!invoiceNo) {
        msg('An invoice or receipt number is required with the voucher.');
        return;
      }
      const lines: VoucherLine[] = [];
      for (const row of Array.from(voucherLinesBox.querySelectorAll('.ap-vline-row'))) {
        const desc = (row.querySelector('.ap-vline-desc') as HTMLInputElement).value.trim();
        const amountRaw = (row.querySelector('.ap-vline-amount') as HTMLInputElement).value.trim();
        if (!desc && !amountRaw) continue; // skip fully-empty rows
        if (!desc) {
          msg('Every voucher line needs a description.');
          return;
        }
        const noRaw = (row.querySelector('.ap-vline-no') as HTMLInputElement).value.trim();
        lines.push({
          no: noRaw === '' ? null : Number(noRaw),
          date: (row.querySelector('.ap-vline-date') as HTMLInputElement).value || null,
          description: desc,
          amount: amountRaw === '' ? null : Number(amountRaw),
        });
      }
      if (lines.length === 0) {
        msg('The voucher needs at least one line.');
        return;
      }
      try {
        const res = await fetch(`/api/approvals/${item.id}/voucher`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ voucherDate, lines, invoiceNo }),
        });
        const body = (await res.json()) as { success: boolean; message?: string };
        if (body.success) {
          await refreshAfterAction(item.id);
        } else {
          msg(body.message || 'Could not submit the voucher.');
        }
      } catch {
        msg('Network error.');
      }
    });

    // ---- AI comparison from the edit form (the only regeneration path —
    //      owner decision 26-08-2026) ----
    const editAiBtn = document.getElementById('ap-edit-ai-run') as HTMLButtonElement | null;
    const editAiMsg = (text: string, ok = false, busy = false): void => {
      const el = document.getElementById('ap-edit-ai-msg');
      if (!el) return;
      if (busy) {
        el.innerHTML = `<span class="ap-spinner" aria-hidden="true"></span>${esc(text)}`;
      } else {
        el.textContent = text;
      }
      el.style.color = busy ? 'var(--text-muted)' : ok ? '#1b7f3b' : '#b3261e';
    };
    editAiBtn?.addEventListener('click', async () => {
      if (editAiBtn.disabled) return;
      editAiBtn.disabled = true;
      editAiMsg('Reading the quotations… this can take up to a minute.', false, true);
      try {
        const res = await fetch(`/api/approvals/${item.id}/analyse`, { method: 'POST' });
        const body = (await res.json()) as { success: boolean; message?: string };
        if (body.success) {
          await refreshAfterAction(item.id);
        } else {
          editAiMsg(body.message || 'The analysis failed.');
          editAiBtn.disabled = false;
        }
      } catch {
        editAiMsg('Network error.');
        editAiBtn.disabled = false;
      }
    });

    document.getElementById('ap-act-approve')?.addEventListener('click', async () => {
      const btn = document.getElementById('ap-act-approve') as HTMLButtonElement | null;
      if (!btn) return;
      btn.disabled = true;
      try {
        const res = await fetch(`/api/approvals/${item.id}/approve`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' });
        const body = (await res.json()) as { success: boolean; message?: string };
        if (body.success) {
          await refreshAfterAction(item.id);
        } else {
          msg(body.message || 'Could not approve.');
          btn.disabled = false;
        }
      } catch {
        msg('Network error.');
        btn.disabled = false;
      }
    });

    const rejectBox = document.getElementById('ap-reject-box');
    document.getElementById('ap-act-reject')?.addEventListener('click', () => {
      if (rejectBox) rejectBox.hidden = !rejectBox.hidden;
    });
    document.getElementById('ap-act-reject-confirm')?.addEventListener('click', async () => {
      const reasonEl = document.getElementById('ap-reject-reason') as HTMLTextAreaElement | null;
      const reason = reasonEl?.value.trim() || '';
      if (!reason) {
        msg('A reason is required to reject.');
        return;
      }
      try {
        const res = await fetch(`/api/approvals/${item.id}/reject`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ reason }),
        });
        const body = (await res.json()) as { success: boolean; message?: string };
        if (body.success) {
          await refreshAfterAction(item.id);
        } else {
          msg(body.message || 'Could not reject.');
        }
      } catch {
        msg('Network error.');
      }
    });

    document.getElementById('ap-act-remind')?.addEventListener('click', async () => {
      const btn = document.getElementById('ap-act-remind') as HTMLButtonElement | null;
      if (!btn) return;
      btn.disabled = true;
      try {
        const res = await fetch(`/api/approvals/${item.id}/remind`, { method: 'POST' });
        const body = (await res.json()) as { success: boolean; message?: string };
        if (body.success) {
          msg('Reminder sent.', true);
        } else {
          msg(body.message || 'Could not send the reminder.');
          btn.disabled = false;
        }
      } catch {
        msg('Network error.');
        btn.disabled = false;
      }
    });

    const editForm = document.getElementById('ap-edit-form') as HTMLFormElement | null;
    document.getElementById('ap-act-edit')?.addEventListener('click', () => {
      if (editForm) editForm.hidden = !editForm.hidden;
    });
    document.getElementById('ap-edit-cancel')?.addEventListener('click', () => {
      if (editForm) editForm.hidden = true;
    });
    editForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const form = new FormData();
      form.append('title', (document.getElementById('ap-edit-title') as HTMLInputElement).value.trim());
      form.append('payee', (document.getElementById('ap-edit-payee') as HTMLInputElement).value.trim());
      form.append('requestedAmount', (document.getElementById('ap-edit-amount') as HTMLInputElement).value.trim());
      form.append('description', (document.getElementById('ap-edit-description') as HTMLTextAreaElement).value.trim());
      const filesInput = document.getElementById('ap-edit-files') as HTMLInputElement | null;
      for (const file of Array.from(filesInput?.files || [])) form.append('files', file);
      // AI text edits (owner decision 26-08-2026): the textareas exist only
      // when the item has a stored analysis; the server freezes them with the
      // other fields once the item leaves the editable states.
      const aiSummaryEl = document.getElementById('ap-edit-ai-summary') as HTMLTextAreaElement | null;
      const aiRecoEl = document.getElementById('ap-edit-ai-reco') as HTMLTextAreaElement | null;
      if (aiSummaryEl) form.append('aiSummary', aiSummaryEl.value);
      if (aiRecoEl) form.append('aiRecommendation', aiRecoEl.value);
      // Compliance evidence (plan §7.1): sent only while the declarations
      // block is visible (effective amount ≥ S$1,000) — absent fields keep
      // their stored values server-side.
      const editCompliance = document.getElementById('ap-edit-compliance');
      const gv = (id: string): string => (document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | null)?.value.trim() || '';
      const gc = (id: string): boolean => (document.getElementById(id) as HTMLInputElement | null)?.checked || false;
      const gs = (id: string): string => (document.getElementById(id) as HTMLSelectElement | null)?.value || '';
      if (editCompliance && editCompliance.style.display !== 'none') {
        form.append('boardApprovalRef', gv('ap-edit-board-ref'));
        form.append('quotationWaiverReason', gv('ap-edit-waiver'));
        form.append('supplierIsCheapest', gs('ap-edit-supplier-cheapest'));
        form.append('supplierChoiceReason', gv('ap-edit-supplier-reason'));
        if (gc('ap-edit-budget-approved')) form.append('budgetApproved', 'true');
        form.append('budgetAmount', gv('ap-edit-budget-amount'));
        form.append('budgetOfficer', gv('ap-edit-budget-officer'));
        form.append('budgetDate', gv('ap-edit-budget-date'));
        if (gc('ap-edit-coi-declared')) form.append('coiDeclared', 'true');
        if (gc('ap-edit-no-split-declared')) form.append('noSplitDeclared', 'true');
      }
      // R7: the ticked Tax Invoice (existing attachment id; empty = none).
      const editTax = document.querySelector<HTMLInputElement>('input.ap-edit-tax:checked');
      if (editTax?.dataset.att) form.append('taxInvoiceAttachmentId', editTax.dataset.att);
      const resubmit = document.getElementById('ap-edit-resubmit') as HTMLInputElement | null;
      if (resubmit?.checked) form.append('resubmit', 'true');
      try {
        const res = await fetch(`/api/approvals/${item.id}/edit`, { method: 'POST', body: form });
        const body = (await res.json()) as { success: boolean; message?: string };
        if (body.success) {
          await refreshAfterAction(item.id);
        } else {
          msg(body.message || 'Could not save the edit.');
        }
      } catch {
        msg('Network error.');
      }
    });
  }

  function closeDrawer(): void {
    const overlay = document.getElementById('ap-drawer-overlay');
    if (overlay) overlay.setAttribute('hidden', '');
    document.body.style.overflow = '';
  }

  document.getElementById('ap-drawer-close')?.addEventListener('click', closeDrawer);
  document.getElementById('ap-drawer-overlay')?.addEventListener('click', (event) => {
    if (event.target === document.getElementById('ap-drawer-overlay')) closeDrawer();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeDrawer();
  });

  // ---- Create form ------------------------------------------------------

  const categorySelect = document.getElementById('ap-category') as HTMLSelectElement | null;
  const approvalCheck = document.getElementById('ap-approval-required') as HTMLInputElement | null;
  const fileInput = document.getElementById('ap-files') as HTMLInputElement | null;
  const comparisonToggleWrap = document.getElementById('ap-comparison-toggle-wrap');
  const comparisonToggle = document.getElementById('ap-comparison-toggle') as HTMLInputElement | null;
  const comparisonRows = document.getElementById('ap-comparison-rows');
  const comparisonBuilder = document.getElementById('ap-comparison-builder');

  // ---- Chosen-files list ------------------------------------------------
  // The native file picker replaces its selection on every visit, which
  // forces users to grab everything in one go. Instead, every pick is
  // APPENDED to this list (dupes and cap breaches rejected inline) and the
  // input is cleared so the same file can be re-picked deliberately.
  const MAX_FILES = 10; // must match APPROVAL_MAX_FILES_PER_ITEM (portal.ts)
  const MAX_FILE_BYTES = 10 * 1024 * 1024; // must match APPROVAL_MAX_FILE_BYTES
  let chosenFiles: File[] = [];
  // Typed comparison text, tick states and quotation dates survive file list
  // changes, keyed by name|size so adding or removing a file keeps the
  // others' text.
  const comparisonDraft = new Map<string, { include: boolean; desc: string; quoteDate: string }>();
  // R7: the file ticked as the Tax Invoice (name; one per item — ticking one
  // clears the other).
  let taxInvoicePick = '';

  // ---- AI analysis state (form-time preview) -----------------------------
  // aiPreview holds the analysis the analyse-preview endpoint returned; it is
  // replayed with the form on submit and invalidated whenever the chosen
  // quotations change (plan §4.6 layer 5: reuse, never re-run silently).
  let aiPreview: AiAnalysis | null = null;

  function invalidateAiPreview(reason?: string): void {
    if (!aiPreview) {
      const box = document.getElementById('ap-ai-preview');
      if (box) box.hidden = true;
      return;
    }
    aiPreview = null;
    const box = document.getElementById('ap-ai-preview');
    if (box) {
      box.hidden = true;
      box.innerHTML = '';
    }
    setAiMsg(reason || '', 'var(--text-muted)');
  }

  function setAiMsg(text: string, color = 'var(--text-muted)', busy = false): void {
    const el = document.getElementById('ap-ai-msg');
    if (!el) return;
    if (busy) {
      el.innerHTML = `<span class="ap-spinner" aria-hidden="true"></span>${esc(text)}`;
    } else {
      el.textContent = text;
    }
    el.style.color = color;
  }

  // HEIC photos (iPhone) cannot be read by the vision model, so they are
  // converted to JPEG in the browser at pick time — same canvas pattern as
  // the membership register page. If the browser cannot decode HEIC (e.g.
  // Chrome), the file is kept as-is and the analysis reports it as unread.
  async function maybeConvertHeic(file: File): Promise<File> {
    if (file.type !== 'image/heic' && file.type !== 'image/heif') return file;
    try {
      const bitmap = await createImageBitmap(file);
      const canvas = document.createElement('canvas');
      canvas.width = bitmap.width;
      canvas.height = bitmap.height;
      const ctx = canvas.getContext('2d');
      if (!ctx) return file;
      ctx.drawImage(bitmap, 0, 0);
      bitmap.close();
      const blob = await new Promise<Blob | null>((resolve) => canvas.toBlob(resolve, 'image/jpeg', 0.85));
      if (!blob) return file;
      return new File([blob], file.name.replace(/\.hei[cf]$/i, '.jpg'), { type: 'image/jpeg' });
    } catch {
      return file;
    }
  }

  function keyOf(file: File): string {
    return `${file.name}|${file.size}`;
  }

  function showFilesMsg(text: string): void {
    const el = document.getElementById('ap-files-msg');
    if (!el) return;
    el.textContent = text;
    el.hidden = !text;
  }

  function renderFilesList(): void {
    const list = document.getElementById('ap-files-list');
    if (!list) return;
    if (chosenFiles.length === 0) {
      list.innerHTML = '';
      return;
    }
    list.innerHTML =
      chosenFiles
        .map(
          (file, index) => `<div class="ap-file-row">
            <span class="ap-comp-name">
              <label class="ap-check" style="display:inline-flex;align-items:center;gap:0.35rem;font-size:0.78rem;color:var(--text-muted);">
                <input type="checkbox" class="ap-tax-invoice" data-name="${esc(file.name)}" ${taxInvoicePick === file.name ? 'checked' : ''} />
                <span>This is the Tax Invoice</span>
              </label>
              <br />${esc(file.name)} (${esc(fmtSize(file.size))})
            </span>
            <button type="button" class="ap-file-remove" data-index="${index}" aria-label="Remove ${esc(file.name)}">Remove</button>
          </div>`,
        )
        .join('') +
      `<p style="margin:0.25rem 0 0;color:var(--text-muted);font-size:0.78rem;">${chosenFiles.length} of ${MAX_FILES} files</p>`;
    list.querySelectorAll<HTMLButtonElement>('.ap-file-remove').forEach((btn) => {
      btn.addEventListener('click', () => {
        const index = Number(btn.dataset.index);
        const [removed] = chosenFiles.splice(index, 1);
        if (removed) {
          comparisonDraft.delete(keyOf(removed));
          if (taxInvoicePick === removed.name) taxInvoicePick = '';
        }
        invalidateAiPreview('Quotations changed — run the analysis again.');
        showFilesMsg('');
        renderFilesList();
        renderComparisonBuilder();
      });
    });
    // R7: ticking one Tax Invoice clears the others (one per item).
    list.querySelectorAll<HTMLInputElement>('.ap-tax-invoice').forEach((box) => {
      box.addEventListener('change', () => {
        const name = box.dataset.name || '';
        if (box.checked) {
          taxInvoicePick = name;
          list.querySelectorAll<HTMLInputElement>('.ap-tax-invoice').forEach((other) => {
            if (other !== box) other.checked = false;
          });
        } else if (taxInvoicePick === name) {
          taxInvoicePick = '';
        }
      });
    });
  }

  fileInput?.addEventListener('change', async () => {
    if (!fileInput) return;
    const picked = Array.from(fileInput.files || []);
    fileInput.value = '';
    for (const raw of picked) {
      const file = await maybeConvertHeic(raw);
      if (chosenFiles.some((f) => keyOf(f) === keyOf(file))) {
        showFilesMsg(`"${file.name}" is already in the list.`);
        continue;
      }
      if (file.size > MAX_FILE_BYTES) {
        showFilesMsg(`"${file.name}" is larger than 10 MB and was not added.`);
        continue;
      }
      if (chosenFiles.length >= MAX_FILES) {
        showFilesMsg(`At most ${MAX_FILES} files per item.`);
        break;
      }
      invalidateAiPreview('Quotations changed — run the analysis again.');
      chosenFiles.push(file);
    }
    renderFilesList();
    renderComparisonBuilder();
  });

  function syncApprovalDefault(): void {
    if (!categorySelect || !approvalCheck) return;
    const option = categorySelect.selectedOptions[0];
    approvalCheck.checked = option?.dataset.requiresApproval !== 'false';
  }

  categorySelect?.addEventListener('change', syncApprovalDefault);

  function renderComparisonBuilder(): void {
    if (!comparisonRows || !comparisonBuilder || !comparisonToggleWrap || !comparisonToggle) return;
    const aiBox = document.getElementById('ap-ai-box');
    const aiRun = document.getElementById('ap-ai-run') as HTMLButtonElement | null;
    if (chosenFiles.length === 0) {
      // No files: hide everything comparison-related and clear the toggle.
      comparisonToggleWrap.hidden = true;
      comparisonToggle.checked = false;
      comparisonBuilder.hidden = true;
      comparisonRows.innerHTML = '';
      if (aiBox) aiBox.hidden = true;
      return;
    }
    comparisonToggleWrap.hidden = false;
    if (!comparisonToggle.checked) {
      comparisonBuilder.hidden = true;
      comparisonRows.innerHTML = '';
      if (aiBox) aiBox.hidden = true;
      return;
    }
    comparisonBuilder.hidden = false;
    // The AI box appears with the builder when the feature is on. Disabled
    // still shows a short note (owner decision: visible off-state, no button).
    if (aiBox) {
      aiBox.hidden = false;
      if (sessionData && sessionData.ai_comparison_enabled === false) {
        if (aiRun) aiRun.hidden = true;
        setAiMsg('AI comparison is disabled by an IT administrator.');
      } else {
        if (aiRun) aiRun.hidden = false;
        if (!aiPreview) setAiMsg('Optional: let AI read the ticked quotations and compare them.');
      }
    }
    comparisonRows.innerHTML = chosenFiles
      .map((file, index) => {
        const draft = comparisonDraft.get(keyOf(file));
        const include = draft ? draft.include : true;
        const desc = draft ? draft.desc : '';
        const quoteDate = draft ? draft.quoteDate : '';
        return `<div class="ap-comp-row">
          <input type="checkbox" id="ap-comp-include-${index}" data-key="${esc(keyOf(file))}" ${include ? 'checked' : ''} />
          <label for="ap-comp-include-${index}" class="ap-comp-name">${esc(file.name)} (${esc(fmtSize(file.size))})</label>
          <input type="text" class="form-input" data-desc="${index}" data-key="${esc(keyOf(file))}" style="flex:1;min-width:200px;" maxlength="500" value="${esc(desc)}" placeholder="e.g. Grand Copthorne — S$1,350/table, 25 tables" />
          <input type="date" class="form-input" data-quote="${index}" data-key="${esc(keyOf(file))}" style="width:9.5rem;" value="${esc(quoteDate)}" title="Quotation date (optional)" />
        </div>`;
      })
      .join('');

    // Persist edits into the drafts so the next re-render (a file added or
    // removed) restores what was typed. Any edit invalidates a stale AI
    // preview — the analysis must always match the ticked set.
    comparisonRows.querySelectorAll<HTMLInputElement>('input[type="checkbox"]').forEach((box) => {
      box.addEventListener('change', () => {
        const key = box.dataset.key || '';
        const draft = comparisonDraft.get(key) || { include: true, desc: '', quoteDate: '' };
        draft.include = box.checked;
        comparisonDraft.set(key, draft);
        invalidateAiPreview('Quotations changed — run the analysis again.');
        updateComplianceVisibility();
      });
    });
    comparisonRows.querySelectorAll<HTMLInputElement>('input[data-desc]').forEach((inp) => {
      inp.addEventListener('input', () => {
        const key = inp.dataset.key || '';
        const draft = comparisonDraft.get(key) || { include: true, desc: '', quoteDate: '' };
        draft.desc = inp.value;
        comparisonDraft.set(key, draft);
      });
    });
    comparisonRows.querySelectorAll<HTMLInputElement>('input[data-quote]').forEach((inp) => {
      inp.addEventListener('change', () => {
        const key = inp.dataset.key || '';
        const draft = comparisonDraft.get(key) || { include: true, desc: '', quoteDate: '' };
        draft.quoteDate = inp.value;
        comparisonDraft.set(key, draft);
      });
    });
    updateComplianceVisibility();
  }

  // Ticked comparison rows among the chosen files — drives the waiver-reason
  // visibility (two rows or a reason, plan §7.1). Approximate on purpose:
  // the server counts the rows it actually stores.
  function tickedComparisonCount(): number {
    if (!comparisonToggle?.checked || !comparisonRows) return 0;
    let n = 0;
    comparisonRows.querySelectorAll<HTMLInputElement>('input[type="checkbox"]').forEach((box) => {
      if (box.checked) n += 1;
    });
    return n;
  }

  function typedCreateAmount(): number | null {
    const raw = (document.getElementById('ap-amount') as HTMLInputElement | null)?.value.trim() || '';
    if (!raw) return null;
    const n = Number(raw);
    return Number.isFinite(n) && n > 0 ? n : null;
  }

  /** Compliance card visibility, live by the typed amount (plan §7.4). */
  function updateComplianceVisibility(): void {
    const box = document.getElementById('ap-compliance-box');
    if (!box) return;
    const amt = typedCreateAmount();
    const show = amt !== null && amt >= APPROVAL_QUOTE_RULE_THRESHOLD;
    box.style.display = show ? '' : 'none';
    if (!show) return;
    const waiverWrap = document.getElementById('ap-waiver-wrap');
    if (waiverWrap) waiverWrap.hidden = tickedComparisonCount() >= 2;
    const inv = document.getElementById('ap-invitation-reminder');
    if (inv) inv.style.display = amt >= APPROVAL_INVITATION_REMINDER_THRESHOLD && amt <= APPROVAL_TENDER_REMINDER_THRESHOLD ? '' : 'none';
    const tender = document.getElementById('ap-tender-reminder');
    if (tender) tender.style.display = amt > APPROVAL_TENDER_REMINDER_THRESHOLD ? '' : 'none';
    const board = document.getElementById('ap-board-box');
    if (board) board.style.display = amt >= APPROVAL_BOARD_APPROVAL_THRESHOLD ? '' : 'none';
  }

  document.getElementById('ap-amount')?.addEventListener('input', updateComplianceVisibility);
  document.getElementById('ap-supplier-cheapest')?.addEventListener('change', () => {
    const wrap = document.getElementById('ap-supplier-reason-wrap');
    if (wrap) wrap.hidden = (document.getElementById('ap-supplier-cheapest') as HTMLSelectElement).value !== 'no';
  });

  comparisonToggle?.addEventListener('change', () => {
    invalidateAiPreview();
    renderComparisonBuilder();
  });

  // ---- AI analysis: run + preview + replay on submit ----------------------

  function tickedQuotationFiles(): File[] {
    if (!comparisonToggle?.checked || !comparisonRows) return [];
    const files: File[] = [];
    comparisonRows.querySelectorAll<HTMLInputElement>('input[type="checkbox"]').forEach((box) => {
      if (!box.checked) return;
      const file = chosenFiles.find((f) => keyOf(f) === (box.dataset.key || ''));
      if (file) files.push(file);
    });
    return files;
  }

  // editable=true renders the summary/recommendation as textareas (create
  // form preview + edit form — owner decision 26-08-2026: the AI texts are
  // fields like any other, editable until the item is submitted for approval,
  // frozen after). editable=false renders read-only text (drawer).
  function renderAiAnalysisBlock(analysis: AiAnalysis, opts?: { summaryId?: string; recoId?: string }): string {
    const editable = Boolean(opts?.summaryId);
    const rows = analysis.quotes
      .map((q) => {
        const original = q.totalPrice !== null ? `${q.currency || ''} ${q.totalPrice.toLocaleString('en-SG', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`.trim() : '—';
        return `<tr>
          <td>${esc(q.vendor || '—')}</td>
          <td>${esc(q.itemName || q.filename)}</td>
          <td>${esc(original)}</td>
          <td>${q.totalPriceSgd !== null ? esc(fmtMoney(q.totalPriceSgd)) : '—'}</td>
          <td>${esc(q.gst || '—')}</td>
          <td>${esc(q.leadTime || '—')}</td>
        </tr>`;
      })
      .join('');
    const problemFiles = analysis.files
      .filter((f) => f.status !== 'ok')
      .map((f) => `<li>${esc(f.filename)} — ${esc(f.note || 'could not be read')}</li>`)
      .join('');
    const summaryHtml = editable
      ? `<label class="ap-field" style="margin:0.6rem 0 0;">
          <span>Summary (editable until submitted for approval)</span>
          <textarea id="${esc(opts!.summaryId!)}" class="form-input" rows="4" maxlength="4000">${esc(analysis.summary || '')}</textarea>
        </label>
        <label class="ap-field" style="margin:0.5rem 0 0;">
          <span>Recommendation</span>
          <textarea id="${esc(opts!.recoId!)}" class="form-input" rows="2" maxlength="1000">${esc(analysis.recommendation || '')}</textarea>
        </label>`
      : `${analysis.summary ? `<p style="margin:0.6rem 0 0;">${esc(analysis.summary)}</p>` : ''}
        ${analysis.recommendation ? `<p class="ap-ai-reco">Recommendation: ${esc(analysis.recommendation)}</p>` : ''}`;
    return `<h4>AI comparison <span style="font-weight:400;font-size:0.75rem;color:var(--text-muted);">(generated ${esc(fmtDateSg(analysis.generatedAt))})</span></h4>
      <table class="ap-comparison-table">
        <thead><tr><th>Vendor</th><th>Item</th><th>Quoted total</th><th>Total (S$)</th><th>GST</th><th>Lead time</th></tr></thead>
        <tbody>${rows}</tbody>
      </table>
      ${summaryHtml}
      ${problemFiles ? `<ul style="margin:0.6rem 0 0;padding-left:1.1rem;color:var(--text-muted);font-size:0.78rem;">${problemFiles}</ul>` : ''}
      <p class="ap-ai-meta">FX rates dated ${esc(analysis.fx?.date || 'unavailable')}${analysis.fx ? ' via open.er-api.com' : ' — amounts not converted'}. AI-generated — verify against the original documents.</p>`;
  }

  document.getElementById('ap-ai-run')?.addEventListener('click', async () => {
    const btn = document.getElementById('ap-ai-run') as HTMLButtonElement | null;
    if (!btn || btn.disabled) return;
    const files = tickedQuotationFiles();
    if (files.length < 2) {
      setAiMsg('Tick at least two quotations to compare.', '#b3261e');
      return;
    }
    // In-flight lock (plan §4.6 layer 1): one click, one paid run.
    btn.disabled = true;
    setAiMsg('Reading the quotations… this can take up to a minute.', 'var(--text-muted)', true);
    const form = new FormData();
    for (const file of files) form.append('files', file);
    try {
      const res = await fetch('/api/approvals/analyse-preview', { method: 'POST', body: form });
      const body = (await res.json()) as { success: boolean; analysis?: AiAnalysis; message?: string };
      if (res.ok && body.success && body.analysis) {
        aiPreview = body.analysis;
        const box = document.getElementById('ap-ai-preview');
        if (box) {
          box.innerHTML = renderAiAnalysisBlock(aiPreview, { summaryId: 'ap-ai-summary', recoId: 'ap-ai-reco' });
          box.hidden = false;
        }
        setAiMsg('The analysis will be saved with the request.', '#1b7f3b');
      } else {
        setAiMsg(body.message || 'The analysis failed. Please try again.', '#b3261e');
      }
    } catch {
      setAiMsg('Network error. Please try again.', '#b3261e');
    } finally {
      btn.disabled = false;
    }
  });

  // ---- Create-form toggle ----------------------------------------------
  // The board table leads the page (owner decision 25-08-2026): the form
  // only appears when the admin clicks "New request" and collapses again on
  // Cancel or a successful submit.

  function openCreateForm(): void {
    if (createBarMsg) createBarMsg.textContent = '';
    if (createBar) createBar.style.display = 'none';
    if (createCard) createCard.style.display = '';
  }

  function resetCreateForm(): void {
    const form = document.getElementById('ap-create-form') as HTMLFormElement | null;
    form?.reset();
    chosenFiles = [];
    comparisonDraft.clear();
    aiPreview = null;
    taxInvoicePick = '';
    const supplierReasonWrap = document.getElementById('ap-supplier-reason-wrap');
    if (supplierReasonWrap) supplierReasonWrap.hidden = true;
    const waiverWrap = document.getElementById('ap-waiver-wrap');
    if (waiverWrap) waiverWrap.hidden = true;
    const previewBox = document.getElementById('ap-ai-preview');
    if (previewBox) {
      previewBox.hidden = true;
      previewBox.innerHTML = '';
    }
    setAiMsg('');
    showFilesMsg('');
    renderFilesList();
    renderComparisonBuilder();
    syncApprovalDefault();
    const msg = document.getElementById('ap-create-msg');
    if (msg) msg.textContent = '';
  }

  function closeCreateForm(): void {
    if (createCard) createCard.style.display = 'none';
    if (createBar) createBar.style.display = 'flex';
    resetCreateForm();
  }

  const createCard = document.getElementById('ap-create-card');
  const createBar = document.getElementById('ap-create-bar');
  const createBarMsg = document.getElementById('ap-create-bar-msg');
  document.getElementById('ap-create-open')?.addEventListener('click', openCreateForm);
  document.getElementById('ap-create-cancel')?.addEventListener('click', closeCreateForm);

  document.getElementById('ap-create-form')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const msg = document.getElementById('ap-create-msg');
    const submit = document.getElementById('ap-create-submit') as HTMLButtonElement | null;
    if (!msg || !submit) return;
    msg.textContent = '';
    msg.style.color = 'var(--text-muted)';

    // Approvers decide remotely from the uploaded files: an approval-required
    // request must carry at least one document (owner decision 29-08-2026).
    if (approvalCheck?.checked && chosenFiles.length === 0) {
      msg.style.color = '#b3261e';
      msg.textContent = 'Attach at least one document (quotation, invoice or photo), or uncheck "Approval required" for paperless recurring items.';
      return;
    }

    // Compliance declarations (plan §7.4): the card only shows at S$1,000+.
    // Client-side help — the server re-validates everything.
    const complianceBox = document.getElementById('ap-compliance-box');
    const val = (id: string): string => (document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | null)?.value.trim() || '';
    const sel = (id: string): string => (document.getElementById(id) as HTMLSelectElement | null)?.value || '';
    const tick = (id: string): boolean => (document.getElementById(id) as HTMLInputElement | null)?.checked || false;
    if (complianceBox && complianceBox.style.display !== 'none') {
      const missing: string[] = [];
      if (tickedComparisonCount() < 2 && !val('ap-waiver-reason')) missing.push('a waiver reason, or two rows in the comparison table');
      if (!tick('ap-budget-approved')) missing.push('the budget tick');
      if (!val('ap-budget-amount')) missing.push('the budget amount');
      if (!val('ap-budget-officer')) missing.push('the budget approving officer');
      if (!val('ap-budget-date')) missing.push('the budget approval date');
      if (!tick('ap-coi-declared')) missing.push('the conflict-of-interest tick');
      if (!tick('ap-no-split-declared')) missing.push('the no-splitting tick');
      if (!sel('ap-supplier-cheapest')) missing.push('the cheapest-supplier answer');
      if (sel('ap-supplier-cheapest') === 'no' && !val('ap-supplier-reason')) missing.push('the reason for not choosing the cheapest');
      if (missing.length > 0) {
        msg.style.color = '#b3261e';
        msg.textContent = `Complete the declarations: ${missing.join('; ')}.`;
        return;
      }
    }

    const form = new FormData();
    if (categorySelect) form.append('category', categorySelect.value);
    form.append('title', (document.getElementById('ap-title') as HTMLInputElement).value.trim());
    form.append('payee', (document.getElementById('ap-payee') as HTMLInputElement).value.trim());
    form.append('requestedAmount', (document.getElementById('ap-amount') as HTMLInputElement).value.trim());
    const descriptionEl = document.getElementById('ap-description') as HTMLTextAreaElement | null;
    if (descriptionEl) form.append('description', descriptionEl.value.trim());
    if (approvalCheck) form.append('approvalRequired', approvalCheck.checked ? 'true' : 'false');

    for (const file of chosenFiles) form.append('files', file);

    const comparison: Array<{ file: string; description: string; quoteDate?: string }> = [];
    if (comparisonToggle?.checked) {
      comparisonRows?.querySelectorAll<HTMLInputElement>('input[type="checkbox"]').forEach((box) => {
        if (!box.checked) return;
        const key = box.dataset.key || '';
        const file = chosenFiles.find((f) => keyOf(f) === key);
        if (!file) return;
        const row = box.closest('.ap-comp-row');
        const desc = row?.querySelector<HTMLInputElement>('input[data-desc]')?.value.trim() || '';
        const quote = row?.querySelector<HTMLInputElement>('input[data-quote]')?.value || '';
        if (desc) {
          const entry: { file: string; description: string; quoteDate?: string } = { file: file.name, description: desc };
          if (quote) entry.quoteDate = quote;
          comparison.push(entry);
        }
      });
    }
    if (comparison.length > 0) form.append('comparison', JSON.stringify(comparison));
    // R7: the Tax Invoice tick rides the same POST (empty = none marked).
    if (taxInvoicePick) form.append('taxInvoice', taxInvoicePick);
    // Compliance evidence fields ride the same POST (plan §7.1). Empty
    // strings parse to null server-side; absent ticks stay false.
    if (complianceBox && complianceBox.style.display !== 'none') {
      form.append('boardApprovalRef', val('ap-board-ref'));
      form.append('quotationWaiverReason', val('ap-waiver-reason'));
      form.append('supplierIsCheapest', sel('ap-supplier-cheapest'));
      form.append('supplierChoiceReason', val('ap-supplier-reason'));
      if (tick('ap-budget-approved')) form.append('budgetApproved', 'true');
      form.append('budgetAmount', val('ap-budget-amount'));
      form.append('budgetOfficer', val('ap-budget-officer'));
      form.append('budgetDate', val('ap-budget-date'));
      if (tick('ap-coi-declared')) form.append('coiDeclared', 'true');
      if (tick('ap-no-split-declared')) form.append('noSplitDeclared', 'true');
    }
    // Replay the previewed AI analysis with the request (plan §4.3): the
    // create endpoint never calls AI itself. The summary/recommendation
    // textareas carry any manual edits made to the AI text. Saved whenever a
    // preview exists — the typed comparison table (which needs per-file
    // descriptions) is independent; with AI doing the comparing, empty
    // descriptions must not silently drop the analysis (bug 27-08-2026).
    if (aiPreview) {
      const summaryEl = document.getElementById('ap-ai-summary') as HTMLTextAreaElement | null;
      const recoEl = document.getElementById('ap-ai-reco') as HTMLTextAreaElement | null;
      if (summaryEl) aiPreview.summary = summaryEl.value.trim() || null;
      if (recoEl) aiPreview.recommendation = recoEl.value.trim() || null;
      form.append('aiComparison', JSON.stringify(aiPreview));
    }

    submit.disabled = true;
    try {
      const res = await fetch('/api/approvals', { method: 'POST', body: form });
      const body = (await res.json()) as { success: boolean; message?: string };
      if (res.ok && body.success) {
        resetCreateForm();
        // Collapse back to the button row and confirm near the button —
        // the form itself is hidden at this point.
        if (createCard) createCard.style.display = 'none';
        if (createBar) createBar.style.display = 'flex';
        if (createBarMsg) createBarMsg.textContent = 'Request raised.';
        await loadList();
      } else {
        msg.style.color = '#b3261e';
        msg.textContent = body.message || 'Could not raise the request.';
      }
    } catch {
      msg.style.color = '#b3261e';
      msg.textContent = 'Network error. Please try again.';
    } finally {
      submit.disabled = false;
    }
  });

  // ---- Boot -------------------------------------------------------------

  requireAuth({
    onAuthenticated(data: SessionResponse) {
      sessionData = data;
      // Admins get the "New request" button row; the form card itself stays
      // closed until the button is clicked. Approver sessions see neither.
      const bar = document.getElementById('ap-create-bar');
      if (bar) bar.style.display = data.is_admin ? 'flex' : 'none';
      syncApprovalDefault();
      void loadList().then(() => {
        // Deep link from approval emails: /approvals?item=<id>
        const deep = new URLSearchParams(window.location.search).get('item');
        if (deep && /^\d+$/.test(deep)) {
          const exists = allItems.some((i) => i.id === Number(deep)) || counts.all > 0;
          if (exists) void openDrawer(Number(deep));
        }
      });
    },
  });
</script>
