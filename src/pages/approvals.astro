      } catch {
        msg('Network error.');
      }
    });

    // ---- Voucher form (admin, Phase 4) ----
    const voucherForm = document.getElementById('ap-voucher-form') as HTMLFormElement | null;
    const voucherLinesBox = document.getElementById('ap-voucher-lines');

    function addVoucherLine(line?: VoucherLine): void {
      if (!voucherLinesBox) return;
      const row = document.createElement('div');
      row.className = 'ap-vline-row';
      row.innerHTML = `
        <input type="text" class="form-input ap-vline-no" placeholder="No" value="${line?.no ?? ''}" maxlength="2" style="width:3rem;" />
        <input type="date" class="form-input ap-vline-date" value="${esc(line?.date || '')}" style="width:9rem;" />
        <input type="text" class="form-input ap-vline-desc" placeholder="Description" maxlength="500" style="flex:1;min-width:180px;" value="${esc(line?.description || '')}" />
        <input type="number" class="form-input ap-vline-amount" placeholder="Amount" step="0.01" inputmode="decimal" style="width:9rem;" value="${line?.amount ?? ''}" />
        <button type="button" class="ap-file-remove ap-vline-remove" aria-label="Remove line">Remove</button>`;
      row.querySelector('.ap-vline-remove')?.addEventListener('click', () => {
        row.remove();
