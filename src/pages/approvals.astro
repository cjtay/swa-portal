        const body = (await res.json()) as { success: boolean; message?: string };
        if (body.success) {
          await refreshAfterAction(item.id);
        } else {
          msg(body.message || 'Could not save the edit.');
        }
      } catch {
        msg('Network error.');
      }
    });
