  // ---- Create form ------------------------------------------------------

  const categorySelect = document.getElementById('ap-category') as HTMLSelectElement | null;
  const approvalCheck = document.getElementById('ap-approval-required') as HTMLInputElement | null;
  const fileInput = document.getElementById('ap-files') as HTMLInputElement | null;
  const comparisonToggleWrap = document.getElementById('ap-comparison-toggle-wrap');
  const comparisonToggle = document.getElementById('ap-comparison-toggle') as HTMLInputElement | null;
  const comparisonRows = document.getElementById('ap-comparison-rows');
  const comparisonBuilder = document.getElementById('ap-comparison-builder');

  // ---- Chosen-files list ------------------------------------------------
  // The native file picker replaces its selection on every visit, which
  // forces users to grab everything in one go. Instead, every pick is
  // APPENDED to this list (dupes and cap breaches rejected inline) and the
  // input is cleared so the same file can be re-picked deliberately.
  const MAX_FILES = 10; // must match APPROVAL_MAX_FILES_PER_ITEM (portal.ts)
  const MAX_FILE_BYTES = 10 * 1024 * 1024; // must match APPROVAL_MAX_FILE_BYTES
  let chosenFiles: File[] = [];
  // Typed comparison text and tick states survive file list changes,
  // keyed by name|size so adding or removing a file keeps the others' text.
  const comparisonDraft = new Map<string, { include: boolean; desc: string }>();

  // ---- AI analysis state (form-time preview) -----------------------------
  // aiPreview holds the analysis the analyse-preview endpoint returned; it is
  // replayed with the form on submit and invalidated whenever the chosen
  // quotations change (plan §4.6 layer 5: reuse, never re-run silently).
  let aiPreview: AiAnalysis | null = null;

  function invalidateAiPreview(reason?: string): void {
    if (!aiPreview) {
      const box = document.getElementById('ap-ai-preview');
      if (box) box.hidden = true;
      return;
    }
    aiPreview = null;
    const box = document.getElementById('ap-ai-preview');
    if (box) {
      box.hidden = true;
      box.innerHTML = '';
    }
    setAiMsg(reason || '', 'var(--text-muted)');
  }

  function setAiMsg(text: string, color = 'var(--text-muted)', busy = false): void {
    const el = document.getElementById('ap-ai-msg');
    if (!el) return;
    if (busy) {
      el.innerHTML = `<span class="ap-spinner" aria-hidden="true"></span>${esc(text)}`;
    } else {
      el.textContent = text;
    }
    el.style.color = color;
  }

  // HEIC photos (iPhone) cannot be read by the vision model, so they are
  // converted to JPEG in the browser at pick time — same canvas pattern as
  // the membership register page. If the browser cannot decode HEIC (e.g.
  // Chrome), the file is kept as-is and the analysis reports it as unread.
  async function maybeConvertHeic(file: File): Promise<File> {
    if (file.type !== 'image/heic' && file.type !== 'image/heif') return file;
    try {
      const bitmap = await createImageBitmap(file);
      const canvas = document.createElement('canvas');
      canvas.width = bitmap.width;
      canvas.height = bitmap.height;
      const ctx = canvas.getContext('2d');
      if (!ctx) return file;
      ctx.drawImage(bitmap, 0, 0);
      bitmap.close();
      const blob = await new Promise<Blob | null>((resolve) => canvas.toBlob(resolve, 'image/jpeg', 0.85));
      if (!blob) return file;
      return new File([blob], file.name.replace(/\.hei[cf]$/i, '.jpg'), { type: 'image/jpeg' });
    } catch {
      return file;
    }
  }

  function keyOf(file: File): string {
    return `${file.name}|${file.size}`;
  }

  function showFilesMsg(text: string): void {
    const el = document.getElementById('ap-files-msg');
    if (!el) return;
    el.textContent = text;
    el.hidden = !text;
  }

  function renderFilesList(): void {
    const list = document.getElementById('ap-files-list');
    if (!list) return;
    if (chosenFiles.length === 0) {
      list.innerHTML = '';
      return;
    }
    list.innerHTML =
      chosenFiles
        .map(
          (file, index) => `<div class="ap-file-row">
            <span class="ap-comp-name">${esc(file.name)} (${esc(fmtSize(file.size))})</span>
            <button type="button" class="ap-file-remove" data-index="${index}" aria-label="Remove ${esc(file.name)}">Remove</button>
          </div>`,
        )
        .join('') +
      `<p style="margin:0.25rem 0 0;color:var(--text-muted);font-size:0.78rem;">${chosenFiles.length} of ${MAX_FILES} files</p>`;
    list.querySelectorAll<HTMLButtonElement>('.ap-file-remove').forEach((btn) => {
      btn.addEventListener('click', () => {
        const index = Number(btn.dataset.index);
        const [removed] = chosenFiles.splice(index, 1);
        if (removed) comparisonDraft.delete(keyOf(removed));
        invalidateAiPreview('Quotations changed — run the analysis again.');
        showFilesMsg('');
        renderFilesList();
        renderComparisonBuilder();
      });
    });
  }

  fileInput?.addEventListener('change', async () => {
    if (!fileInput) return;
    const picked = Array.from(fileInput.files || []);
    fileInput.value = '';
    for (const raw of picked) {
      const file = await maybeConvertHeic(raw);
      if (chosenFiles.some((f) => keyOf(f) === keyOf(file))) {
        showFilesMsg(`"${file.name}" is already in the list.`);
        continue;
      }
      if (file.size > MAX_FILE_BYTES) {
        showFilesMsg(`"${file.name}" is larger than 10 MB and was not added.`);
        continue;
      }
      if (chosenFiles.length >= MAX_FILES) {
        showFilesMsg(`At most ${MAX_FILES} files per item.`);
        break;
      }
      invalidateAiPreview('Quotations changed — run the analysis again.');
      chosenFiles.push(file);
    }
    renderFilesList();
    renderComparisonBuilder();
  });

  function syncApprovalDefault(): void {
    if (!categorySelect || !approvalCheck) return;
    const option = categorySelect.selectedOptions[0];
    approvalCheck.checked = option?.dataset.requiresApproval !== 'false';
  }

  categorySelect?.addEventListener('change', syncApprovalDefault);

  function renderComparisonBuilder(): void {
    if (!comparisonRows || !comparisonBuilder || !comparisonToggleWrap || !comparisonToggle) return;
    const aiBox = document.getElementById('ap-ai-box');
    const aiRun = document.getElementById('ap-ai-run') as HTMLButtonElement | null;
    if (chosenFiles.length === 0) {
      // No files: hide everything comparison-related and clear the toggle.
      comparisonToggleWrap.hidden = true;
      comparisonToggle.checked = false;
      comparisonBuilder.hidden = true;
      comparisonRows.innerHTML = '';
      if (aiBox) aiBox.hidden = true;
      return;
    }
    comparisonToggleWrap.hidden = false;
    if (!comparisonToggle.checked) {
      comparisonBuilder.hidden = true;
      comparisonRows.innerHTML = '';
      if (aiBox) aiBox.hidden = true;
      return;
    }
    comparisonBuilder.hidden = false;
    // The AI box appears with the builder when the feature is on. Disabled
    // still shows a short note (owner decision: visible off-state, no button).
    if (aiBox) {
      aiBox.hidden = false;
      if (sessionData && sessionData.ai_comparison_enabled === false) {
        if (aiRun) aiRun.hidden = true;
        setAiMsg('AI comparison is disabled by an IT administrator.');
      } else {
        if (aiRun) aiRun.hidden = false;
        if (!aiPreview) setAiMsg('Optional: let AI read the ticked quotations and compare them.');
      }
    }
    comparisonRows.innerHTML = chosenFiles
      .map((file, index) => {
        const draft = comparisonDraft.get(keyOf(file));
        const include = draft ? draft.include : true;
        const desc = draft ? draft.desc : '';
        return `<div class="ap-comp-row">
          <input type="checkbox" id="ap-comp-include-${index}" data-key="${esc(keyOf(file))}" ${include ? 'checked' : ''} />
          <label for="ap-comp-include-${index}" class="ap-comp-name">${esc(file.name)} (${esc(fmtSize(file.size))})</label>
          <input type="text" class="form-input" data-desc="${index}" data-key="${esc(keyOf(file))}" style="flex:1;min-width:200px;" maxlength="500" value="${esc(desc)}" placeholder="e.g. Grand Copthorne — S$1,350/table, 25 tables" />
        </div>`;
      })
      .join('');

    // Persist edits into the drafts so the next re-render (a file added or
    // removed) restores what was typed. Any edit invalidates a stale AI
    // preview — the analysis must always match the ticked set.
    comparisonRows.querySelectorAll<HTMLInputElement>('input[type="checkbox"]').forEach((box) => {
      box.addEventListener('change', () => {
        const key = box.dataset.key || '';
        const draft = comparisonDraft.get(key) || { include: true, desc: '' };
        draft.include = box.checked;
        comparisonDraft.set(key, draft);
        invalidateAiPreview('Quotations changed — run the analysis again.');
      });
    });
    comparisonRows.querySelectorAll<HTMLInputElement>('input[data-desc]').forEach((inp) => {
      inp.addEventListener('input', () => {
        const key = inp.dataset.key || '';
        const draft = comparisonDraft.get(key) || { include: true, desc: '' };
        draft.desc = inp.value;
        comparisonDraft.set(key, draft);
      });
    });
  }

  comparisonToggle?.addEventListener('change', () => {
    invalidateAiPreview();
    renderComparisonBuilder();
  });

  // ---- AI analysis: run + preview + replay on submit ----------------------

  function tickedQuotationFiles(): File[] {
    if (!comparisonToggle?.checked || !comparisonRows) return [];
    const files: File[] = [];
    comparisonRows.querySelectorAll<HTMLInputElement>('input[type="checkbox"]').forEach((box) => {
      if (!box.checked) return;
      const file = chosenFiles.find((f) => keyOf(f) === (box.dataset.key || ''));
      if (file) files.push(file);
    });
    return files;
  }

  function renderAiAnalysisBlock(analysis: AiAnalysis): string {
    const rows = analysis.quotes
      .map((q) => {
        const original = q.totalPrice !== null ? `${q.currency || ''} ${q.totalPrice.toLocaleString('en-SG', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`.trim() : '—';
        return `<tr>
          <td>${esc(q.vendor || '—')}</td>
          <td>${esc(q.itemName || q.filename)}</td>
          <td>${esc(original)}</td>
          <td>${q.totalPriceSgd !== null ? esc(fmtMoney(q.totalPriceSgd)) : '—'}</td>
          <td>${esc(q.gst || '—')}</td>
          <td>${esc(q.leadTime || '—')}</td>
        </tr>`;
      })
      .join('');
    const problemFiles = analysis.files
      .filter((f) => f.status !== 'ok')
      .map((f) => `<li>${esc(f.filename)} — ${esc(f.note || 'could not be read')}</li>`)
      .join('');
    return `<h4>AI comparison <span style="font-weight:400;font-size:0.75rem;color:var(--text-muted);">(generated ${esc(fmtDateSg(analysis.generatedAt))})</span></h4>
      <table class="ap-comparison-table">
        <thead><tr><th>Vendor</th><th>Item</th><th>Quoted total</th><th>Total (S$)</th><th>GST</th><th>Lead time</th></tr></thead>
        <tbody>${rows}</tbody>
      </table>
      ${analysis.summary ? `<p style="margin:0.6rem 0 0;">${esc(analysis.summary)}</p>` : ''}
      ${analysis.recommendation ? `<p class="ap-ai-reco">Recommendation: ${esc(analysis.recommendation)}</p>` : ''}
      ${problemFiles ? `<ul style="margin:0.6rem 0 0;padding-left:1.1rem;color:var(--text-muted);font-size:0.78rem;">${problemFiles}</ul>` : ''}
      <p class="ap-ai-meta">FX rates dated ${esc(analysis.fx?.date || 'unavailable')}${analysis.fx ? ' via open.er-api.com' : ' — amounts not converted'}. AI-generated — verify against the original documents.</p>`;
  }

  document.getElementById('ap-ai-run')?.addEventListener('click', async () => {
    const btn = document.getElementById('ap-ai-run') as HTMLButtonElement | null;
    if (!btn || btn.disabled) return;
    const files = tickedQuotationFiles();
    if (files.length < 2) {
      setAiMsg('Tick at least two quotations to compare.', '#b3261e');
      return;
    }
    // In-flight lock (plan §4.6 layer 1): one click, one paid run.
    btn.disabled = true;
    setAiMsg('Reading the quotations… this can take up to a minute.', 'var(--text-muted)', true);
    const form = new FormData();
    for (const file of files) form.append('files', file);
    try {
      const res = await fetch('/api/approvals/analyse-preview', { method: 'POST', body: form });
      const body = (await res.json()) as { success: boolean; analysis?: AiAnalysis; message?: string };
      if (res.ok && body.success && body.analysis) {
        aiPreview = body.analysis;
        const box = document.getElementById('ap-ai-preview');
        if (box) {
          box.innerHTML = renderAiAnalysisBlock(aiPreview);
          box.hidden = false;
        }
        setAiMsg('The analysis will be saved with the request.', '#1b7f3b');
      } else {
        setAiMsg(body.message || 'The analysis failed. Please try again.', '#b3261e');
      }
    } catch {
      setAiMsg('Network error. Please try again.', '#b3261e');
    } finally {
      btn.disabled = false;
    }
  });

  // ---- Create-form toggle ----------------------------------------------
  // The board table leads the page (owner decision 25-08-2026): the form
  // only appears when the admin clicks "New request" and collapses again on
  // Cancel or a successful submit.

  function openCreateForm(): void {
    if (createBarMsg) createBarMsg.textContent = '';
    if (createBar) createBar.style.display = 'none';
    if (createCard) createCard.style.display = '';
  }

  function resetCreateForm(): void {
    const form = document.getElementById('ap-create-form') as HTMLFormElement | null;
    form?.reset();
    chosenFiles = [];
    comparisonDraft.clear();
    aiPreview = null;
    const previewBox = document.getElementById('ap-ai-preview');
    if (previewBox) {
      previewBox.hidden = true;
      previewBox.innerHTML = '';
    }
    setAiMsg('');
    showFilesMsg('');
    renderFilesList();
    renderComparisonBuilder();
    syncApprovalDefault();
    const msg = document.getElementById('ap-create-msg');
    if (msg) msg.textContent = '';
  }

  function closeCreateForm(): void {
    if (createCard) createCard.style.display = 'none';
    if (createBar) createBar.style.display = 'flex';
    resetCreateForm();
  }

  const createCard = document.getElementById('ap-create-card');
  const createBar = document.getElementById('ap-create-bar');
  const createBarMsg = document.getElementById('ap-create-bar-msg');
  document.getElementById('ap-create-open')?.addEventListener('click', openCreateForm);
  document.getElementById('ap-create-cancel')?.addEventListener('click', closeCreateForm);

  document.getElementById('ap-create-form')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const msg = document.getElementById('ap-create-msg');
    const submit = document.getElementById('ap-create-submit') as HTMLButtonElement | null;
    if (!msg || !submit) return;
    msg.textContent = '';
    msg.style.color = 'var(--text-muted)';

    const form = new FormData();
    if (categorySelect) form.append('category', categorySelect.value);
    form.append('title', (document.getElementById('ap-title') as HTMLInputElement).value.trim());
    form.append('payee', (document.getElementById('ap-payee') as HTMLInputElement).value.trim());
    form.append('requestedAmount', (document.getElementById('ap-amount') as HTMLInputElement).value.trim());
    const descriptionEl = document.getElementById('ap-description') as HTMLTextAreaElement | null;
    if (descriptionEl) form.append('description', descriptionEl.value.trim());
    if (approvalCheck) form.append('approvalRequired', approvalCheck.checked ? 'true' : 'false');

    for (const file of chosenFiles) form.append('files', file);

    const comparison: Array<{ file: string; description: string }> = [];
    if (comparisonToggle?.checked) {
      comparisonRows?.querySelectorAll<HTMLInputElement>('input[type="checkbox"]').forEach((box) => {
        if (!box.checked) return;
        const key = box.dataset.key || '';
        const file = chosenFiles.find((f) => keyOf(f) === key);
        if (!file) return;
        const row = box.closest('.ap-comp-row');
        const desc = row?.querySelector<HTMLInputElement>('input[data-desc]')?.value.trim() || '';
        if (desc) comparison.push({ file: file.name, description: desc });
      });
    }
    if (comparison.length > 0) form.append('comparison', JSON.stringify(comparison));
    // Replay the previewed AI analysis with the request (plan §4.3): the
    // create endpoint never calls AI itself.
    if (aiPreview && comparison.length > 0) form.append('aiComparison', JSON.stringify(aiPreview));

    submit.disabled = true;
    try {
      const res = await fetch('/api/approvals', { method: 'POST', body: form });
      const body = (await res.json()) as { success: boolean; message?: string };
      if (res.ok && body.success) {
        resetCreateForm();
        // Collapse back to the button row and confirm near the button —
        // the form itself is hidden at this point.
        if (createCard) createCard.style.display = 'none';
        if (createBar) createBar.style.display = 'flex';
        if (createBarMsg) createBarMsg.textContent = 'Request raised.';
        await loadList();
      } else {
        msg.style.color = '#b3261e';
        msg.textContent = body.message || 'Could not raise the request.';
      }
    } catch {
      msg.style.color = '#b3261e';
      msg.textContent = 'Network error. Please try again.';
    } finally {
      submit.disabled = false;
    }
  });

  // ---- Boot -------------------------------------------------------------

  requireAuth({
    onAuthenticated(data: SessionResponse) {
      sessionData = data;
      // Admins get the "New request" button row; the form card itself stays
      // closed until the button is clicked. Approver sessions see neither.
      const bar = document.getElementById('ap-create-bar');
      if (bar) bar.style.display = data.is_admin ? 'flex' : 'none';
      syncApprovalDefault();
      void loadList().then(() => {
        // Deep link from approval emails: /approvals?item=<id>
        const deep = new URLSearchParams(window.location.search).get('item');
        if (deep && /^\d+$/.test(deep)) {
          const exists = allItems.some((i) => i.id === Number(deep)) || counts.all > 0;
          if (exists) void openDrawer(Number(deep));
        }
      });
    },
  });
</script>
