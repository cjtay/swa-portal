---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Online Forms — SWA Admin Portal" currentPath="/admin/forms">
  <h1>Online Forms</h1>
  <p style="color:var(--text-muted);margin-bottom:2rem;">Public forms and their submissions.</p>

  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:1rem;">
    <div class="card">
      <a href="/admin/forms/volunteer" style="text-decoration:none;color:inherit;display:block;">
        <h2>Volunteer Registration</h2>
        <p style="color:var(--text-muted);font-size:0.85rem;">View volunteer registration submissions from the public form.</p>
      </a>
      <a href="/reg/volunteer/register" target="_blank" rel="noopener"
         style="display:inline-block;margin-top:0.75rem;font-size:0.85rem;color:var(--swa-1);text-decoration:none;font-weight:600;">
        View public form &rarr;
      </a>
    </div>
    <div class="card">
      <a href="/admin/forms/laughter-yoga" style="text-decoration:none;color:inherit;display:block;">
        <h2>Laughter Yoga Registration</h2>
        <p style="color:var(--text-muted);font-size:0.85rem;">View Laughter Yoga session registrations from the public form.</p>
      </a>
      <a href="/reg/laughter-yoga/register" target="_blank" rel="noopener"
         style="display:inline-block;margin-top:0.75rem;font-size:0.85rem;color:var(--swa-1);text-decoration:none;font-weight:600;">
        View public form &rarr;
      </a>
    </div>
    <div class="card">
      <a href="/admin/forms/membership" style="text-decoration:none;color:inherit;display:block;">
        <h2>Membership Application</h2>
        <p style="color:var(--text-muted);font-size:0.85rem;">View new membership applications, PayNow screenshots, and signatures.</p>
      </a>
      <a href="/reg/membership/register" target="_blank" rel="noopener"
         style="display:inline-block;margin-top:0.75rem;font-size:0.85rem;color:var(--swa-1);text-decoration:none;font-weight:600;">
        View public form &rarr;
      </a>
    </div>
  </div>
</AdminLayout>
