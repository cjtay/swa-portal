---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Volunteer Registrations — SWA Admin Portal" currentPath="/admin/forms/volunteer">
  <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:0.5rem;">
    <a href="/admin/forms" style="color:var(--text-muted);text-decoration:none;font-size:0.85rem;">Online Forms</a>
    <span style="color:var(--text-muted);">/</span>
    <span style="font-size:0.85rem;">Volunteer Registration</span>
  </div>
  <h1>Volunteer Registrations</h1>
  <p style="color:var(--text-muted);margin-bottom:1.5rem;">All submissions from the public volunteer registration form.</p>

  <div class="card">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;gap:0.75rem;flex-wrap:wrap;">
      <div style="display:flex;gap:0.5rem;align-items:center;flex-wrap:wrap;">
        <input type="search" id="search-input" class="form-input" placeholder="Search by name, email, or contact..." style="width:280px;max-width:100%;" />
        <div class="filter-export-group">
          <span class="filter-export-label">Filter &amp; Export</span>
          <button class="btn btn-date btn-date--active" id="filter-all">All</button>
          <button class="btn btn-date" id="filter-1aug">1 Aug</button>
          <button class="btn btn-date" id="filter-8aug">8 Aug</button>
          <button class="btn btn-secondary" id="export-btn">Export CSV</button>
        </div>
      </div>
      <span id="count-label" style="color:var(--text-muted);font-size:0.85rem;"></span>
    </div>
    <div class="table-scroll">
      <table class="data-table">
        <thead>
          <tr>
            <th class="sortable" data-sort="id">Ref</th>
            <th>Event</th>
            <th class="sortable" data-sort="full_name">Full Name</th>
            <th class="sortable" data-sort="email">Email</th>
            <th>Contact Number</th>
            <th>NRIC/FIN Last 4</th>
            <th>Emergency Contact</th>
            <th>Availability</th>
            <th>18+</th>
            <th>Medical Conditions</th>
            <th>Roles of Interest</th>
            <th>Affiliation</th>
            <th>Corporate Company</th>
            <th>Referral</th>
            <th>Consent</th>
            <th>Declaration</th>
            <th class="sortable" data-sort="created_at">Submitted (SG)</th>
          </tr>
        </thead>
        <tbody id="submissions-list"></tbody>
      </table>
    </div>
  </div>
</AdminLayout>

<style is:global>
  /* Widen this page's content for wide monitors (overrides .admin-main 1200px cap) */
  .admin-main {
    max-width: 1600px;
  }

  /* Visible horizontal scrollbar for the submissions table (Chrome/Edge + Firefox) */
  .table-scroll {
    overflow-x: auto;
    overflow-y: auto;
    max-height: 75vh;
    border: 1px solid var(--border);
    border-radius: 0.4rem;
  }

  /* Sticky header so column titles stay visible while scrolling vertically */
  .table-scroll .data-table thead th {
    position: sticky;
    top: 0;
    z-index: 1;
    background: var(--bg);
  }

  /* Chrome, Edge, Safari */
  .table-scroll::-webkit-scrollbar {
    height: 12px;
    width: 12px;
  }
  .table-scroll::-webkit-scrollbar-track {
    background: var(--bg);
    border-top: 1px solid var(--border);
    border-radius: 0 0 0.4rem 0.4rem;
  }
  .table-scroll::-webkit-scrollbar-thumb {
    background: var(--swa-3);
    border-radius: 9999px;
    border: 2px solid var(--bg);
  }
  .table-scroll::-webkit-scrollbar-thumb:hover {
    background: var(--swa-1);
  }

  /* Firefox */
  .table-scroll {
    scrollbar-width: thin;
    scrollbar-color: var(--swa-3) var(--bg);
  }

  /* Sortable column headers */
  .data-table th.sortable {
    cursor: pointer;
    user-select: none;
    white-space: nowrap;
  }
  .data-table th.sortable:hover {
    color: var(--swa-1);
    background: #f5f0f8;
  }
  .data-table th.sortable[aria-sort="ascending"]::after {
    content: ' ▲';
    font-size: 0.65rem;
  }
  .data-table th.sortable[aria-sort="descending"]::after {
    content: ' ▼';
    font-size: 0.65rem;
  }
  .data-table th.sortable[aria-sort] {
    color: var(--swa-1);
  }

  /* Date filter buttons */
  .btn-date {
    padding: 0.35rem 0.75rem;
    font-size: 0.8rem;
    border: 1px solid var(--border);
    border-radius: 0.3rem;
    background: var(--bg);
    color: var(--text-muted);
    cursor: pointer;
  }
  .btn-date:hover {
    border-color: var(--swa-3);
    color: var(--swa-2);
  }
  .btn-date--active {
    background: var(--swa-1);
    border-color: var(--swa-1);
    color: #fff;
  }
  .btn-date--active:hover {
    background: var(--swa-2);
    border-color: var(--swa-2);
    color: #fff;
  }

  /* Filter & Export group container */
  .filter-export-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.75rem;
    border: 1px dashed var(--swa-3);
    border-radius: 0.4rem;
    background: #fbf7fc;
  }
  .filter-export-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--swa-2);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-right: 0.15rem;
  }
</style>

<script>
  import { requireAuth } from '../../../scripts/auth-gate';

  let allSubmissions: any[] = [];
  let sortColumn: string | null = null;
  let sortDirection: 'asc' | 'desc' = 'asc';
  let activeDateFilter: string | null = null;

  const DATE_FILTER_MAP: Record<string, string> = {
    '1aug': '1st August (Saturday)',
    '8aug': '8th August (Saturday)',
  };

  function sortSubmissions() {
    if (!sortColumn) return;
    const dir = sortDirection === 'asc' ? 1 : -1;
    allSubmissions.sort((a: any, b: any) => {
      let va: any = a[sortColumn!];
      let vb: any = b[sortColumn!];
      if (sortColumn === 'id') {
        return (Number(va) - Number(vb)) * dir;
      }
      if (sortColumn === 'created_at') {
        return String(va || '').localeCompare(String(vb || '')) * dir;
      }
      // full_name, email — case-insensitive string
      return String(va || '').toLowerCase().localeCompare(String(vb || '').toLowerCase()) * dir;
    });
  }

  function updateSortHeaders() {
    const thead = document.querySelector('.data-table thead');
    if (!thead) return;
    thead.querySelectorAll('th.sortable').forEach((th) => {
      const col = (th as HTMLElement).dataset.sort;
      if (col === sortColumn) {
        th.setAttribute('aria-sort', sortDirection === 'asc' ? 'ascending' : 'descending');
      } else {
        th.removeAttribute('aria-sort');
      }
    });
  }

  async function loadSubmissions() {
    const tbody = document.getElementById('submissions-list')!;
    try {
      const res = await fetch('/api/admin/forms/volunteer');
      const data = await res.json();
      if (data.success) {
        allSubmissions = data.submissions;
        renderSubmissions();
      } else if (data.error_code === 'FORBIDDEN') {
        tbody.innerHTML = '<tr><td colspan="17" style="text-align:center;color:var(--danger);">You do not have permission to view submissions.</td></tr>';
      } else {
        tbody.innerHTML = '<tr><td colspan="17" style="text-align:center;color:var(--text-muted);">Could not load submissions.</td></tr>';
      }
    } catch {
      tbody.innerHTML = '<tr><td colspan="17" style="text-align:center;color:var(--text-muted);">Network error.</td></tr>';
    }
  }

  function escapeHtml(s: string): string {
    const d = document.createElement('div');
    d.textContent = s == null ? '' : String(s);
    return d.innerHTML;
  }

  function formatDateTimeSg(iso: string): string {
    if (!iso) return '';
    // D1 stores datetime('now') as UTC in "YYYY-MM-DD HH:MM:SS" (no Z).
    // new Date() treats a no-suffix string as local time, so normalise to UTC
    // before converting to Asia/Singapore for correct display in any timezone.
    const normalised = /^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}/.test(iso)
      ? iso.replace(' ', 'T') + 'Z'
      : iso;
    const d = new Date(normalised);
    if (isNaN(d.getTime())) return iso;
    return d.toLocaleString('en-GB', {
      timeZone: 'Asia/Singapore',
      day: '2-digit',
      month: 'short',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
    });
  }

  function refFor(id: number): string {
    return 'VOL-' + String(id ?? 0).padStart(5, '0');
  }

  function dash(s: string): string {
    const v = (s || '').trim();
    return v.length > 0 ? escapeHtml(v) : '<span style="color:var(--text-muted);">&mdash;</span>';
  }

  function renderSubmissions() {
    sortSubmissions();
    updateSortHeaders();

    const search = (document.getElementById('search-input') as HTMLInputElement).value.toLowerCase().trim();

    let working = allSubmissions;

    if (activeDateFilter) {
      const dateLabel = DATE_FILTER_MAP[activeDateFilter];
      if (dateLabel) {
        working = working.filter((s: any) =>
          Array.isArray(s.availability) && s.availability.includes(dateLabel)
        );
      }
    }

    const filtered = search
      ? working.filter((s: any) =>
          (s.full_name || '').toLowerCase().includes(search) ||
          (s.email || '').toLowerCase().includes(search) ||
          (s.contact_number || '').toLowerCase().includes(search))
      : working;

    const tbody = document.getElementById('submissions-list')!;
    const countLabel = document.getElementById('count-label')!;

    if (filtered.length === 0) {
      tbody.innerHTML = '<tr><td colspan="17" style="text-align:center;color:var(--text-muted);">No submissions found.</td></tr>';
      countLabel.textContent = allSubmissions.length === 0 ? '' : `${filtered.length} of ${allSubmissions.length}`;
      return;
    }

    tbody.innerHTML = filtered.map((s: any) => {
      const ref = refFor(s.id);
      const submitted = formatDateTimeSg(s.created_at);
      const availability = Array.isArray(s.availability) ? s.availability.join('; ') : '';
      const roles = Array.isArray(s.roles_interest) ? s.roles_interest.join('; ') : '';
      const medical = s.medical_conditions === 'none' ? 'None' :
        s.medical_conditions === 'yes' ? 'Yes (not specified)' : (s.medical_conditions || '');

      return `<tr>
        <td style="font-family:'Courier New',monospace;font-size:0.8rem;color:var(--swa-2);white-space:nowrap;">${escapeHtml(ref)}</td>
        <td>${dash(s.event_key || '')}</td>
        <td>${escapeHtml(s.full_name || '')}</td>
        <td>${escapeHtml(s.email || '')}</td>
        <td>${escapeHtml(s.contact_number || '')}</td>
        <td>${escapeHtml(s.nric_last4 || '')}</td>
        <td>${escapeHtml(s.emergency_contact || '')}</td>
        <td>${dash(availability)}</td>
        <td>${s.is_18_plus ? 'Yes' : 'No'}</td>
        <td>${dash(medical)}</td>
        <td>${dash(roles)}</td>
        <td>${dash(s.affiliation || '')}</td>
        <td>${dash(s.corporate_company || '')}</td>
        <td>${dash(s.referral || '')}</td>
        <td>${s.consent ? 'Agreed' : 'Not agreed'}</td>
        <td>${s.declaration ? 'Agreed' : 'Not agreed'}</td>
        <td style="white-space:nowrap;font-size:0.85rem;">${escapeHtml(submitted)}</td>
      </tr>`;
    }).join('');

    countLabel.textContent = (search || activeDateFilter) ? `${filtered.length} of ${allSubmissions.length} shown` : `${allSubmissions.length} total`;
  }

  document.getElementById('search-input')!.addEventListener('input', renderSubmissions);
  document.getElementById('export-btn')!.addEventListener('click', () => {
    let url = '/api/admin/forms/volunteer/export';
    if (activeDateFilter && DATE_FILTER_MAP[activeDateFilter]) {
      url += '?date=' + encodeURIComponent(DATE_FILTER_MAP[activeDateFilter]);
    }
    window.location.href = url;
  });

  document.querySelector('.data-table thead')!.addEventListener('click', (e: Event) => {
    const th = (e.target as HTMLElement).closest('th.sortable') as HTMLElement | null;
    if (!th) return;
    const col = th.dataset.sort!;
    if (sortColumn === col) {
      sortDirection = sortDirection === 'asc' ? 'desc' : 'asc';
    } else {
      sortColumn = col;
      sortDirection = 'asc';
    }
    renderSubmissions();
  });

  function setDateFilter(filterKey: string | null) {
    activeDateFilter = filterKey;
    document.querySelectorAll('.btn-date').forEach((btn) => btn.classList.remove('btn-date--active'));
    if (filterKey) {
      document.getElementById('filter-' + filterKey)!.classList.add('btn-date--active');
    } else {
      document.getElementById('filter-all')!.classList.add('btn-date--active');
    }
    renderSubmissions();
  }

  document.getElementById('filter-all')!.addEventListener('click', () => setDateFilter(null));
  document.getElementById('filter-1aug')!.addEventListener('click', () => setDateFilter('1aug'));
  document.getElementById('filter-8aug')!.addEventListener('click', () => setDateFilter('8aug'));

  requireAuth({
    onAuthenticated() {
      loadSubmissions();
    },
  });
</script>
