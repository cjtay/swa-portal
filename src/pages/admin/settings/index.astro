---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Settings — SWA Admin Portal" currentPath="/admin/settings">

<div class="pg-settings">
  <h1 class="pg-title">Settings</h1>
  <p class="pg-subtitle">Manage portal configuration. Changes take effect immediately.</p>

  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1rem;">
    <a href="/admin/settings/roles" class="card" style="text-decoration:none;color:inherit;display:block;">
      <h2>User Roles</h2>
      <p style="color:var(--text-muted);font-size:0.85rem;">Assign registration access roles to members who can log in. Control who can manage bookings and mark arrivals.</p>
    </a>
  </div>

  <div class="card" style="margin-top:1.5rem;">
    <h2>IT Administrators</h2>
    <p style="color:var(--text-muted);font-size:0.85rem;">
      IT Admins hold full portal control, including Settings. The list is fixed in code
      (<code>IT_ADMIN_EMAILS</code> in <code>src/constants/portal.ts</code>) so no portal session can change it.
      To add or remove an IT Admin, edit that file and deploy. The same email may also exist in the member
      directory without conflict — the directory row and the IT Admin list are independent.
    </p>
    <table class="data-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th>Access</th>
        </tr>
      </thead>
      <tbody id="it-admin-list">
        <tr><td colspan="3" style="text-align:center;color:var(--text-muted);">Loading...</td></tr>
      </tbody>
    </table>
  </div>

  <div class="card" style="margin-top:1.5rem;">
    <h2>Approvals — Audit Log</h2>
    <p style="color:var(--text-muted);font-size:0.85rem;">
      Every approval action (raised, edited, decided, voucher, paid) is recorded in an
      insert-only audit log. Pick a date range and export it as a CSV, oldest first,
      capped at 5,000 rows. The log stores UTC timestamps, so a Singapore date matches
      log entries from 08:00 that day to 07:59 the next. IT Admin access only.
    </p>
    <div style="display:flex;gap:0.75rem;align-items:center;flex-wrap:wrap;">
      <label style="font-size:0.85rem;display:inline-flex;align-items:center;gap:0.4rem;">
        From
        <input type="date" id="audit-from" class="form-input" style="width:auto;" />
      </label>
      <label style="font-size:0.85rem;display:inline-flex;align-items:center;gap:0.4rem;">
        To
        <input type="date" id="audit-to" class="form-input" style="width:auto;" />
      </label>
      <button type="button" class="btn btn-secondary" id="audit-export" disabled>Export audit log (CSV)</button>
    </div>
    <p id="audit-export-msg" style="margin:0.5rem 0 0;font-size:0.8rem;color:#b3261e;" hidden></p>
  </div>

  <div class="card" style="margin-top:1.5rem;">
    <h2>Approvals — AI Quotation Comparison</h2>
    <p style="color:var(--text-muted);font-size:0.85rem;">
      The approvals form can read quotation documents (PDF or photos) with Cloudflare Workers AI,
      extract vendor, item and price fields, convert prices to S$, and write a short comparison with
      a recommendation. Turning this off hides the Analyse/Regenerate buttons and blocks the
      analysis endpoints immediately. A daily portal-wide cap (50 analyses) applies either way.
    </p>
    <div style="display:flex;gap:0.75rem;align-items:center;flex-wrap:wrap;">
      <span id="ai-status" style="font-size:0.9rem;font-weight:600;color:var(--text-muted);">Loading…</span>
      <button type="button" class="btn btn-secondary" id="ai-disable" disabled>Disable</button>
      <button type="button" class="btn btn-secondary" id="ai-enable" hidden>Enable</button>
    </div>
    <p id="ai-msg" style="margin:0.5rem 0 0;font-size:0.8rem;color:#b3261e;" hidden></p>
  </div>

  <div class="card" style="margin-top:1.5rem;">
    <h2>Feature Availability</h2>
    <p style="color:var(--text-muted);font-size:0.85rem;">
      Features still under construction are switched off for all portal users. Enabling a feature
      shows its navigation and pages to the relevant roles within about a minute — no redeploy
      needed. New features always launch disabled. Unset features follow the code defaults
      (off in production, on in local development).
    </p>
    <table class="data-table">
      <thead>
        <tr>
          <th>Feature</th>
          <th>Status</th>
          <th style="width:120px;">Action</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Namecards</td>
          <td><span id="ff-namecards-status" style="font-weight:600;">Loading…</span></td>
          <td>
            <button type="button" class="btn btn-secondary" id="ff-namecards-enable" hidden>Enable</button>
            <button type="button" class="btn btn-secondary" id="ff-namecards-disable" hidden>Disable</button>
          </td>
        </tr>
        <tr>
          <td>Office Booking</td>
          <td><span id="ff-office_booking-status" style="font-weight:600;">Loading…</span></td>
          <td>
            <button type="button" class="btn btn-secondary" id="ff-office_booking-enable" hidden>Enable</button>
            <button type="button" class="btn btn-secondary" id="ff-office_booking-disable" hidden>Disable</button>
          </td>
        </tr>
        <tr>
          <td>Events</td>
          <td><span id="ff-events-status" style="font-weight:600;">Loading…</span></td>
          <td>
            <button type="button" class="btn btn-secondary" id="ff-events-enable" hidden>Enable</button>
            <button type="button" class="btn btn-secondary" id="ff-events-disable" hidden>Disable</button>
          </td>
        </tr>
      </tbody>
    </table>
    <p id="ff-msg" style="margin:0.5rem 0 0;font-size:0.8rem;color:#b3261e;" hidden></p>
  </div>

  <div class="card steps-card" style="margin-top:1.5rem;" id="tables-pointer-card" hidden>
    <h3 style="color:#16a34a;font-size:0.9rem;margin-bottom:0.5rem;">Where are the other settings?</h3>
    <p style="font-size:0.85rem;color:var(--text-muted);">
      Table configuration for the charity dinner now lives under
      <a href="/events" style="color:var(--swa-3,#874ba1);">Events</a> &rarr; Table Configuration.
    </p>
  </div>
</div>

</AdminLayout>

<style>
  .pg-settings { max-width: 860px; }
  .pg-title { font-size: 1.4rem; font-weight: 700; color: var(--swa-1, #70308c); margin-bottom: 0.25rem; }
  .pg-subtitle { color: var(--swa-muted, #6b7280); font-size: 0.9rem; margin-bottom: 1.5rem; }
  .steps-card { background: #f0fdf4; border: 1px solid #bbf7d0; }
</style>

<script>
  import { requireItAdmin, type FeatureKey } from '../../../scripts/auth-gate';

  requireItAdmin(() => {});

  async function loadItAdmins() {
    const tbody = document.getElementById('it-admin-list');
    if (!tbody) return;
    try {
      const res = await fetch('/api/admin/settings?key=swa:it_admins');
      const data = await res.json();
      if (!data.success) throw new Error(data.message || 'Request failed');
      const admins = data.value as { email: string; name: string }[];
      tbody.innerHTML = admins.length
        ? admins.map((a) => `<tr>
            <td>${a.name}</td>
            <td>${a.email}</td>
            <td><span class="badge badge-approved">Full (read-only list)</span></td>
          </tr>`).join('')
        : '<tr><td colspan="3" style="text-align:center;color:var(--text-muted);">No IT Admins configured.</td></tr>';
    } catch {
      tbody.innerHTML = '<tr><td colspan="3" style="text-align:center;color:var(--danger);">Could not load the IT Admin list.</td></tr>';
    }
  }

  loadItAdmins();

  // Audit log export — a date range is required first (owner decision
  // 25-08-2026) so the CSV stays small. The button enables only when both
  // dates are filled and From is on or before To.
  function auditRange(): { from: string; to: string } {
    return {
      from: (document.getElementById('audit-from') as HTMLInputElement | null)?.value || '',
      to: (document.getElementById('audit-to') as HTMLInputElement | null)?.value || '',
    };
  }

  function syncAuditExport(): void {
    const { from, to } = auditRange();
    const btn = document.getElementById('audit-export') as HTMLButtonElement | null;
    const msg = document.getElementById('audit-export-msg');
    if (!btn) return;
    let error = '';
    if (from && to && from > to) error = 'The From date must be on or before the To date.';
    btn.disabled = Boolean(!from || !to || error);
    if (msg) {
      msg.textContent = error;
      msg.hidden = !error;
    }
  }

  document.getElementById('audit-from')?.addEventListener('change', syncAuditExport);
  document.getElementById('audit-to')?.addEventListener('change', syncAuditExport);
  document.getElementById('audit-export')?.addEventListener('click', () => {
    const { from, to } = auditRange();
    if (!from || !to || from > to) return;
    window.location.href = `/api/approvals/audit/export?from=${encodeURIComponent(from)}&to=${encodeURIComponent(to)}`;
  });

  // AI quotation comparison kill-switch (docs/plans/AI-Quotation-Comparison-
  // Plan.md §4.5). A missing KV key means the feature is on by default, so a
  // 404 from GET renders as "Enabled (default)".
  const AI_STATUS_COLORS = { on: '#1b7f3b', off: '#b3261e' };

  function aiMsg(text: string): void {
    const el = document.getElementById('ai-msg');
    if (!el) return;
    el.textContent = text;
    el.hidden = !text;
  }

  function renderAiStatus(enabled: boolean, byDefault: boolean): void {
    const status = document.getElementById('ai-status');
    const enableBtn = document.getElementById('ai-enable') as HTMLButtonElement | null;
    const disableBtn = document.getElementById('ai-disable') as HTMLButtonElement | null;
    if (!status || !enableBtn || !disableBtn) return;
    status.textContent = enabled ? (byDefault ? 'Enabled (default)' : 'Enabled') : 'Disabled';
    status.style.color = enabled ? AI_STATUS_COLORS.on : AI_STATUS_COLORS.off;
    enableBtn.hidden = enabled;
    disableBtn.hidden = !enabled;
    disableBtn.disabled = false;
    enableBtn.disabled = false;
  }

  async function loadAiConfig(): Promise<void> {
    try {
      const res = await fetch('/api/admin/settings?key=swa:ai_config');
      if (res.status === 404) {
        renderAiStatus(true, true);
        return;
      }
      const data = await res.json();
      if (!data.success) throw new Error(data.message || 'Request failed');
      renderAiStatus(data.value?.enabled !== false, false);
    } catch {
      const status = document.getElementById('ai-status');
      if (status) {
        status.textContent = 'Could not load the AI setting.';
        status.style.color = '#b3261e';
      }
    }
  }

  async function setAiConfig(enabled: boolean): Promise<void> {
    const enableBtn = document.getElementById('ai-enable') as HTMLButtonElement | null;
    const disableBtn = document.getElementById('ai-disable') as HTMLButtonElement | null;
    if (enableBtn) enableBtn.disabled = true;
    if (disableBtn) disableBtn.disabled = true;
    aiMsg('');
    try {
      const res = await fetch('/api/admin/settings', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ key: 'swa:ai_config', value: { enabled } }),
      });
      const data = await res.json();
      if (!data.success) throw new Error(data.message || 'Request failed');
      renderAiStatus(enabled, false);
    } catch (err) {
      aiMsg(err instanceof Error ? err.message : 'Could not save the setting.');
      // Re-render from the stored state to un-stick the buttons.
      await loadAiConfig();
    }
  }

  document.getElementById('ai-enable')?.addEventListener('click', () => void setAiConfig(true));
  document.getElementById('ai-disable')?.addEventListener('click', () => void setAiConfig(false));
  loadAiConfig();

  // Feature availability (src/worker/lib/feature-flags.ts). The GET falls
  // back to the code defaults when the KV override is absent, marked with
  // isDefault so the status renders as "Disabled (default)". Writes must
  // carry every known key, so the card always POSTs the full object.
  const FF_KEYS: FeatureKey[] = ['namecards', 'office_booking', 'events'];
  const FF_STATUS_COLORS = { on: '#1b7f3b', off: '#b3261e' };
  let ffState: Record<string, boolean> = {};
  let ffByDefault = false;

  function ffMsg(text: string): void {
    const el = document.getElementById('ff-msg');
    if (!el) return;
    el.textContent = text;
    el.hidden = !text;
  }

  function renderFeatureFlags(): void {
    for (const key of FF_KEYS) {
      const status = document.getElementById(`ff-${key}-status`);
      const enableBtn = document.getElementById(`ff-${key}-enable`) as HTMLButtonElement | null;
      const disableBtn = document.getElementById(`ff-${key}-disable`) as HTMLButtonElement | null;
      if (!status || !enableBtn || !disableBtn) continue;
      const on = !!ffState[key];
      status.textContent = on ? 'Enabled' : (ffByDefault ? 'Disabled (default)' : 'Disabled');
      status.style.color = on ? FF_STATUS_COLORS.on : FF_STATUS_COLORS.off;
      enableBtn.hidden = on;
      disableBtn.hidden = !on;
      enableBtn.disabled = false;
      disableBtn.disabled = false;
    }
    // The Table Configuration pointer card only makes sense while Events is
    // available to portal users.
    const pointer = document.getElementById('tables-pointer-card');
    if (pointer && ffState.events) pointer.removeAttribute('hidden');
  }

  async function loadFeatureFlags(): Promise<void> {
    try {
      const res = await fetch('/api/admin/settings?key=swa:feature_flags');
      const data = await res.json();
      if (!data.success) throw new Error(data.message || 'Request failed');
      ffState = data.value || {};
      ffByDefault = !!data.isDefault;
      renderFeatureFlags();
    } catch {
      for (const key of FF_KEYS) {
        const status = document.getElementById(`ff-${key}-status`);
        if (status) {
          status.textContent = 'Could not load.';
          status.style.color = '#b3261e';
        }
      }
    }
  }

  async function setFeatureFlag(key: FeatureKey, enabled: boolean): Promise<void> {
    for (const k of FF_KEYS) {
      const btn = document.getElementById(`ff-${k}-${enabled ? 'enable' : 'disable'}`) as HTMLButtonElement | null;
      const other = document.getElementById(`ff-${k}-${enabled ? 'disable' : 'enable'}`) as HTMLButtonElement | null;
      if (btn) btn.disabled = true;
      if (other) other.disabled = true;
    }
    ffMsg('');
    try {
      const res = await fetch('/api/admin/settings', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ key: 'swa:feature_flags', value: { ...ffState, [key]: enabled } }),
      });
      const data = await res.json();
      if (!data.success) throw new Error(data.message || 'Request failed');
      ffState = data.value;
      ffByDefault = false;
      renderFeatureFlags();
    } catch (err) {
      ffMsg(err instanceof Error ? err.message : 'Could not save the setting.');
      renderFeatureFlags();
    }
  }

  for (const key of FF_KEYS) {
    document.getElementById(`ff-${key}-enable`)?.addEventListener('click', () => void setFeatureFlag(key, true));
    document.getElementById(`ff-${key}-disable`)?.addEventListener('click', () => void setFeatureFlag(key, false));
  }
  loadFeatureFlags();
</script>
