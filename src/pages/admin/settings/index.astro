---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Settings — SWA Admin Portal" currentPath="/admin/settings">

<div class="pg-settings">
  <h1 class="pg-title">Settings</h1>
  <p class="pg-subtitle">Manage portal configuration. Changes take effect immediately.</p>

  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1rem;">
    <a href="/admin/settings/roles" class="card" style="text-decoration:none;color:inherit;display:block;">
      <h2>User Roles</h2>
      <p style="color:var(--text-muted);font-size:0.85rem;">Assign registration access roles to members who can log in. Control who can manage bookings and mark arrivals.</p>
    </a>
  </div>

  <div class="card" style="margin-top:1.5rem;">
    <h2>IT Administrators</h2>
    <p style="color:var(--text-muted);font-size:0.85rem;">
      IT Admins hold full portal control, including Settings. The list is fixed in code
      (<code>IT_ADMIN_EMAILS</code> in <code>src/constants/portal.ts</code>) so no portal session can change it.
      To add or remove an IT Admin, edit that file and deploy. The same email may also exist in the member
      directory without conflict — the directory row and the IT Admin list are independent.
    </p>
    <table class="data-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th>Access</th>
        </tr>
      </thead>
      <tbody id="it-admin-list">
        <tr><td colspan="3" style="text-align:center;color:var(--text-muted);">Loading...</td></tr>
      </tbody>
    </table>
  </div>

  <div class="card" style="margin-top:1.5rem;">
    <h2>Approvals — Audit Log</h2>
    <p style="color:var(--text-muted);font-size:0.85rem;">
      Every approval action (raised, edited, decided, voucher, paid) is recorded in an
      insert-only audit log. Export the full history as a CSV, oldest first, capped at
      5,000 rows. IT Admin access only.
    </p>
    <a class="btn btn-secondary" href="/api/approvals/audit/export">Export audit log (CSV)</a>
  </div>

  <div class="card steps-card" style="margin-top:1.5rem;">
    <h3 style="color:#16a34a;font-size:0.9rem;margin-bottom:0.5rem;">Where are the other settings?</h3>
    <p style="font-size:0.85rem;color:var(--text-muted);">
      Table configuration for the charity dinner now lives under
      <a href="/events" style="color:var(--swa-3,#874ba1);">Events</a> &rarr; Table Configuration.
    </p>
  </div>
</div>

</AdminLayout>

<style>
  .pg-settings { max-width: 860px; }
  .pg-title { font-size: 1.4rem; font-weight: 700; color: var(--swa-1, #70308c); margin-bottom: 0.25rem; }
  .pg-subtitle { color: var(--swa-muted, #6b7280); font-size: 0.9rem; margin-bottom: 1.5rem; }
  .steps-card { background: #f0fdf4; border: 1px solid #bbf7d0; }
</style>

<script>
  import { requireItAdmin } from '../../../scripts/auth-gate';

  requireItAdmin(() => {});

  async function loadItAdmins() {
    const tbody = document.getElementById('it-admin-list');
    if (!tbody) return;
    try {
      const res = await fetch('/api/admin/settings?key=swa:it_admins');
      const data = await res.json();
      if (!data.success) throw new Error(data.message || 'Request failed');
      const admins = data.value as { email: string; name: string }[];
      tbody.innerHTML = admins.length
        ? admins.map((a) => `<tr>
            <td>${a.name}</td>
            <td>${a.email}</td>
            <td><span class="badge badge-approved">Full (read-only list)</span></td>
          </tr>`).join('')
        : '<tr><td colspan="3" style="text-align:center;color:var(--text-muted);">No IT Admins configured.</td></tr>';
    } catch {
      tbody.innerHTML = '<tr><td colspan="3" style="text-align:center;color:var(--danger);">Could not load the IT Admin list.</td></tr>';
    }
  }

  loadItAdmins();
</script>
