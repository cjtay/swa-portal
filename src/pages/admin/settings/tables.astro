---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Table Configuration — SWA Admin Portal" currentPath="/admin/settings/tables">

<div class="pg-settings">
  <a href="/events" style="display:inline-flex;align-items:center;gap:0.3rem;color:var(--swa-3,#874ba1);font-size:0.85rem;text-decoration:none;margin-bottom:0.75rem;">&larr; Back to Events</a>
  <h1 class="pg-title">Events — Table Configuration</h1>
  <p class="pg-subtitle">Configure table layout, capacities, VIP designations, and the buyer form cutoff time for the gala dinner registration module. Changes are stored in Cloudflare KV.</p>

  <div class="card settings-card">
    <div class="settings-section">
      <div class="form-group">
        <label for="cutoff-input">Form Cutoff Time (ISO 8601)</label>
        <input type="text" id="cutoff-input" class="settings-input cutoff-input" placeholder="2026-06-20T18:00:00+08:00" />
        <span class="form-hint">Buyer forms close at this time. Use Singapore time (+08:00).</span>
      </div>
    </div>

    <h3 style="margin:1.5rem 0 0.75rem;font-size:0.95rem;">Tables</h3>
    <table class="data-table" id="table-list">
      <thead>
        <tr>
          <th>ID</th>
          <th>Label</th>
          <th>Prefix</th>
          <th>Seats</th>
          <th>VIP</th>
          <th></th>
        </tr>
      </thead>
      <tbody id="table-body"></tbody>
    </table>

    <div style="margin-top:1rem;display:flex;gap:0.5rem;flex-wrap:wrap;">
      <button class="btn btn-primary btn-sm" id="btn-add-regular">+ Add Regular Table</button>
      <button class="btn btn-outline btn-sm" id="btn-add-vip">+ Add VIP Table</button>
    </div>
  </div>

  <div id="validation-error" class="validation-error" style="display:none;"></div>

  <div class="card json-card">
    <div class="json-header">
      <h2 class="card-title">Generated JSON</h2>
      <button class="btn btn-sm btn-outline" id="btn-copy-json">Copy</button>
      <span id="copy-msg" class="copy-msg">Copied</span>
    </div>
    <pre id="json-output" class="json-block"></pre>
  </div>

  <div class="save-bar">
    <button class="btn btn-primary btn-lg" id="btn-save">Save Configuration to KV</button>
    <span id="save-status" class="save-status"></span>
  </div>
</div>

</AdminLayout>

<style>
  .pg-settings { max-width: 860px; }
  .pg-title { font-size: 1.4rem; font-weight: 700; color: var(--swa-1, #70308c); margin-bottom: 0.25rem; }
  .pg-subtitle { color: var(--swa-muted, #6b7280); font-size: 0.9rem; margin-bottom: 1.5rem; }
  .settings-card { margin-bottom: 1rem; }
  .card-title { font-size: 1.05rem; font-weight: 600; color: var(--swa-2, #450a5e); margin-bottom: 0.25rem; }
  .settings-section { margin-bottom: 0.5rem; }
  .form-group { display: flex; flex-direction: column; margin-bottom: 0.75rem; }
  .form-group label { font-size: 0.75rem; font-weight: 600; color: var(--swa-muted, #6b7280); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.25rem; }
  .form-group .form-hint { font-size: 0.75rem; color: var(--swa-muted, #9ca3af); margin-top: 0.2rem; }
  .settings-input { padding: 0.5rem 0.75rem; border: 1px solid var(--swa-border, #d1d5db); border-radius: 6px; font-size: 0.9rem; font-family: inherit; }
  .settings-input:focus { outline: none; border-color: var(--swa-3, #874ba1); box-shadow: 0 0 0 2px rgba(135,75,161,0.2); }
  .cutoff-input { width: 280px; font-family: 'Courier New', monospace; }

  .data-table { width: 100%; border-collapse: collapse; }
  .data-table th { background: var(--swa-4, #f3d2ff); color: var(--swa-2, #450a5e); font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; padding: 0.5rem 0.75rem; text-align: left; border-bottom: 2px solid var(--swa-1, #70308c); }
  .data-table td { padding: 0.4rem 0.5rem; border-bottom: 1px solid var(--swa-border, #e5e7eb); font-size: 0.9rem; vertical-align: middle; }
  .data-table tr:hover td { background: var(--swa-4, #faf5ff); }
  .data-table input[type="text"] { padding: 0.35rem 0.5rem; border: 1px solid var(--swa-border, #d1d5db); border-radius: 4px; font-size: 0.85rem; font-family: inherit; width: 70px; }
  .data-table input[type="text"]:focus { outline: none; border-color: var(--swa-3, #874ba1); }
  .data-table input[type="text"].label-input { width: 110px; }
  .data-table input[type="number"] { padding: 0.35rem 0.5rem; border: 1px solid var(--swa-border, #d1d5db); border-radius: 4px; font-size: 0.85rem; font-family: inherit; width: 60px; }
  .data-table input[type="number"]:focus { outline: none; border-color: var(--swa-3, #874ba1); }
  .ticket-prefix { font-family: 'Courier New', monospace; font-weight: 600; color: var(--swa-1, #70308c); font-size: 0.85rem; }
  .vip-badge { display: inline-block; background: var(--swa-1, #70308c); color: #fff; font-size: 0.6rem; font-weight: 700; padding: 0.1rem 0.35rem; border-radius: 3px; vertical-align: middle; margin-left: 0.3rem; }
  .btn-remove { background: var(--swa-danger, #dc2626); color: #fff; border: none; border-radius: 4px; padding: 0.3rem 0.6rem; font-size: 0.75rem; cursor: pointer; font-family: inherit; font-weight: 500; }
  .btn-remove:hover { background: #b91c1c; }

  .json-card { margin-bottom: 1rem; position: relative; }
  .json-header { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem; }
  .json-header .card-title { margin-bottom: 0; }
  .json-block { background: var(--swa-code-bg, #1f2937); color: var(--swa-code-fg, #e5e7eb); padding: 1.25rem; border-radius: 8px; font-size: 0.8rem; line-height: 1.5; overflow-x: auto; max-height: 360px; overflow-y: auto; margin: 0; }
  .copy-msg { color: #4ade80; font-size: 0.75rem; display: none; }

  .save-bar { display: flex; align-items: center; gap: 1rem; margin: 1rem 0 1.5rem; }
  .save-status { font-size: 0.85rem; font-weight: 500; }
  .save-status.success { color: #16a34a; }
  .save-status.error { color: #dc2626; }
  .save-status.saving { color: var(--swa-muted, #6b7280); }

  .validation-error { background: #fef2f2; border: 1px solid #fecaca; border-radius: 6px; padding: 0.75rem 1rem; font-size: 0.85rem; color: #dc2626; margin-bottom: 1rem; }
  .validation-error ul { margin: 0; padding-left: 1.25rem; }
  .validation-error li { margin-bottom: 0.2rem; }

  .btn-sm { font-size: 0.8rem; padding: 0.35rem 0.75rem; }
  .btn-lg { font-size: 0.95rem; padding: 0.6rem 1.5rem; }
  .btn-outline { background: #fff; color: var(--swa-1, #70308c); border: 1px solid var(--swa-1, #70308c); }
  .btn-outline:hover { background: var(--swa-4, #f3d2ff); }
</style>

<script>
  import { requireItAdmin, type SessionResponse } from '../../../scripts/auth-gate';

  interface TableConfig {
    id: string;
    label: string;
    ticketPrefix: string;
    capacity: number;
    isVIP: boolean;
  }

  interface TablesConfig {
    formCutoffTime: string;
    tables: TableConfig[];
  }

  let currentConfig: TablesConfig = {
    formCutoffTime: '2026-06-20T18:00:00+08:00',
    tables: [],
  };

  function derivePrefix(id: string, isVIP: boolean): string {
    if (isVIP) {
      const m = id.match(/VIP-(\d+)/i);
      if (m) return 'V' + m[1];
      return 'V' + id.replace(/[^0-9]/g, '');
    }
    return id;
  }

  function esc(s: string): string {
    const d = document.createElement('div');
    d.textContent = s;
    return d.innerHTML;
  }

  function renderTable() {
    const tbody = document.getElementById('table-body');
    if (!tbody) return;

    if (currentConfig.tables.length === 0) {
      tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;color:var(--swa-muted,#6b7280);padding:1.5rem;">No tables added yet. Use the buttons below to add tables.</td></tr>';
    } else {
      tbody.innerHTML = currentConfig.tables.map((t, i) => {
        const vipClass = t.isVIP ? ' <span class="vip-badge">VIP</span>' : '';
        return `<tr>
          <td><input type="text" value="${esc(t.id)}" style="width:70px;font-family:monospace;" data-field="id" data-index="${i}" /></td>
          <td><input type="text" value="${esc(t.label)}" class="label-input" data-field="label" data-index="${i}" /></td>
          <td><span class="ticket-prefix">${esc(t.ticketPrefix)}</span></td>
          <td><input type="number" value="${t.capacity}" min="1" style="width:60px;" data-field="capacity" data-index="${i}" /></td>
          <td><input type="checkbox" ${t.isVIP ? 'checked' : ''} data-field="isVIP" data-index="${i}" /></td>
          <td><button class="btn-remove" data-action="remove" data-index="${i}">Remove</button></td>
        </tr>`;
      }).join('');
    }

    bindTableEvents();
    updateJson();
  }

  function bindTableEvents() {
    document.querySelectorAll('#table-body input[data-field]').forEach((el) => {
      el.removeEventListener('input', handleFieldChange);
      el.addEventListener('input', handleFieldChange);
      el.removeEventListener('change', handleFieldChange);
      el.addEventListener('change', handleFieldChange);
    });

    document.querySelectorAll('#table-body button[data-action="remove"]').forEach((el) => {
      el.removeEventListener('click', handleRemove);
      el.addEventListener('click', handleRemove);
    });
  }

  function handleFieldChange(this: HTMLInputElement) {
    const index = parseInt(this.dataset.index || '0', 10);
    const field = this.dataset.field || '';
    const t = currentConfig.tables[index];
    if (!t) return;

    if (field === 'id') {
      t.id = this.value;
      t.ticketPrefix = derivePrefix(t.id, t.isVIP);
    } else if (field === 'label') {
      t.label = this.value;
    } else if (field === 'capacity') {
      t.capacity = parseInt(this.value, 10) || 10;
    } else if (field === 'isVIP') {
      t.isVIP = (this as HTMLInputElement).checked;
      t.ticketPrefix = derivePrefix(t.id, t.isVIP);
    }

    renderTable();
  }

  function handleRemove(this: HTMLButtonElement) {
    const index = parseInt(this.dataset.index || '0', 10);
    currentConfig.tables.splice(index, 1);
    renderTable();
  }

  function addRegularTable() {
    const nextNum = currentConfig.tables.filter(t => !t.isVIP).length + 1;
    const id = String(nextNum).padStart(2, '0');
    currentConfig.tables.push({ id, label: 'Table ' + nextNum, ticketPrefix: id, capacity: 10, isVIP: false });
    renderTable();
  }

  function addVIPTable() {
    const nextNum = currentConfig.tables.filter(t => t.isVIP).length + 1;
    currentConfig.tables.push({ id: 'VIP-' + nextNum, label: 'VIP-' + nextNum, ticketPrefix: 'V' + nextNum, capacity: 10, isVIP: true });
    renderTable();
  }

  function validate(): string[] {
    const errors: string[] = [];
    const cutoff = (document.getElementById('cutoff-input') as HTMLInputElement).value.trim();
    if (!cutoff) {
      errors.push('Cutoff time is required.');
    } else if (isNaN(new Date(cutoff).getTime())) {
      errors.push('Cutoff time must be a valid ISO 8601 datetime string.');
    }

    if (currentConfig.tables.length === 0) {
      errors.push('At least one table is required.');
    }

    const ids = new Set<string>();
    const prefixes = new Set<string>();
    currentConfig.tables.forEach((t) => {
      if (!t.id.trim()) errors.push('A table has an empty ID.');
      if (ids.has(t.id)) errors.push(`Duplicate table ID: "${t.id}"`);
      ids.add(t.id);
      if (!t.label.trim()) errors.push(`Table "${t.id}" has an empty label.`);
      if (!t.ticketPrefix.trim()) errors.push(`Table "${t.id}" has an empty ticket prefix.`);
      if (prefixes.has(t.ticketPrefix)) errors.push(`Duplicate ticket prefix: "${t.ticketPrefix}"`);
      prefixes.add(t.ticketPrefix);
      if (t.capacity < 1) errors.push(`Table "${t.id}" needs at least 1 seat.`);
    });

    return errors;
  }

  function showValidation(errors: string[]) {
    const el = document.getElementById('validation-error');
    if (!el) return;
    if (errors.length === 0) {
      el.style.display = 'none';
      return;
    }
    el.innerHTML = '<ul>' + errors.map(e => `<li>${esc(e)}</li>`).join('') + '</ul>';
    el.style.display = '';
  }

  function updateJson() {
    const cutoff = (document.getElementById('cutoff-input') as HTMLInputElement).value.trim();
    const config: TablesConfig = { formCutoffTime: cutoff, tables: currentConfig.tables };
    document.getElementById('json-output')!.textContent = JSON.stringify(config, null, 2);

    const errors = validate();
    showValidation(errors);
  }

  async function loadConfig() {
    try {
      const res = await fetch('/api/admin/settings?key=swa:reg_tables_config');
      if (!res.ok) {
        if (res.status === 404) {
          console.log('No existing config found. Starting with defaults.');
          renderTable();
          return;
        }
        throw new Error('Failed to load config');
      }
      const json = await res.json();
      if (json.success && json.value) {
        currentConfig = json.value as TablesConfig;
        (document.getElementById('cutoff-input') as HTMLInputElement).value = currentConfig.formCutoffTime;
      }
      renderTable();
    } catch (err) {
      console.error('Failed to load config:', err);
      renderTable();
    }
  }

  async function saveConfig() {
    const errors = validate();
    if (errors.length > 0) {
      showValidation(errors);
      return;
    }

    const value: TablesConfig = {
      formCutoffTime: (document.getElementById('cutoff-input') as HTMLInputElement).value.trim(),
      tables: currentConfig.tables,
    };

    const btn = document.getElementById('btn-save') as HTMLButtonElement;
    const status = document.getElementById('save-status')!;

    btn.disabled = true;
    status.textContent = 'Saving...';
    status.className = 'save-status saving';

    try {
      const res = await fetch('/api/admin/settings', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ key: 'swa:reg_tables_config', value }),
      });
      const json = await res.json();

      if (json.success) {
        status.textContent = 'Configuration saved successfully.';
        status.className = 'save-status success';
      } else {
        status.textContent = json.message || 'Save failed.';
        status.className = 'save-status error';
      }
    } catch (err) {
      status.textContent = 'Network error. Please try again.';
      status.className = 'save-status error';
    }

    btn.disabled = false;
    setTimeout(() => {
      if (status.className.includes('success')) {
        status.textContent = '';
        status.className = 'save-status';
      }
    }, 4000);
  }

  function copyJson() {
    const errors = validate();
    if (errors.length > 0) {
      showValidation(errors);
      return;
    }
    const text = document.getElementById('json-output')!.textContent || '';
    navigator.clipboard.writeText(text).then(() => {
      const msg = document.getElementById('copy-msg')!;
      msg.style.display = 'inline';
      setTimeout(() => { msg.style.display = 'none'; }, 2000);
    });
  }

  function init(data: SessionResponse) {
    document.getElementById('btn-add-regular')!.addEventListener('click', addRegularTable);
    document.getElementById('btn-add-vip')!.addEventListener('click', addVIPTable);
    document.getElementById('btn-save')!.addEventListener('click', saveConfig);
    document.getElementById('btn-copy-json')!.addEventListener('click', copyJson);
    document.getElementById('cutoff-input')!.addEventListener('input', updateJson);

    loadConfig();
  }

  requireItAdmin(init, { feature: 'events' });
</script>
