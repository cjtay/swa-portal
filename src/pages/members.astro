---
import AdminLayout from '../layouts/AdminLayout.astro';
---

<AdminLayout title="Members — SWA Admin Portal" currentPath="/members">
  <h1>Members</h1>
  <p style="color:var(--text-muted);margin-bottom:1.5rem;">View and manage the member directory.</p>

  <div class="card">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;">
      <div style="display:flex;gap:0.5rem;align-items:center;">
        <input type="search" id="search-input" class="form-input" placeholder="Search members..." style="width:240px;" />
        <select id="category-filter" class="form-input" style="width:auto;">
          <option value="">All categories</option>
          <option value="committee">Committee</option>
          <option value="member">Member</option>
          <option value="admin">Admin</option>
          <option value="volunteer">Volunteer</option>
        </select>
      </div>
      <button class="btn btn-primary" id="add-member-btn" style="display:none;">Add Member</button>
    </div>
    <table class="data-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Role</th>
          <th>Email</th>
          <th>Category</th>
          <th>Namecard</th>
          <th>Login</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody id="members-list"></tbody>
    </table>
  </div>

  <!-- Edit Modal -->
  <div id="edit-modal" style="display:none;position:fixed;inset:0;background:rgba(69,10,94,0.4);z-index:50;align-items:center;justify-content:center;">
    <div class="card" style="width:480px;max-height:80vh;overflow-y:auto;">
      <h2 id="modal-title">Add Member</h2>
      <form id="member-form" style="margin-top:1rem;">
        <input type="hidden" id="member-id" />
        <div class="form-group">
          <label class="form-label">Name</label>
          <input type="text" id="m-name" class="form-input" required />
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.75rem;">
          <div class="form-group">
            <label class="form-label">Role</label>
            <input type="text" id="m-role" class="form-input" />
          </div>
          <div class="form-group">
            <label class="form-label">Category</label>
              <select id="m-category" class="form-input">
                <option value="committee">Committee</option>
                <option value="member">Member</option>
                <option value="admin">Admin</option>
                <option value="volunteer">Volunteer</option>
              </select>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">Email</label>
          <input type="email" id="m-email" class="form-input" />
        </div>
        <div class="form-group">
          <label class="form-label">Mobile</label>
          <input type="text" id="m-mobile" class="form-input" />
        </div>
        <div class="form-group">
          <label class="form-label">Job Title</label>
          <input type="text" id="m-job-title" class="form-input" />
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:0.75rem;">
          <label style="display:flex;align-items:center;gap:0.5rem;font-size:0.85rem;">
            <input type="checkbox" id="m-show-on-website" checked style="accent-color:var(--swa-3);" />
            Show on website
          </label>
          <label style="display:flex;align-items:center;gap:0.5rem;font-size:0.85rem;">
            <input type="checkbox" id="m-has-namecard" style="accent-color:var(--swa-3);" />
            Has namecard
          </label>
          <label style="display:flex;align-items:center;gap:0.5rem;font-size:0.85rem;">
            <input type="checkbox" id="m-can-login" style="accent-color:var(--swa-3);" />
            Can log in
          </label>
        </div>
        <div style="display:flex;gap:0.5rem;margin-top:1.5rem;">
          <button type="submit" class="btn btn-primary">Save</button>
          <button type="button" class="btn btn-secondary" id="cancel-edit">Cancel</button>
        </div>
        <p id="member-form-error" class="form-error" style="display:none;"></p>
      </form>
    </div>
  </div>
</AdminLayout>

<script>
  import { requireAuth } from '../scripts/auth-gate';

  let allMembers: any[] = [];
  let isAdmin = false;

  async function loadMembers() {
    try {
      const res = await fetch('/api/members');
      const data = await res.json();
      if (data.success) {
        allMembers = data.members;
        renderMembers();
      } else if (data.error_code === 'FORBIDDEN') {
        const tbody = document.getElementById('members-list')!;
        tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;color:var(--danger);">You do not have permission to view members.</td></tr>';
      }
    } catch (err) {
      console.error('Failed to load members', err);
    }
  }

  function renderMembers() {
    const search = (document.getElementById('search-input') as HTMLInputElement).value.toLowerCase();
    const category = (document.getElementById('category-filter') as HTMLSelectElement).value;

    const filtered = allMembers.filter((m: any) => {
      if (category && m.category !== category) return false;
      if (search && !m.name.toLowerCase().includes(search) && !(m.email || '').toLowerCase().includes(search) && !(m.role || '').toLowerCase().includes(search)) return false;
      return true;
    });

    const tbody = document.getElementById('members-list')!;
    tbody.innerHTML = filtered.map((m: any) => {
      return `<tr>
        <td>${m.name}</td>
        <td>${m.role || '—'}</td>
        <td>${m.email || '—'}</td>
        <td>${m.category}</td>
        <td><span class="badge ${m.has_namecard ? 'badge-approved' : 'badge-cancelled'}">${m.has_namecard ? 'Yes' : 'No'}</span></td>
        <td><span class="badge ${m.can_login ? 'badge-approved' : 'badge-cancelled'}">${m.can_login ? 'Yes' : 'No'}</span></td>
        <td>${isAdmin ? `<button class="btn btn-secondary" style="padding:0.3rem 0.6rem;font-size:0.75rem;" onclick="editMember(${m.id})">Edit</button>` : '—'}</td>
      </tr>`;
    }).join('');
  }

  // @ts-ignore
  window.editMember = (id: number) => {
    const m = allMembers.find((x: any) => x.id === id);
    if (!m) return;
    (document.getElementById('member-id') as HTMLInputElement).value = String(m.id);
    (document.getElementById('m-name') as HTMLInputElement).value = m.name || '';
    (document.getElementById('m-role') as HTMLInputElement).value = m.role || '';
    (document.getElementById('m-category') as HTMLSelectElement).value = m.category || 'committee';
    (document.getElementById('m-email') as HTMLInputElement).value = m.email || '';
    (document.getElementById('m-mobile') as HTMLInputElement).value = m.mobile || '';
    (document.getElementById('m-job-title') as HTMLInputElement).value = m.job_title || '';
    (document.getElementById('m-show-on-website') as HTMLInputElement).checked = !!m.show_on_website;
    (document.getElementById('m-has-namecard') as HTMLInputElement).checked = !!m.has_namecard;
    (document.getElementById('m-can-login') as HTMLInputElement).checked = !!m.can_login;
    (document.getElementById('modal-title') as HTMLElement).textContent = 'Edit Member';
    (document.getElementById('edit-modal') as HTMLElement).style.display = 'flex';
  };

  document.getElementById('search-input')!.addEventListener('input', renderMembers);
  document.getElementById('category-filter')!.addEventListener('change', renderMembers);
  document.getElementById('cancel-edit')!.addEventListener('click', () => {
    (document.getElementById('edit-modal') as HTMLElement).style.display = 'none';
  });

  document.getElementById('add-member-btn')!.addEventListener('click', () => {
    (document.getElementById('member-form') as HTMLFormElement).reset();
    (document.getElementById('member-id') as HTMLInputElement).value = '';
    (document.getElementById('modal-title') as HTMLElement).textContent = 'Add Member';
    (document.getElementById('m-show-on-website') as HTMLInputElement).checked = true;
    (document.getElementById('m-can-login') as HTMLInputElement).checked = false;
    (document.getElementById('edit-modal') as HTMLElement).style.display = 'flex';
  });

  document.getElementById('member-form')!.addEventListener('submit', async (e) => {
    e.preventDefault();
    const errEl = document.getElementById('member-form-error')!;
    errEl.style.display = 'none';

    const id = (document.getElementById('member-id') as HTMLInputElement).value;
    const payload = {
      name: (document.getElementById('m-name') as HTMLInputElement).value,
      role: (document.getElementById('m-role') as HTMLInputElement).value,
      category: (document.getElementById('m-category') as HTMLSelectElement).value,
      email: (document.getElementById('m-email') as HTMLInputElement).value,
      mobile: (document.getElementById('m-mobile') as HTMLInputElement).value,
      job_title: (document.getElementById('m-job-title') as HTMLInputElement).value,
      show_on_website: (document.getElementById('m-show-on-website') as HTMLInputElement).checked ? 1 : 0,
      has_namecard: (document.getElementById('m-has-namecard') as HTMLInputElement).checked ? 1 : 0,
      can_login: (document.getElementById('m-can-login') as HTMLInputElement).checked ? 1 : 0,
    };

    try {
      const url = id ? `/api/members/${id}` : '/api/members';
      const method = id ? 'PATCH' : 'POST';
      const res = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await res.json();
      if (data.success) {
        (document.getElementById('edit-modal') as HTMLElement).style.display = 'none';
        loadMembers();
      } else {
        errEl.textContent = data.message || 'Save failed.';
        errEl.style.display = '';
      }
    } catch {
      errEl.textContent = 'Network error.';
      errEl.style.display = '';
    }
  });

  requireAuth({
    onAuthenticated(data: any) {
      isAdmin = data.is_admin || false;
      const addBtn = document.getElementById('add-member-btn') as HTMLButtonElement;
      if (addBtn) addBtn.style.display = isAdmin ? '' : 'none';
      loadMembers();
    },
  });
</script>