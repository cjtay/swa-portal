---
import '../styles/admin.css';
---

<style is:global>
  /* Dev-only role-picker card. Only rendered when /api/dev/members returns
     200 (i.e. DEV_BYPASS_AUTH is active) — so this markup never ships to a
     production browser in a visible state. */
  .dev-card {
    background: var(--swa-card-bg, #fff);
    border: 1px solid var(--swa-4, #f3d2ff);
    border-radius: 12px;
    padding: 1.25rem 1.25rem 0.5rem;
    margin-bottom: 1rem;
    box-shadow: 0 4px 20px rgba(69, 10, 94, 0.06);
  }
  .dev-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.4rem;
  }
  .dev-card-header > span:first-child {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--swa-2, #450a5e);
  }
  .dev-badge {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    background: var(--swa-4, #f3d2ff);
    color: var(--swa-2, #450a5e);
  }
  .dev-hint {
    font-size: 0.72rem;
    color: var(--text-muted, #6b7280);
    margin: 0 0 0.85rem;
    line-height: 1.4;
  }
  .dev-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .dev-btn {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto;
    grid-template-areas:
      "name role"
      "email role";
    column-gap: 0.75rem;
    align-items: baseline;
    width: 100%;
    padding: 0.6rem 0.85rem;
    border: 1px solid var(--swa-4, #f3d2ff);
    border-radius: 8px;
    background: #fff;
    color: var(--swa-2, #450a5e);
    cursor: pointer;
    font: inherit;
    text-align: left;
    transition: border-color 0.15s, background 0.15s;
  }
  .dev-btn:hover:not(:disabled) {
    border-color: var(--swa-3, #874ba1);
    background: #faf5ff;
  }
  .dev-btn:disabled { cursor: default; opacity: 0.6; }
  .dev-btn-name { grid-area: name; font-weight: 600; font-size: 0.88rem; }
  .dev-btn-email { grid-area: email; font-size: 0.72rem; color: var(--text-muted, #6b7280); }
  .dev-btn-role {
    grid-area: role;
    align-self: center;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: var(--swa-1, #70308c);
    color: #fff;
    white-space: nowrap;
  }
  .dev-btn-role[data-role="admin"],
  .dev-btn-role[data-role="it-admin"] { background: var(--swa-2, #450a5e); }
  .dev-btn-role[data-role="volunteer"] { background: #6b7280; }
  .dev-divider {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 1rem 0 0.25rem;
    font-size: 0.68rem;
    color: var(--text-muted, #6b7280);
  }
  .dev-divider::before,
  .dev-divider::after {
    content: "";
    flex: 1;
    height: 1px;
    background: var(--swa-4, #f3d2ff);
  }
</style>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow, noarchive, nosnippet, notranslate, noimageindex" />
  <title>Login — SWA Admin Portal</title>
  <link rel="icon" type="image/webp" href="/swa-logo.webp" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
</head>
<body>
  <div class="login-wrapper">
    <div id="dev-login" class="dev-card" hidden>
      <div class="dev-card-header">
        <span>Dev quick login</span>
        <span class="dev-badge">LOCAL</span>
      </div>
      <p class="dev-hint">One-click login as any login-capable member. Skips OTP — for local role testing only.</p>
      <div id="dev-list" class="dev-list"></div>
      <div class="dev-divider"><span>or use email login below</span></div>
    </div>
    <div class="login-card">
      <div class="login-header">
        <h1><img src="/swalogo.svg" alt="SWA" style="height:28px;width:28px;vertical-align:middle;margin-right:0.4rem;border-radius:3px;" /><span>SWA</span> Admin Portal</h1>
        <p>Admin access — login with email</p>
      </div>
      <div class="login-body">
        <div id="step-email">
          <div class="form-group">
            <label class="form-label" for="email-input">Email Address</label>
            <input type="email" id="email-input" class="form-input" placeholder="you@singaporewomenassociation.org" autocomplete="email" />
          </div>
          <label style="display:flex;align-items:center;gap:0.5rem;margin-bottom:1rem;font-size:0.8rem;color:var(--text-muted);cursor:pointer;">
            <input type="checkbox" id="remember-me" style="accent-color:var(--swa-3);" />
            Remember me (30 days)
          </label>
          <p style="font-size:0.7rem;color:var(--text-muted);margin-bottom:1rem;">Sessions expire after 12 hours by default. Tick "Remember me" to stay logged in for 30 days. Do not use this option on a shared computer.</p>
          <button class="btn btn-primary" id="btn-send-otp" style="width:100%;" disabled>Send Login Code</button>
          <div id="turnstile-container" style="display:flex;justify-content:center;margin-top:0.75rem;"></div>
          <p id="email-error" class="form-error" style="display:none;"></p>
          <p style="font-size:0.7rem;color:var(--text-muted);margin-top:0.75rem;text-align:center;">Only members with login access can receive a code. If you don't receive one, contact an admin.</p>
        </div>

        <div id="step-otp" style="display:none;">
          <p style="font-size:0.85rem;color:var(--text-muted);margin-bottom:1.5rem;">A 6-digit code has been sent to <strong id="otp-email-display"></strong>. It expires in 5 minutes.</p>
          <div class="form-group">
            <label class="form-label" for="otp-input">Enter Code</label>
            <input type="text" id="otp-input" class="form-input" maxlength="6" inputmode="numeric" pattern="\d{6}" placeholder="000000" autocomplete="one-time-code" style="font-family:'Courier New',monospace;font-size:1.4rem;letter-spacing:0.5em;text-align:center;" />
          </div>
          <button class="btn btn-primary" id="btn-verify-otp" style="width:100%;">Verify</button>
          <p id="otp-error" class="form-error" style="display:none;"></p>
          <button class="btn btn-secondary" id="btn-back" style="width:100%;margin-top:0.5rem;">Use a different email</button>
        </div>
      </div>
    </div>
  </div>
</body>
</html>

<script>
  import { redirectIfAuthenticated } from '../scripts/auth-gate';
  redirectIfAuthenticated();

  // --- Dev-only role picker ------------------------------------------------
  // Populates the #dev-login card with one-click buttons for every
  // login-capable member. /api/dev/members 404s in production, so the panel
  // stays hidden there. Only renders when DEV_BYPASS_AUTH is active.
  async function initDevLogin() {
    let res;
    try {
      res = await fetch('/api/dev/members');
    } catch {
      return;
    }
    if (!res.ok) return;
    const data = await res.json().catch(() => null);
    if (!data || !data.success || !Array.isArray(data.members) || data.members.length === 0) return;

    const panel = document.getElementById('dev-login');
    const list = document.getElementById('dev-list');
    if (!panel || !list) return;

    const roleLabel = (m: any): string => {
      if (m.is_it_admin) return 'IT Admin';
      if (m.role === 'admin') return 'Admin';
      if (m.role === 'volunteer') return 'Volunteer';
      if (m.role === 'committee') return 'Committee';
      return m.role || m.category || 'Member';
    };
    const roleKey = (m: any): string => {
      if (m.is_it_admin) return 'it-admin';
      if (m.role === 'admin') return 'admin';
      if (m.role === 'volunteer') return 'volunteer';
      return 'committee';
    };

    for (const m of data.members) {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'dev-btn';

      const nameEl = document.createElement('span');
      nameEl.className = 'dev-btn-name';
      nameEl.textContent = m.name || m.email;

      const emailEl = document.createElement('span');
      emailEl.className = 'dev-btn-email';
      emailEl.textContent = m.email;

      const roleEl = document.createElement('span');
      roleEl.className = 'dev-btn-role';
      roleEl.dataset.role = roleKey(m);
      roleEl.textContent = roleLabel(m);

      btn.append(nameEl, emailEl, roleEl);
      btn.addEventListener('click', () => devLoginAs(m.email, btn));
      list.appendChild(btn);
    }

    panel.hidden = false;
  }

  async function devLoginAs(email: string, btn: HTMLButtonElement) {
    if (btn.disabled) return;
    const original = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<span class="dev-btn-name">Logging in…</span>';
    try {
      const res = await fetch('/api/dev/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email }),
      });
      const json = await res.json().catch(() => null);
      if (json && json.success) {
        const fallback = json.role === 'volunteer' ? '/reg/volunteer/search' : '/';
        const target = new URLSearchParams(window.location.search).get('redirect') || fallback;
        window.location.href = target;
        return;
      }
      alert((json && json.message) || 'Login failed.');
    } catch {
      alert('Network error.');
    }
    btn.disabled = false;
    btn.innerHTML = original;
  }

  initDevLogin();
  // -------------------------------------------------------------------------

  const emailInput = document.getElementById('email-input') as HTMLInputElement;
  const otpInput = document.getElementById('otp-input') as HTMLInputElement;
  const stepEmail = document.getElementById('step-email')!;
  const stepOtp = document.getElementById('step-otp')!;
  const emailError = document.getElementById('email-error')!;
  const otpError = document.getElementById('otp-error')!;
  const otpEmailDisplay = document.getElementById('otp-email-display')!;
  const btnSendOtp = document.getElementById('btn-send-otp') as HTMLButtonElement;
  const btnVerifyOtp = document.getElementById('btn-verify-otp') as HTMLButtonElement;
  const btnBack = document.getElementById('btn-back') as HTMLButtonElement;
  const turnstileContainer = document.getElementById('turnstile-container')!;

  let turnstileToken: string | null = null;
  let turnstileWidgetId: string | null = null;
  let turnstileSiteKey = '';

  async function initTurnstile() {
    try {
      const res = await fetch('/api/turnstile-config');
      const data = await res.json();
      turnstileSiteKey = data.siteKey;
    } catch {
      emailError.textContent = 'Could not load security configuration.';
      emailError.style.display = '';
      return;
    }

    if (!turnstileSiteKey) {
      // No Turnstile configured (e.g. local dev with the dev bypass active):
      // send-otp.ts skips siteverify in dev, so allow proceeding without a token.
      btnSendOtp.disabled = false;
      return;
    }

    if (!(window as any).turnstile) {
      emailError.textContent = 'Security verification unavailable. Please refresh.';
      emailError.style.display = '';
      return;
    }

    turnstileWidgetId = (window as any).turnstile.render('#turnstile-container', {
      sitekey: turnstileSiteKey,
      callback: (token: string) => {
        turnstileToken = token;
        btnSendOtp.disabled = false;
      },
      'error-callback': () => {
        emailError.textContent = 'Security verification failed. Please refresh.';
        emailError.style.display = '';
      },
      'expired-callback': () => {
        turnstileToken = null;
        btnSendOtp.disabled = true;
      },
    });
  }

  initTurnstile();

  btnSendOtp.addEventListener('click', async () => {
    const email = emailInput.value.trim();
    if (!email) { emailError.textContent = 'Please enter your email address.'; emailError.style.display = ''; return; }

    if (!turnstileToken) {
      emailError.textContent = 'Please complete the security verification.';
      emailError.style.display = '';
      return;
    }

    emailError.style.display = 'none';
    btnSendOtp.disabled = true;
    btnSendOtp.textContent = 'Sending...';

    try {
      const res = await fetch('/api/send-otp', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, turnstileToken }),
      });
      const json = await res.json();
      if (json.success) {
        otpEmailDisplay.textContent = email;
        stepEmail.style.display = 'none';
        stepOtp.style.display = '';
        otpInput.focus();
      } else {
        emailError.textContent = json.message || 'Could not send code.';
        emailError.style.display = '';
        if ((window as any).turnstile && turnstileWidgetId) {
          (window as any).turnstile.reset(turnstileWidgetId);
        }
        turnstileToken = null;
        btnSendOtp.disabled = true;
      }
    } catch {
      emailError.textContent = 'Network error. Please try again.';
      emailError.style.display = '';
      btnSendOtp.disabled = false;
    }
    btnSendOtp.textContent = 'Send Login Code';
  });

  emailInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') btnSendOtp.click(); });

  otpInput.addEventListener('input', function () {
    this.value = this.value.replace(/\D/g, '').slice(0, 6);
  });

  btnVerifyOtp.addEventListener('click', async () => {
    const email = emailInput.value.trim();
    const otp = otpInput.value.trim();
    if (!otp || otp.length < 6) { otpError.textContent = 'Please enter the 6-digit code.'; otpError.style.display = ''; return; }

    otpError.style.display = 'none';
    btnVerifyOtp.disabled = true;
    btnVerifyOtp.textContent = 'Verifying...';

    try {
      const res = await fetch('/api/verify-otp', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, otp, remember: (document.getElementById('remember-me') as HTMLInputElement).checked }),
      });
      const json = await res.json();
      if (json.success) {
        // Check-in volunteers go straight to the search page; everyone else
        // honours ?redirect= or lands on the dashboard.
        const fallback = json.role === 'volunteer' ? '/reg/volunteer/search' : '/';
        const target = new URLSearchParams(window.location.search).get('redirect') || fallback;
        window.location.href = target;
      } else {
        otpError.textContent = json.message || 'Verification failed.';
        otpError.style.display = '';
      }
    } catch {
      otpError.textContent = 'Network error. Please try again.';
      otpError.style.display = '';
    }
    btnVerifyOtp.disabled = false;
    btnVerifyOtp.textContent = 'Verify';
  });

  otpInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') btnVerifyOtp.click(); });

  btnBack.addEventListener('click', () => {
    stepOtp.style.display = 'none';
    stepEmail.style.display = '';
    otpInput.value = '';
    otpError.style.display = 'none';
    emailInput.focus();
    if ((window as any).turnstile && turnstileWidgetId) {
      (window as any).turnstile.reset(turnstileWidgetId);
      turnstileToken = null;
      btnSendOtp.disabled = true;
    }
  });
</script>