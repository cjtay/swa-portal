---
// Public buyer form page — NO AdminLayout, no auth gate
// Token is read from ?token= query parameter
import '../../../styles/admin.css';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow, noarchive" />
  <title>Guest Registration — SWA</title>
  <link rel="icon" type="image/webp" href="/swa-logo.webp" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    .buyer-header { background: var(--swa-2); color: #fff; padding: 2rem 1rem; text-align: center; }
    .buyer-header h1 { font-size: 1.3rem; font-weight: 700; }
    .buyer-header p { font-size: 0.85rem; opacity: 0.8; margin-top: 0.25rem; }
    .buyer-container { max-width: 600px; margin: 1.5rem auto; padding: 0 1rem; }
    .buyer-info { text-align: center; padding: 1rem 1rem 0.5rem; }
    .buyer-info h2 { font-size: 1.1rem; color: var(--swa-1); }
    .buyer-info p { color: var(--text-muted); font-size: 0.85rem; margin-top: 0.25rem; }
    .guest-row.buyer-row { border-left: 3px solid var(--swa-3); }
    .guest-name-display { font-weight: 600; font-size: 0.95rem; }
    .guest-ticket { font-family: monospace; font-size: 0.8rem; color: var(--text-muted); margin-top: 0.15rem; }
    .buyer-footer { text-align: center; font-size: 0.75rem; color: var(--text-muted); padding: 2rem 0; }
    .load-error { text-align: center; padding: 3rem 1rem; }
    .load-error h2 { color: var(--danger); }
  </style>
</head>
<body>
  <div class="buyer-header">
    <h1>49th SWA Annual Charity Dinner 2026</h1>
    <p>Guest Registration</p>
  </div>

  <div class="buyer-container" id="buyer-app">
    <div id="loading" style="text-align:center;padding:3rem 0;color:var(--text-muted);">Loading...</div>
    <div id="error-view" class="load-error" style="display:none;"></div>
    <div id="closed-view" class="load-error" style="display:none;">
      <h2 id="closed-title">Registration Unavailable</h2>
      <p id="closed-reason" style="margin-top:0.5rem;color:var(--text-muted);"></p>
      <p style="margin-top:1rem;color:var(--text-muted);">If you have any questions, please contact SWA directly.</p>
    </div>
    <div id="form-view" style="display:none;">
      <div class="buyer-info">
        <h2 id="buyer-name-heading"></h2>
        <p id="booking-info"></p>
      </div>
      <p style="font-size:0.85rem;color:var(--text-muted);margin:1rem 0;text-align:center;" id="instruction-text"></p>
      <div id="guest-list"></div>
      <div id="last-updated" style="font-size:0.75rem;color:var(--text-muted);text-align:center;margin-top:1rem;"></div>
    </div>
  </div>

  <div class="buyer-footer">
    Singapore Women's Association<br>
    These details are used for event registration. Individual e-tickets will be sent separately by SWA.
  </div>
</body>
</html>

<script>
  const params = new URLSearchParams(window.location.search);
  const token = params.get('token') || '';

  const loading = document.getElementById('loading') as HTMLElement;
  const errorView = document.getElementById('error-view') as HTMLElement;
  const closedView = document.getElementById('closed-view') as HTMLElement;
  const closedReason = document.getElementById('closed-reason') as HTMLElement;
  const formView = document.getElementById('form-view') as HTMLElement;
  const buyerNameHeading = document.getElementById('buyer-name-heading') as HTMLElement;
  const bookingInfo = document.getElementById('booking-info') as HTMLElement;
  const instructionText = document.getElementById('instruction-text') as HTMLElement;
  const guestList = document.getElementById('guest-list') as HTMLElement;
  const lastUpdated = document.getElementById('last-updated') as HTMLElement;

  declare global {
  interface Window {
    toggleEdit: (i: number) => void;
    saveGuest: (i: number) => Promise<void>;
  }
}

interface GuestRow { id: number; guest_name?: string | null; notes?: string | null; ticket_code?: string; is_buyer?: boolean }
  let guests: GuestRow[] = [];

  function esc(s: string | null | undefined) {
    const d = document.createElement('div');
    d.textContent = s || '';
    return d.innerHTML;
  }

  if (!token) {
    loading.style.display = 'none';
    closedView.style.display = '';
    closedReason.textContent = 'This link is invalid or has expired.';
  } else {
    loadData();
  }

  async function loadData() {
    try {
      const res = await fetch(`/api/reg/buyer/${token}`);
      if (res.status === 503) {
        // Feature disabled (feature-flags.ts) — treat like a closed form
        // rather than an error.
        loading.style.display = 'none';
        closedView.style.display = '';
        closedReason.textContent = 'Guest registration is currently unavailable. If you have any questions, please contact SWA directly.';
        return;
      }
      if (!res.ok) {
        throw new Error(`Server error: ${res.status}`);
      }
      const data = await res.json();

      if (data.closed) {
        loading.style.display = 'none';
        closedView.style.display = '';
        if (data.reason === 'cutoff') {
          closedReason.textContent = 'Guest registration has closed for this event. If you have any questions, please contact SWA directly.';
        } else {
          closedReason.textContent = 'This link is invalid or has expired.';
        }
        return;
      }

      guests = data.guests;
      buyerNameHeading.textContent = data.booking.buyer_name;
      bookingInfo.textContent = `${data.booking.booking_ref} — ${data.booking.table_label} — ${data.booking.pax} guest${data.booking.pax !== 1 ? 's' : ''}`;
      instructionText.textContent = `Please add the names of your guests below. You can return to this page any time before ${data.formCutoffFormatted} to make changes.`;

      renderGuests();
      loading.style.display = 'none';
      formView.style.display = '';
    } catch (err) {
      loading.style.display = 'none';
      errorView.innerHTML = '<h2>Something went wrong</h2><p style="margin-top:0.5rem;color:var(--text-muted);">Please try again later.</p>';
      errorView.style.display = '';
    }
  }

  function renderGuests() {
    guestList.innerHTML = guests.map((g: GuestRow, i: number) => {
      const hasName = g.guest_name && g.guest_name.trim();
      const isBuyer = g.is_buyer;

      return `<div class="card guest-row${isBuyer ? ' buyer-row' : ''}" data-index="${i}" style="margin-bottom:0.75rem;">
        <div style="display:flex;justify-content:space-between;align-items:start;margin-bottom:0.5rem;">
          <div>
            <span style="font-size:0.85rem;font-weight:600;color:var(--text-muted);">Seat ${i + 1}${isBuyer ? ' (Buyer)' : ''}</span>
            <div class="guest-name-display" id="name-display-${i}" style="${hasName ? '' : 'color:var(--text-muted);font-style:italic;'}">
              ${hasName ? esc(g.guest_name) : 'Enter guest name'}
            </div>
          </div>
          <div style="display:flex;gap:0.25rem;align-items:center;">
            ${hasName ? `<span class="badge badge-approved">Saved</span><button class="btn btn-secondary" style="padding:0.3rem 0.75rem;font-size:0.75rem;" onclick="toggleEdit(${i})">Edit</button>` : ''}
          </div>
        </div>
        <div class="guest-ticket">Ticket reference: ${esc(g.ticket_code)}</div>
        <div id="form-${i}" style="${hasName ? 'display:none;' : ''}margin-top:0.75rem;">
          <div class="form-group" style="margin-bottom:0.5rem;">
            <label class="form-label" for="input-name-${i}">Guest Name</label>
            <input type="text" class="form-input" id="input-name-${i}" placeholder="Enter guest name" value="${esc(g.guest_name || '')}" />
          </div>
          <div class="form-group" style="margin-bottom:0.75rem;">
            <label class="form-label" for="input-notes-${i}">Dietary / Accessibility Requirements</label>
            <input type="text" class="form-input" id="input-notes-${i}" placeholder="Optional" value="${esc(g.notes || '')}" />
          </div>
          <button class="btn btn-primary" onclick="saveGuest(${i})">Save</button>
        </div>
      </div>`;
    }).join('');
  }

  window.toggleEdit = (i: number) => {
    const form = document.getElementById(`form-${i}`) as HTMLElement;
    form.style.display = form.style.display === 'none' ? '' : 'none';
  };

  window.saveGuest = async (i: number) => {
    const nameInput = document.getElementById(`input-name-${i}`) as HTMLInputElement;
    const notesInput = document.getElementById(`input-notes-${i}`) as HTMLInputElement;
    const name = nameInput.value.trim();
    const notes = notesInput.value.trim();

    if (!name) {
      nameInput.style.borderColor = 'var(--danger)';
      return;
    }
    nameInput.style.borderColor = '';

    try {
      const res = await fetch(`/api/reg/buyer/${token}/guests/${guests[i].id}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ guest_name: name, notes: notes || undefined }),
      });

      if (res.status === 403) {
        const data = await res.json();
        if (data.closed) {
          window.location.reload();
          return;
        }
      }

      const data = await res.json();
      if (data.success) {
        guests[i].guest_name = name;
        guests[i].notes = notes;
        renderGuests();
        lastUpdated.textContent = `Last updated: ${new Date().toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' })}`;
      } else {
        alert(data.message || 'Failed to save.');
      }
    } catch {
      alert('Network error. Please try again.');
    }
  };
</script>
