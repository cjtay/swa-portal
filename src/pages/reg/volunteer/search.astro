---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Guest Search — SWA Registration" currentPath="/reg/volunteer/search">
  <h1 style="font-size:1.25rem;">Guest Search</h1>
  <p style="color:var(--text-muted);margin-bottom:1rem;font-size:0.9rem;">Search by name or ticket code. Tap "Mark Arrived" to check in.</p>

  <div id="search-app">
    <div style="display:flex;gap:0.5rem;margin-bottom:1rem;">
      <input type="search" id="search-input" class="form-input" placeholder="Name or ticket code..." style="flex:1;font-size:1.1rem;padding:0.75rem;" autofocus />
      <select id="table-filter" class="form-input" style="width:auto;font-size:1rem;">
        <option value="">All tables</option>
      </select>
    </div>

    <div id="results-list"></div>
    <p id="no-results" style="display:none;color:var(--text-muted);text-align:center;padding:2rem 0;">
      No guests found. Try a different name or ticket code, or add a walk-in guest.
    </p>
  </div>
</AdminLayout>

<script>
  import { requireRegVolunteer } from '../../../scripts/auth-gate';

  let tables: { id: string; label: string; isVIP: boolean }[] = [];
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const tableFilter = document.getElementById('table-filter') as HTMLSelectElement;
  const resultsList = document.getElementById('results-list')!;
  const noResults = document.getElementById('no-results')!;

  function esc(s: string): string {
    const d = document.createElement('div');
    d.textContent = s || '';
    return d.innerHTML;
  }

  let searchTimeout: ReturnType<typeof setTimeout>;
  searchInput.addEventListener('input', () => {
    clearTimeout(searchTimeout);
    searchTimeout = setTimeout(doSearch, 250);
  });
  tableFilter.addEventListener('change', doSearch);

  async function doSearch() {
    const q = searchInput.value.trim();
    const tableId = tableFilter.value;
    const params = new URLSearchParams();
    if (q) params.set('q', q);
    if (tableId) params.set('table', tableId);

    if (!q) {
      resultsList.innerHTML = '';
      noResults.style.display = 'none';
      return;
    }

    try {
      const res = await fetch(`/api/reg/volunteer/search?${params.toString()}`);
      const data = await res.json();
      if (data.success) {
        renderResults(data.results);
      }
    } catch (err) {
      console.error('Search failed', err);
    }
  }

  function renderResults(results: any[]) {
    if (results.length === 0) {
      resultsList.innerHTML = '';
      noResults.style.display = '';
      return;
    }
    noResults.style.display = 'none';

    resultsList.innerHTML = results.map((g: any) => {
      const arrived = !!g.arrived_at;
      const vipBadge = g.is_walk_in ? ' <span style="background:var(--swa-3);color:#fff;font-size:0.7rem;padding:0.1rem 0.4rem;border-radius:3px;">Walk-in</span>' : '';
      const buyerBadge = g.is_buyer ? ' <span style="background:var(--swa-1);color:#fff;font-size:0.7rem;padding:0.1rem 0.4rem;border-radius:3px;">Buyer</span>' : '';
      const noteHtml = g.notes
        ? `<div style="background:rgba(217,119,6,0.15);padding:0.4rem 0.6rem;border-radius:4px;font-size:0.85rem;margin-top:0.5rem;color:#92400e;">Staff note: ${esc(g.notes)}</div>`
        : '';

      let nameHtml;
      if (g.guest_name) {
        nameHtml = `<div style="font-size:1.1rem;font-weight:600;">${esc(g.guest_name)}${buyerBadge}${vipBadge}</div>`;
      } else if (arrived) {
        nameHtml = `<div style="font-size:1.1rem;font-weight:600;"><span style="color:var(--text-muted);font-style:italic;">No name</span>${buyerBadge}${vipBadge}</div>`;
      } else {
        // editable name field
        const inputId = `guest-name-${g.id}`;
        nameHtml = `<div style="display:flex;gap:0.5rem;align-items:center;flex-wrap:wrap;">
          <input type="text" id="${inputId}" class="form-input" placeholder="Guest name" value="" style="flex:1;min-width:120px;" />
          <button class="btn btn-secondary" style="font-size:0.85rem;padding:0.4rem 0.8rem;" onclick="saveGuestName('${g.id}')">Save</button>
        </div>`;
      }

      const buyerLine = g.buyer_name
        ? `<div style="color:var(--text-muted);font-size:0.85rem;margin-top:0.15rem;">Buyer: ${esc(g.buyer_name)}</div>`
        : '';

      const actionHtml = arrived
        ? `<div style="color:var(--text-muted);font-size:0.85rem;">Arrived at ${new Date(g.arrived_at).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' })}</div>`
        : `<button class="btn btn-primary" style="font-size:1rem;padding:0.6rem 1.2rem;width:100%;" onclick="markArrived('${g.id}')">Mark Arrived</button>`;

      return `<div style="background:var(--bg-card);border:1px solid var(--border);border-radius:8px;padding:1rem;margin-bottom:0.75rem;">
        <div style="display:flex;justify-content:space-between;align-items:start;">
          <div style="flex:1;">
            ${nameHtml}
            <div style="color:var(--text-muted);font-size:0.9rem;margin-top:0.2rem;">Ticket: <span style="font-family:monospace;">${esc(g.ticket_code)}</span> &middot; ${esc(g.table_label)}</div>
            ${buyerLine}
          </div>
        </div>
        ${noteHtml}
        <div style="margin-top:0.75rem;">${actionHtml}</div>
      </div>`;
    }).join('');
  }

  // @ts-ignore
  window.saveGuestName = async (id: string) => {
    const input = document.getElementById(`guest-name-${id}`) as HTMLInputElement;
    const guestName = input.value.trim();
    if (!guestName) {
      alert('Please enter a guest name (or "NA" if unknown).');
      return;
    }
    try {
      const res = await fetch(`/api/reg/volunteer/guest/${id}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ guest_name: guestName }),
      });
      const data = await res.json();
      if (data.success) {
        doSearch();
      } else {
        alert(data.message || 'Failed to save name.');
      }
    } catch {
      alert('Network error. Please try again.');
    }
  };

  // @ts-ignore
  window.markArrived = async (id: string) => {
    try {
      const res = await fetch(`/api/reg/volunteer/arrive/${id}`, { method: 'POST' });
      const data = await res.json();
      if (data.success) {
        if (data.message) {
          alert(data.message);
        }
        doSearch();
      } else {
        alert(data.message || 'Failed to mark arrived.');
      }
    } catch {
      alert('Network error. Please try again.');
    }
  };

  async function loadTableConfig() {
    try {
      const res = await fetch('/api/reg/tables');
      const data = await res.json();
      if (data.success && data.tables) {
        tables = data.tables;
      }
    } catch {}
    tableFilter.innerHTML = '<option value="">All tables</option>';
    tables.forEach(t => {
      tableFilter.innerHTML += `<option value="${esc(String(t.id))}">${esc(t.label)}${t.isVIP ? ' (VIP)' : ''}</option>`;
    });
  }

  requireRegVolunteer(async () => {
    await loadTableConfig();
    searchInput.focus();
  }, { feature: 'events' });
</script>