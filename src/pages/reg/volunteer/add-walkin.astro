---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Add Walk-in Guest — SWA Registration" currentPath="/reg/volunteer/search">
  <a href="/reg/volunteer/search" style="color:var(--swa-3);font-size:0.9rem;">&larr; Back to Search</a>
  <h1 style="font-size:1.25rem;margin-top:0.5rem;">Add Walk-in Guest</h1>
  <p style="color:var(--text-muted);margin-bottom:1.5rem;font-size:0.85rem;">Walk-in guests are checked in immediately.</p>

  <div class="card" style="max-width:480px;">
    <form id="walkin-form">
      <div class="form-group">
        <label class="form-label" for="guest-name">Guest Name *</label>
        <input type="text" id="guest-name" class="form-input" required style="font-size:1.1rem;" autofocus />
      </div>
      <div class="form-group">
        <label class="form-label" for="table-select">Table *</label>
        <select id="table-select" class="form-input" required>
          <option value="">Select table</option>
        </select>
      </div>
      <div class="form-group">
        <label class="form-label" for="guest-notes">Notes <span style="color:var(--text-muted);font-weight:normal;">(optional, staff only)</span></label>
        <textarea id="guest-notes" class="form-input" rows="2" placeholder="Dietary or accessibility requirements"></textarea>
      </div>
      <div style="display:flex;gap:0.75rem;margin-top:1rem;">
        <button type="submit" class="btn btn-primary" style="font-size:1rem;padding:0.75rem 1.5rem;">Add and Check In</button>
        <a href="/reg/volunteer/search" class="btn btn-secondary">Cancel</a>
      </div>
      <p id="form-error" class="form-error" style="display:none;"></p>
    </form>
  </div>
</AdminLayout>

<script>
  import { requireRegVolunteer } from '../../../scripts/auth-gate';

  const form = document.getElementById('walkin-form') as HTMLFormElement;
  const errEl = document.getElementById('form-error')!;
  const tableSelect = document.getElementById('table-select') as HTMLSelectElement;

  function esc(s: string): string {
    const d = document.createElement('div');
    d.textContent = s || '';
    return d.innerHTML;
  }

  let tables: { id: string; label: string; isVIP: boolean; capacity: number; occupied: number }[] = [];

  async function loadTableConfig() {
    try {
      const res = await fetch('/api/reg/tables');
      const data = await res.json();
      if (data.success && data.tables) {
        tables = data.tables;
      }
    } catch {}

    tableSelect.innerHTML = '<option value="">Select table</option>';
    tables.forEach(t => {
      const remaining = (t.capacity ?? 0) - (t.occupied ?? 0);
      const avail = remaining > 0 ? `${remaining} seat${remaining === 1 ? '' : 's'} left` : 'FULL (overbooked)';
      tableSelect.innerHTML += `<option value="${esc(String(t.id))}">${esc(t.label)}${t.isVIP ? ' (VIP)' : ''} — ${avail}</option>`;
    });
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errEl.style.display = 'none';

    const payload = {
      guest_name: (document.getElementById('guest-name') as HTMLInputElement).value.trim(),
      table_id: tableSelect.value,
      notes: (document.getElementById('guest-notes') as HTMLTextAreaElement).value.trim() || undefined,
    };

    if (!payload.guest_name || !payload.table_id) {
      errEl.textContent = 'Guest name and table are required.';
      errEl.style.display = '';
      return;
    }

    try {
      const res = await fetch('/api/reg/volunteer/walkin', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await res.json();
      if (data.success) {
        window.location.href = '/reg/volunteer/search';
      } else {
        errEl.textContent = data.message || 'Failed to add walk-in guest.';
        errEl.style.display = '';
      }
    } catch {
      errEl.textContent = 'Network error. Please try again.';
      errEl.style.display = '';
    }
  });

  requireRegVolunteer(async () => {
    await loadTableConfig();
  }, { feature: 'events' });
</script>