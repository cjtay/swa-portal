---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Registration Bookings — SWA Admin Portal" currentPath="/reg/admin/bookings">
  <h1>Registration Bookings</h1>
  <p style="color:var(--text-muted);margin-bottom:1.5rem;">Manage gala dinner table reservations and guest lists.</p>

  <div id="bookings-app">
    <div class="card">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;flex-wrap:wrap;gap:0.75rem;">
        <div style="display:flex;gap:0.5rem;align-items:center;flex-wrap:wrap;">
          <input type="search" id="search-input" class="form-input" placeholder="Search by buyer name..." style="width:220px;" />
          <select id="table-filter" class="form-input" style="width:auto;">
            <option value="">All tables</option>
          </select>
        </div>
        <div style="display:flex;gap:0.5rem;">
          <button class="btn btn-secondary" id="print-guest-list-btn">Print Guest List</button>
          <a href="/api/reg/admin/export" class="btn btn-secondary" id="export-btn">Download CSV</a>
          <button class="btn btn-primary" id="add-booking-btn">+ New Booking</button>
        </div>
      </div>
      <table class="data-table">
        <thead>
          <tr>
            <th>Ref</th>
            <th>Buyer</th>
            <th>Table</th>
            <th>Pax</th>
            <th>Named</th>
            <th>Created</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="bookings-list"></tbody>
      </table>
    </div>

    <div class="card" id="new-booking-form" hidden>
      <h2>New Booking</h2>
      <form id="booking-form" style="margin-top:1rem;">
        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="buyer-name">Buyer Name *</label>
            <input type="text" id="buyer-name" class="form-input" required />
          </div>
          <div class="form-group">
            <label class="form-label" for="buyer-email">Buyer Email</label>
            <input type="email" id="buyer-email" class="form-input" />
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="table-select">Table *</label>
            <select id="table-select" class="form-input" required></select>
          </div>
          <div class="form-group">
            <label class="form-label" for="pax-count">Number of Guests *</label>
            <input type="number" id="pax-count" class="form-input" value="10" min="1" required />
          </div>
        </div>
        <div class="form-group">
          <label class="form-label" for="buyer-phone">Buyer Phone</label>
          <input type="text" id="buyer-phone" class="form-input" />
        </div>
        <div class="form-group">
          <label class="form-label" for="booking-notes">Notes <span style="color:var(--text-muted);font-weight:normal;">(staff only, not visible to buyer)</span></label>
          <textarea id="booking-notes" class="form-input" rows="2"></textarea>
        </div>
        <div style="display:flex;gap:0.75rem;align-items:center;">
          <button type="submit" class="btn btn-primary">Create Booking</button>
          <button type="button" class="btn btn-secondary" id="cancel-form-btn">Cancel</button>
        </div>
        <p id="form-error" class="form-error" style="display:none;"></p>
      </form>
    </div>
  </div>

  <div id="print-area" class="print-area"></div>
</AdminLayout>

<script>
  import { requireRegAdmin } from '../../../scripts/auth-gate';

  let tables: { id: string; label: string; ticketPrefix: string; capacity: number; isVIP: boolean }[] = [];

  const tableFilter = document.getElementById('table-filter') as HTMLSelectElement;
  const tableSelect = document.getElementById('table-select') as HTMLSelectElement;
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const bookingsList = document.getElementById('bookings-list')!;
  const addBtn = document.getElementById('add-booking-btn')!;
  const cancelBtn = document.getElementById('cancel-form-btn')!;
  const printBtn = document.getElementById('print-guest-list-btn')!;
  const formEl = document.getElementById('new-booking-form') as HTMLDivElement;
  const form = document.getElementById('booking-form') as HTMLFormElement;
  const errEl = document.getElementById('form-error')!;
  const printArea = document.getElementById('print-area')!;

  addBtn.addEventListener('click', () => {
    formEl.hidden = !formEl.hidden;
    if (!formEl.hidden) formEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  });

  cancelBtn.addEventListener('click', () => {
    formEl.hidden = true;
    form.reset();
    errEl.style.display = 'none';
  });

  function esc(s: string): string {
    const d = document.createElement('div');
    d.textContent = s || '';
    return d.innerHTML;
  }

  function completionClass(named: number, total: number): string {
    if (total === 0) return '';
    if (named === total) return 'badge badge-approved';
    if (named > 0) return 'badge badge-warning';
    return '';
  }

  function completionText(named: number, total: number): string {
    return `${named}/${total}`;
  }

  async function loadBookings() {
    const search = searchInput.value.trim();
    const tableId = tableFilter.value;
    const params = new URLSearchParams();
    if (search) params.set('search', search);
    if (tableId) params.set('table', tableId);

    try {
      const res = await fetch(`/api/reg/admin/bookings?${params.toString()}`);
      const data = await res.json();
      if (data.success && data.bookings) {
        renderBookings(data.bookings);
      }
    } catch (err) {
      console.error('Failed to load bookings', err);
    }
  }

  function renderBookings(bookings: any[]) {
    if (bookings.length === 0) {
      bookingsList.innerHTML = '<tr><td colspan="7" style="text-align:center;color:var(--text-muted);">No bookings yet. Create one to get started.</td></tr>';
      return;
    }

    bookingsList.innerHTML = bookings.map((b: any) => {
      const named = Number(b.named_guests || 0);
      const total = Number(b.total_guests || 0);
      const badge = completionClass(named, total);
      return `<tr>
        <td><a href="/reg/admin/booking-detail?id=${b.id}" style="color:var(--swa-3);font-weight:600;">${esc(b.booking_ref)}</a></td>
        <td>${esc(b.buyer_name)}${b.buyer_email ? `<br><span style="font-size:0.75rem;color:var(--text-muted);">${esc(b.buyer_email)}</span>` : ''}</td>
        <td>${esc(b.table_id)}</td>
        <td>${b.pax}</td>
        <td>${badge ? `<span class="${badge}">${completionText(named, total)}</span>` : completionText(named, total)}</td>
        <td style="font-size:0.8rem;color:var(--text-muted);">${new Date(b.created_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' })}</td>
        <td><a href="/reg/admin/booking-detail?id=${b.id}" class="btn btn-secondary" style="font-size:0.8rem;padding:0.25rem 0.5rem;">View</a></td>
      </tr>`;
    }).join('');
  }

  async function loadTableConfig() {
    try {
      const res = await fetch('/api/reg/tables');
      const data = await res.json();
      if (data.success && data.tables) {
        tables = data.tables;
      }
    } catch {}

    tableFilter.innerHTML = '<option value="">All tables</option>';
    tableSelect.innerHTML = '<option value="">Select table</option>';
    tables.forEach(t => {
      tableFilter.innerHTML += `<option value="${t.id}">${t.label}${t.isVIP ? ' (VIP)' : ''}</option>`;
      tableSelect.innerHTML += `<option value="${t.id}">${t.label}${t.isVIP ? ' (VIP)' : ''} — ${t.capacity} seats</option>`;
    });
  }

  async function handlePrintGuestList() {
    printBtn.disabled = true;
    printBtn.textContent = 'Loading...';

    try {
      const res = await fetch('/api/reg/admin/guest-list');
      const data = await res.json();
      if (!data.success) {
        alert('Could not load guest list for printing.');
        return;
      }

      if (!data.tables || data.tables.length === 0) {
        alert('No guests found. Add bookings and guests first.');
        return;
      }

      const dateStr = data.generatedAt;
      const totalStr = `Total: ${data.totalGuests} guests | Named: ${data.namedGuests} | Arrived: ${data.arrivedGuests}`;

      let html = '';

      html += `<div class="print-header">
        <div class="print-title">49th SWA Annual Charity Dinner 2026</div>
        <div class="print-subtitle">Guest Registration List</div>
        <div class="print-meta">Generated: ${dateStr}</div>
        <div class="print-meta">${totalStr}</div>
      </div>`;

      for (const table of data.tables) {
        const vipTag = table.isVIP ? ' <span class="print-vip-tag">VIP</span>' : '';
        const arrivedInTable = table.guests.filter((g: any) => g.arrived).length;
        const namedInTable = table.guests.filter((g: any) => g.guestName).length;

        html += `<div class="print-table-section">`;
        html += `<div class="print-table-header">${esc(table.tableLabel)}${vipTag} <span class="print-table-count">(${namedInTable}/${table.guests.length} named, ${arrivedInTable} arrived)</span></div>`;
        html += `<table class="print-guest-table">
          <thead>
            <tr>
              <th class="col-ticket">Ticket</th>
              <th class="col-name">Guest Name</th>
              <th class="col-flag"></th>
              <th class="col-arrived">Arrived</th>
              <th class="col-signature">Signature</th>
              <th class="col-remarks">Remarks</th>
            </tr>
          </thead>
          <tbody>`;

        for (const guest of table.guests) {
          const nameDisplay = guest.guestName ? esc(guest.guestName) : '';
          const flagParts: string[] = [];
          if (guest.isBuyer) flagParts.push('Buyer');
          if (guest.isWalkIn) flagParts.push('Walk-in');
          const flagHtml = flagParts.length > 0
            ? `<span class="print-flag">${flagParts.join(', ')}</span>`
            : '';
          const ticketSuffix = guest.isWalkIn ? '*' : '';
          const arrivedHtml = guest.arrived
            ? `<span class="print-arrived">&#10003;</span>`
            : '';

          html += `<tr>
            <td class="col-ticket">${esc(guest.ticketCode)}${ticketSuffix}</td>
            <td class="col-name">${nameDisplay}</td>
            <td class="col-flag">${flagHtml}</td>
            <td class="col-arrived">${arrivedHtml}</td>
            <td class="col-signature"></td>
            <td class="col-remarks"></td>
          </tr>`;
        }

        html += `</tbody></table></div>`;
      }

      html += `<div class="print-footer">
        <div>* Walk-in guest &nbsp;&nbsp; &#10003; = Arrived</div>
        <div class="print-footer-note">Printed for business continuity. If the digital system is unavailable, use this list for manual check-in at reception.</div>
      </div>`;

      printArea.innerHTML = html;
      setTimeout(() => window.print(), 200);
    } catch {
      alert('Could not load data for printing.');
    } finally {
      printBtn.disabled = false;
      printBtn.textContent = 'Print Guest List';
    }
  }

  printBtn.addEventListener('click', handlePrintGuestList);

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errEl.style.display = 'none';

    const payload = {
      buyer_name: (document.getElementById('buyer-name') as HTMLInputElement).value.trim(),
      buyer_email: (document.getElementById('buyer-email') as HTMLInputElement).value.trim() || undefined,
      buyer_phone: (document.getElementById('buyer-phone') as HTMLInputElement).value.trim() || undefined,
      table_id: tableSelect.value,
      pax: Number((document.getElementById('pax-count') as HTMLInputElement).value),
      notes: (document.getElementById('booking-notes') as HTMLTextAreaElement).value.trim() || undefined,
    };

    if (!payload.buyer_name || !payload.table_id) {
      errEl.textContent = 'Buyer name and table are required.';
      errEl.style.display = '';
      return;
    }

    try {
      const res = await fetch('/api/reg/admin/bookings', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await res.json();
      if (data.success) {
        formEl.hidden = true;
        form.reset();
        await loadBookings();
      } else {
        errEl.textContent = data.message || 'Failed to create booking.';
        errEl.style.display = '';
      }
    } catch {
      errEl.textContent = 'Network error. Please try again.';
      errEl.style.display = '';
    }
  });

  let searchTimeout: ReturnType<typeof setTimeout>;
  searchInput.addEventListener('input', () => {
    clearTimeout(searchTimeout);
    searchTimeout = setTimeout(loadBookings, 300);
  });
  tableFilter.addEventListener('change', loadBookings);

  requireRegAdmin(async () => {
    await loadTableConfig();
    await loadBookings();
  });
</script>

<style>
  .badge-warning {
    background: var(--warning);
    color: #fff;
  }

  .print-area { display: none; }

  @media print {
    .admin-sidebar,
    .admin-main > h1,
    .admin-main > p,
    #bookings-app,
    .no-print {
      display: none !important;
    }

    .admin-main {
      margin-left: 0 !important;
      padding: 0 !important;
    }

    body {
      background: #fff !important;
      color: #000 !important;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      font-size: 9pt;
      line-height: 1.3;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    @page {
      size: A4 landscape;
      margin: 10mm 12mm;
    }

    .print-area {
      display: block !important;
    }

    .print-header {
      text-align: center;
      margin-bottom: 6mm;
      padding-bottom: 4mm;
      border-bottom: 1.5pt solid #70308c;
    }

    .print-title {
      font-size: 14pt;
      font-weight: 700;
      color: #70308c;
      margin-bottom: 1mm;
    }

    .print-subtitle {
      font-size: 11pt;
      font-weight: 600;
      color: #333;
      margin-bottom: 2mm;
    }

    .print-meta {
      font-size: 8pt;
      color: #555;
      line-height: 1.4;
    }

    .print-table-section {
      margin-top: 5mm;
    }

    .print-table-header {
      font-size: 10pt;
      font-weight: 700;
      color: #450a5e;
      border-bottom: 1pt solid #70308c;
      padding-bottom: 1.5mm;
      margin-bottom: 2mm;
    }

    .print-table-count {
      font-weight: 400;
      font-size: 8pt;
      color: #666;
    }

    .print-vip-tag {
      display: inline-block;
      background: #70308c;
      color: #fff;
      font-size: 7pt;
      font-weight: 600;
      padding: 0.5mm 2mm;
      border-radius: 1.5pt;
      vertical-align: middle;
      margin-left: 2mm;
    }

    .print-guest-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 8.5pt;
      margin-bottom: 3mm;
    }

    .print-guest-table th {
      background: #f3d2ff !important;
      color: #450a5e !important;
      font-size: 7.5pt;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      padding: 2mm 2mm;
      border-bottom: 1pt solid #70308c;
      text-align: left;
    }

    .print-guest-table td {
      padding: 2mm 2mm;
      border-bottom: 0.5pt solid #ddd;
      vertical-align: middle;
    }

    .print-guest-table tbody tr:last-child td {
      border-bottom: 1pt solid #aaa;
    }

    .col-ticket {
      width: 60px;
      font-family: 'Courier New', monospace;
      font-weight: 600;
      font-size: 8pt;
    }

    .col-name {
      width: auto;
      min-width: 120px;
    }

    .col-flag {
      width: 55px;
      text-align: center;
    }

    .col-arrived {
      width: 40px;
      text-align: center;
    }

    .col-signature {
      width: 80px;
      border-right: 1pt solid #ccc !important;
    }

    .col-remarks {
      width: 80px;
    }

    .print-flag {
      font-size: 7pt;
      color: #70308c;
      font-weight: 500;
    }

    .print-arrived {
      font-size: 10pt;
      color: #16a34a;
      font-weight: 700;
    }

    .print-footer {
      margin-top: 6mm;
      padding-top: 3mm;
      border-top: 0.5pt solid #999;
      font-size: 7.5pt;
      color: #666;
    }

    .print-footer-note {
      margin-top: 1mm;
      font-style: italic;
      color: #888;
    }
  }
</style>