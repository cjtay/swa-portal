---
import AdminLayout from '../layouts/AdminLayout.astro';
---

<AdminLayout title="Namecards — SWA Portal" currentPath="/namecards">
  <h1>Namecards</h1>
  <p style="color:var(--text-muted);margin-bottom:1.5rem;">Manage member namecard data and sync to the public website.</p>

  <div class="card">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;">
      <h2>Members with Namecards</h2>
      <button class="btn btn-secondary" id="sync-btn">Sync to Website</button>
    </div>
    <table class="data-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Role</th>
          <th>Namecard</th>
          <th>Visible</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody id="namecards-list"></tbody>
    </table>
  </div>
</AdminLayout>

<script>
  import { requireAuth } from '../scripts/auth-gate';

  async function loadMembers() {
    try {
      const res = await fetch('/api/members');
      const data = await res.json();
      if (data.success) {
        const tbody = document.getElementById('namecards-list')!;
        tbody.innerHTML = data.members.filter((m: any) => m.has_namecard || m.show_on_website).map((m: any) => {
          return `<tr>
            <td>${m.name}</td>
            <td>${m.role || ''}</td>
            <td><span class="badge ${m.has_namecard ? 'badge-approved' : 'badge-cancelled'}">${m.has_namecard ? 'Yes' : 'No'}</span></td>
            <td><span class="badge ${m.show_on_website ? 'badge-approved' : 'badge-cancelled'}">${m.show_on_website ? 'Yes' : 'No'}</span></td>
            <td><a href="/members" class="btn btn-secondary" style="padding:0.3rem 0.6rem;font-size:0.75rem;">Edit</a></td>
          </tr>`;
        }).join('');
      }
    } catch (err) {
      console.error('Failed to load members', err);
    }
  }

  document.getElementById('sync-btn')!.addEventListener('click', async () => {
    const btn = document.getElementById('sync-btn') as HTMLButtonElement;
    btn.textContent = 'Syncing...';
    btn.disabled = true;
    try {
      const res = await fetch('/api/sync-website', { method: 'POST' });
      const data = await res.json();
      alert(data.success ? 'Website sync triggered.' : (data.message || 'Sync failed.'));
    } catch {
      alert('Network error during sync.');
    }
    btn.textContent = 'Sync to Website';
    btn.disabled = false;
  });

  requireAuth({ onAuthenticated: loadMembers });
</script>