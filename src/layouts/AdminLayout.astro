---
import '../styles/admin.css';

interface Props {
  title: string;
  currentPath?: string;
}

const { title, currentPath = '' } = Astro.props;

const navItems = [
  { href: '/', label: 'Dashboard' },
  { href: '/office-booking', label: 'Office Booking' },
  { href: '/namecards', label: 'Namecards' },
  { href: '/members', label: 'Members' },
  { href: '/reg/admin/bookings', label: 'Registration' },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow, noarchive, nosnippet, notranslate, noimageindex" />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body>
<div class="admin-layout">
  <aside class="admin-sidebar">
    <div class="sidebar-brand"><img src="/swalogo.svg" alt="SWA" /><span>SWA</span> Admin Portal</div>
    <nav class="sidebar-nav">
      {navItems.map((item) => (
        <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>
    <div class="sidebar-user" id="sidebar-user" style="display:none;">
      <div class="user-name" id="sidebar-user-name"></div>
    </div>
  </aside>
  <main class="admin-main">
    <slot />
  </main>
</div>
</body>
</html>

<script>
  import { requireAuth } from '../scripts/auth-gate';

  requireAuth({
    onAuthenticated(data) {
      const userEl = document.getElementById('sidebar-user');
      const nameEl = document.getElementById('sidebar-user-name');
      if (userEl && nameEl) {
        nameEl.textContent = data.name || data.email || '';
        userEl.style.display = '';
      }
    },
  });
</script>