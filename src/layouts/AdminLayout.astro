---
import '../styles/admin.css';

interface Props {
  title: string;
  currentPath?: string;
}

const { title, currentPath = '' } = Astro.props;

type NavItem = {
  href: string;
  label: string;
  regRole?: string | null;
  itAdminOnly?: boolean;
};

type NavGroup = {
  heading: string;
  items: NavItem[];
  regRole?: string | null;
};

const navGroups: NavGroup[] = [
  {
    heading: '',
    items: [
      { href: '/', label: 'Dashboard' },
      { href: '/office-booking', label: 'Office Booking' },
      { href: '/namecards', label: 'Namecards' },
      { href: '/members', label: 'Members' },
      { href: '/admin/settings', label: 'Settings', itAdminOnly: true },
    ],
  },
  {
    heading: 'Registration',
    items: [
      { href: '/reg/admin/bookings', label: 'Bookings', regRole: 'reg_admin' },
      { href: '/reg/volunteer/search', label: 'Check-in', regRole: 'reg_volunteer' },
      { href: '/reg/dashboard', label: 'Arrivals Dashboard' },
    ],
    regRole: 'reg_volunteer',
  },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow, noarchive, nosnippet, notranslate, noimageindex" />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body>
<div class="admin-layout">
  <aside class="admin-sidebar">
    <div class="sidebar-brand"><img src="/swalogo.svg" alt="SWA" /><span>SWA</span> Admin Portal</div>
    <nav class="sidebar-nav" id="sidebar-nav">
      {navGroups.map((group) => (
        <div class="sidebar-group" data-reg-role={group.regRole ?? ''}>
          {group.heading && <div class="sidebar-heading">{group.heading}</div>}
          {group.items.map((item) => (
            <a href={item.href}
               aria-current={currentPath === item.href ? 'page' : undefined}
               data-reg-role={item.regRole ?? ''}
               data-it-admin-only={item.itAdminOnly ? 'true' : 'false'}>
              {item.label}
            </a>
          ))}
        </div>
      ))}
    </nav>
    <div class="sidebar-user" id="sidebar-user" style="display:none;">
      <div class="user-name" id="sidebar-user-name"></div>
    </div>
  </aside>
  <main class="admin-main">
    <slot />
  </main>
</div>
</body>

<script>
  import { requireAuth, type SessionResponse } from '../scripts/auth-gate';

  function updateNavVisibility(data: SessionResponse) {
    const nav = document.getElementById('sidebar-nav');
    if (!nav) return;

    const role = data.role;
    const regRole = data.regRole;
    const isAdmin = role === 'admin';

    nav.querySelectorAll('a[data-reg-role]').forEach((el) => {
      const itemRegRole = (el as HTMLElement).dataset.regRole || '';
      if (!itemRegRole) return;
      if (isAdmin || itemRegRole === 'reg_admin') {
        (el as HTMLElement).style.display = '';
      } else if (itemRegRole === 'reg_volunteer' && regRole === 'reg_volunteer') {
        (el as HTMLElement).style.display = '';
      } else {
        (el as HTMLElement).style.display = 'none';
      }
    });

    nav.querySelectorAll('a[data-it-admin-only="true"]').forEach((el) => {
      if (data.is_it_admin) {
        (el as HTMLElement).style.display = '';
      } else {
        (el as HTMLElement).style.display = 'none';
      }
    });

    nav.querySelectorAll('.sidebar-group[data-reg-role]').forEach((el) => {
      const groupRegRole = (el as HTMLElement).dataset.regRole || '';
      if (!groupRegRole) return;
      if (isAdmin) {
        (el as HTMLElement).style.display = '';
      } else if (groupRegRole === 'reg_volunteer' && (regRole === 'reg_volunteer' || regRole === 'reg_admin')) {
        (el as HTMLElement).style.display = '';
      } else if (groupRegRole === 'reg_admin' && regRole === 'reg_admin') {
        (el as HTMLElement).style.display = '';
      } else {
        (el as HTMLElement).style.display = 'none';
      }
    });
  }

  requireAuth({
    onAuthenticated(data: SessionResponse) {
      const userEl = document.getElementById('sidebar-user');
      const nameEl = document.getElementById('sidebar-user-name');
      if (userEl && nameEl) {
        nameEl.textContent = data.name || data.email || '';
        userEl.style.display = '';
      }
      updateNavVisibility(data);
    },
  });
</script>