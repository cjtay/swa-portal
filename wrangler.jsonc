{
  "name": "swa-portal",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-01-01",
  "account_id": "4e031a33b6cb8ab00fa7df84850dab2f",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // '/c/*' removed 2026-08: public namecard surface hidden (security audit).
    // Re-add it when the /c/* routes in src/worker/index.ts are restored.
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    { "pattern": "admin.singaporewomenassociation.org", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "swa-portal",
      "database_id": "b8ca063c-6767-445c-a42e-d092daf80fc4"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SWA_SESSION",
      "id": "ddb93996417c4476ac0f90ddf1eb332d"
    },
    {
      "binding": "SWA_CONFIG",
      "id": "663295deb2f94800986e3dfe6f8ea230"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "swa-portal-uploads"
    }
  ],
  "limits": {
    "max_request_body_size": 20971520
  },
  "workers_dev": true,
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "vars": {
    "SWA_ADMIN_DOMAIN": "admin.singaporewomenassociation.org",
    "TURNSTILE_SITE_KEY": "0x4AAAAAADNT4-Bm-rzslbrc"
  }
}