{
  "name": "swa-portal",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-01-01",
  "account_id": "4e031a33b6cb8ab00fa7df84850dab2f",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/c/*"]
  },
  "routes": [
    { "pattern": "admin.singaporewomenassociation.org", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "swa-portal",
      "database_id": "b8ca063c-6767-445c-a42e-d092daf80fc4"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SWA_SESSION",
      "id": "ddb93996417c4476ac0f90ddf1eb332d"
    },
    {
      "binding": "SWA_CONFIG",
      "id": "663295deb2f94800986e3dfe6f8ea230"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "swa-portal-uploads"
    }
  ],
  // Workers AI — reads quotation documents (PDF text + photo vision) for the
  // approvals AI comparison. Docs/plans/AI-Quotation-Comparison-Plan.md §4.1.
  "ai": {
    "binding": "AI"
  },
  // 110 MB so a single "New request" POST can honestly carry the advertised
  // 10 files x 10 MB plus multipart overhead. The earlier 20 MB cap rejected
  // such uploads with a 413 before the API's own per-file limits ran
  // (found in the 2026-08-28 pre-deploy policy audit). The effective limit
  // is min(this, the plan's body ceiling) and the API still enforces
  // APPROVAL_MAX_FILES_PER_ITEM / APPROVAL_MAX_FILE_BYTES itself.
  "limits": {
    "max_request_body_size": 115343360
  },
  "workers_dev": true,
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "vars": {
    "SWA_ADMIN_DOMAIN": "admin.singaporewomenassociation.org",
    "TURNSTILE_SITE_KEY": "0x4AAAAAADNT4-Bm-rzslbrc"
  },
  // Staging environment — docs/plans/staging-environment-plan.md.
  // `wrangler deploy --env staging` deploys a second Worker named
  // swa-portal-staging at swa-portal-staging.cjtay-4e0.workers.dev, wired to
  // its own D1/KV/R2 (testers, own data). Bindings and vars do NOT inherit
  // into environments, so each is repeated with staging resource IDs; assets,
  // limits and observability DO inherit from the top level. No routes entry
  // here on purpose — staging must never claim the production custom domain.
  "env": {
    "staging": {
      "workers_dev": true,
      // Empty routes on purpose: without this, the environment INHERITS the
      // top-level custom domain and a staging deploy would reassign
      // admin.singaporewomenassociation.org away from production
      // (confirmed via `wrangler deploy --env staging --dry-run`, 2026-09-05).
      "routes": [],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "swa-portal-staging",
          "database_id": "9b78455e-56ee-4418-8208-5553f4a7c7ea"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "SWA_SESSION",
          "id": "314f62835d7b41d1978e4de0c881ab55"
        },
        {
          "binding": "SWA_CONFIG",
          "id": "82d3e18a71914f72bb336bcbce633bce"
        }
      ],
      "r2_buckets": [
        {
          "binding": "R2_BUCKET",
          "bucket_name": "swa-portal-staging-uploads"
        }
      ],
      "ai": {
        "binding": "AI"
      },
      "vars": {
        "SWA_ADMIN_DOMAIN": "swa-portal-staging.cjtay-4e0.workers.dev",
        "TURNSTILE_SITE_KEY": "0x4AAAAAADNT4-Bm-rzslbrc"
      }
    }
  }
}